{% comment %}
    Renders a product card

    Accepts:
    - card_product: {Object} Product Liquid object (optional)
    - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
    - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
    - show_vendor: {Boolean} Show the product vendor. Default: false
    - show_rating: {Boolean} Show the product rating. Default: false
    - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
    - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
    - show_variant_options: {Boolean} Show variant buttons/swatches. Default: false (optional)
    - show_add_to_cart: {Boolean} Show Add to Cart button. Default: false (optional)
    - show_subscribe: {Boolean} Show Subscribe & Save button. Default: false (optional)
    - max_visible_variants: {Number} Max variant options to show before "+X More". Default: 3 (optional)

    Usage:
    {% render 'card-product', card_product: product, show_variant_options: true, show_add_to_cart: true, show_subscribe: true %}
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == nil
      assign ratio = 1
    endif

    unless max_visible_variants
      assign max_visible_variants = 3
    endunless
  -%}

  <style>
    .sl-product-card-snippet {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .sl-product-card-snippet .sl-product-image {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #f5f5f5;
    }

    .sl-product-card-snippet .sl-product-image a {
      display: block;
      width: 100%;
      height: 100%;
    }

    .sl-product-card-snippet .sl-product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    .sl-product-card-snippet:hover .sl-product-image img {
      transform: scale(1.05);
    }

    .sl-product-card-snippet .sl-product-image .sl-secondary-image {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .sl-product-card-snippet:hover .sl-product-image .sl-secondary-image {
      opacity: 1;
    }

    .sl-product-card-snippet .sl-product-info {
      padding: 15px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .sl-product-card-snippet .sl-product-title {
      font-size: 16px;
      font-weight: 400;
      margin: 0 0 5px 0;
      line-height: 1.3;
      min-height: 45px;
    }

    .sl-product-card-snippet .sl-product-title a {
      color: inherit;
      text-decoration: none;
    }

    .sl-product-card-snippet .sl-product-title a:hover {
      opacity: 0.8;
    }

    /* Vendor */
    .sl-product-card-snippet .sl-product-vendor {
      font-size: 12px;
      opacity: 0.7;
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }

    /* Rating */
    .sl-product-card-snippet .sl-product-rating {
      margin-bottom: 4px;
    }

    /* Badge */
    .sl-product-card-snippet .sl-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      z-index: 2;
      letter-spacing: 0.5px;
    }

    .sl-product-card-snippet .sl-badge--sale {
      background: #722F37;
      color: #ffffff;
    }

    .sl-product-card-snippet .sl-badge--soldout {
      background: #666666;
      color: #ffffff;
    }

    /* Variant Options */
    .sl-product-card-snippet .sl-variant-options {
      margin-bottom: 15px;
    }

    .sl-product-card-snippet .sl-option-group {
      margin-bottom: 8px;
    }

    .sl-product-card-snippet .sl-option-values {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }

    /* Size Buttons */
    .sl-product-card-snippet .sl-size-btn {
      padding: 4px 12px;
      border: 1px solid rgba(255,255,255,0.3);
      background: rgba(255,255,255,0.1);
      color: inherit;
      border-radius: 16px;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .sl-product-card-snippet .sl-size-btn:hover {
      border-color: rgba(255,255,255,0.5);
    }

    .sl-product-card-snippet .sl-size-btn[data-selected="true"] {
      background: rgba(255,255,255,0.2);
      border-color: rgba(255,255,255,0.6);
    }

    .sl-product-card-snippet .sl-size-btn[data-unavailable="true"] {
      opacity: 0.4;
      cursor: not-allowed;
      position: relative;
    }

    .sl-product-card-snippet .sl-size-btn[data-unavailable="true"]::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
      background: currentColor;
      transform: rotate(-15deg);
    }

    /* Color Swatches */
    .sl-product-card-snippet .sl-color-swatch {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      padding: 0;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
    }

    .sl-product-card-snippet .sl-color-swatch:hover {
      transform: scale(1.1);
    }

    .sl-product-card-snippet .sl-color-swatch[data-selected="true"] {
      border-color: #ffffff;
      box-shadow: 0 0 0 2px #ffffff;
    }

    .sl-product-card-snippet .sl-color-swatch[data-unavailable="true"] {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* More Options Link */
    .sl-product-card-snippet .sl-more-options {
      font-size: 12px;
      color: inherit;
      text-decoration: none;
      opacity: 0.7;
      padding: 4px 8px;
    }

    .sl-product-card-snippet .sl-more-options:hover {
      text-decoration: underline;
      opacity: 1;
    }

    /* Price */
    .sl-product-card-snippet .sl-product-price {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }

    .sl-product-card-snippet .sl-price-current {
      font-weight: 500;
    }

    .sl-product-card-snippet .sl-price-compare {
      text-decoration: line-through;
      opacity: 0.7;
    }

    /* Action Buttons */
    .sl-product-card-snippet .sl-product-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: auto;
    }

    .sl-product-card-snippet .sl-add-to-cart-btn {
      width: 100%;
      padding: 12px 16px;
      background: #ffffff;
      color: #000000;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }

    .sl-product-card-snippet .sl-add-to-cart-btn:hover {
      opacity: 0.9;
    }

    .sl-product-card-snippet .sl-add-to-cart-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .sl-product-card-snippet .sl-subscribe-btn {
      width: 100%;
      padding: 12px 16px;
      background: #722F37;
      color: #ffffff;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
      text-decoration: none;
      text-align: center;
      display: block;
    }

    .sl-product-card-snippet .sl-subscribe-btn:hover {
      opacity: 0.9;
    }

    /* Mobile Adjustments */
    @media screen and (max-width: 749px) {
      .sl-product-card-snippet .sl-product-info {
        padding: 12px;
      }

      .sl-product-card-snippet .sl-product-title {
        min-height: 40px;
        font-size: 14px;
      }
    }
  </style>

  <div class="sl-product-card-snippet" data-product-id="{{ card_product.id }}">
    {%- comment -%} Badges {%- endcomment -%}
    {%- if card_product.available == false -%}
      <span class="sl-badge sl-badge--soldout">Sold Out</span>
    {%- elsif card_product.compare_at_price > card_product.price -%}
      <span class="sl-badge sl-badge--sale">Sale</span>
    {%- endif -%}

    {%- comment -%} Product Image {%- endcomment -%}
    <div class="sl-product-image">
      <a href="{{ card_product.url }}">
        {%- if card_product.featured_media -%}
          <img
            src="{{ card_product.featured_media | image_url: width: 600 }}"
            alt="{{ card_product.featured_media.alt | escape }}"
            {% unless lazy_load == false %}loading="lazy"{% endunless %}
            width="600"
            height="600">

          {%- if card_product.media[1] != nil and show_secondary_image -%}
            <img
              class="sl-secondary-image"
              src="{{ card_product.media[1] | image_url: width: 600 }}"
              alt="{{ card_product.media[1].alt | escape }}"
              loading="lazy"
              width="600"
              height="600">
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Product Info {%- endcomment -%}
    <div class="sl-product-info">
      <h3 class="sl-product-title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      {%- if show_vendor -%}
        <div class="sl-product-vendor">{{ card_product.vendor }}</div>
      {%- endif -%}

      {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
        {% liquid
          assign rating_decimal = 0
          assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
          if decimal >= 0.3 and decimal <= 0.7
            assign rating_decimal = 0.5
          elsif decimal > 0.7
            assign rating_decimal = 1
          endif
        %}
        <div class="sl-product-rating">
          <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
            <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
          </div>
          <p class="rating-text caption">
            <span aria-hidden="true">{{ card_product.metafields.reviews.rating.value }} / {{ card_product.metafields.reviews.rating.value.scale_max }}</span>
          </p>
          <p class="rating-count caption">
            <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
            <span class="visually-hidden">{{ card_product.metafields.reviews.rating_count }} {{ "accessibility.total_reviews" | t }}</span>
          </p>
        </div>
      {%- endif -%}

      {%- comment -%} Price Display {%- endcomment -%}
      <div class="sl-product-price">
        {%- if card_product.compare_at_price > card_product.price -%}
          <span class="sl-price-compare">{{ card_product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="sl-price-current" data-product-price>{{ card_product.price | money }}</span>
      </div>

      {%- comment -%} Variant Options {%- endcomment -%}
      {%- if show_variant_options and card_product.has_only_default_variant == false -%}
        <div class="sl-variant-options">
          <script type="application/json" class="sl-variant-data">
            {{ card_product.variants | json }}
          </script>

          {%- for option in card_product.options_with_values -%}
            {%- assign option_name_lower = option.name | downcase -%}
            {%- assign is_color = false -%}
            {%- if option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
              {%- assign is_color = true -%}
            {%- endif -%}

            <div class="sl-option-group" data-option-type="{% if is_color %}color{% else %}size{% endif %}">
              <div class="sl-option-values">
                {%- assign total_values = option.values.size -%}
                {%- assign remaining = total_values | minus: max_visible_variants -%}

                {%- for value in option.values -%}
                  {%- if is_color -%}
                    <button type="button"
                            class="sl-color-swatch"
                            data-option-position="{{ option.position }}"
                            data-option-value="{{ value | escape }}"
                            style="background-color:{%- assign matching_color = card_product.metafields.shopify.color-pattern.value | where: "label", value | first -%}{{ matching_color.color }};"
                            title="{{ value }}"
                            {% if forloop.first %}data-selected="true"{% endif %}>
                    </button>
                  {%- else -%}
                    {%- if forloop.index <= max_visible_variants -%}
                      <button type="button"
                              class="sl-size-btn"
                              data-option-position="{{ option.position }}"
                              data-option-value="{{ value | escape }}"
                              {% if forloop.first %}data-selected="true"{% endif %}>
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if remaining > 0 and is_color == false -%}
                  <a href="{{ card_product.url }}" class="sl-more-options">+{{ remaining }} More</a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Action Buttons {%- endcomment -%}
      {%- if show_add_to_cart or show_subscribe -%}
        <div class="sl-product-actions">
          {%- if show_add_to_cart -%}
            {%- if card_product.available -%}
              <button type="button"
                      class="sl-add-to-cart-btn"
                      data-variant-id="{{ card_product.selected_or_first_available_variant.id }}">
                Add to Cart
              </button>
            {%- else -%}
              <button type="button" class="sl-add-to-cart-btn" disabled>
                Sold Out
              </button>
            {%- endif -%}
          {%- endif -%}

          {%- if show_subscribe and card_product.available -%}
            <a href="{{ card_product.url }}?subscribe=true"
               class="sl-subscribe-btn"
               data-variant-id="{{ card_product.selected_or_first_available_variant.id }}">
              Subscribe & Save
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if show_variant_options or show_add_to_cart -%}
    <script>
      (function() {
        const card = document.querySelector('[data-product-id="{{ card_product.id }}"].sl-product-card-snippet');
        if (!card) return;

        // Mark unavailable variants on page load
        const variantDataScript = card.querySelector('.sl-variant-data');
        if (variantDataScript) {
          try {
            const variants = JSON.parse(variantDataScript.textContent);

            card.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(btn => {
              const optionPosition = parseInt(btn.getAttribute('data-option-position'));
              const optionValue = btn.getAttribute('data-option-value');

              const hasAvailableVariant = variants.some(variant => {
                const optionKey = 'option' + optionPosition;
                return variant[optionKey] === optionValue && variant.available;
              });

              if (!hasAvailableVariant) {
                btn.setAttribute('data-unavailable', 'true');
              }
            });
          } catch (error) {
            console.error('Error checking variant availability:', error);
          }
        }

        // Variant Selection
        card.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(button => {
          button.addEventListener('click', function() {
            if (this.getAttribute('data-unavailable') === 'true') return;

            const optionGroup = this.closest('.sl-option-group');
            const addToCartBtn = card.querySelector('.sl-add-to-cart-btn');
            const subscribeBtn = card.querySelector('.sl-subscribe-btn');

            // Remove selected from other buttons in this group
            optionGroup.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(btn => {
              btn.removeAttribute('data-selected');
            });

            // Mark this button as selected
            this.setAttribute('data-selected', 'true');

            // Get variant data
            const variantDataScript = card.querySelector('.sl-variant-data');
            if (!variantDataScript) return;

            try {
              const variants = JSON.parse(variantDataScript.textContent);

              // Get all selected options
              const selectedOptions = {};
              card.querySelectorAll('.sl-size-btn[data-selected="true"], .sl-color-swatch[data-selected="true"]').forEach(selectedBtn => {
                const position = selectedBtn.getAttribute('data-option-position');
                const value = selectedBtn.getAttribute('data-option-value');
                if (position && value) {
                  selectedOptions['option' + position] = value;
                }
              });

              // Find matching variant
              let matchingVariant = variants.find(variant => {
                return Object.keys(selectedOptions).every(key => variant[key] === selectedOptions[key]) && variant.available;
              });

              // Fallback
              if (!matchingVariant) {
                const clickedPosition = this.getAttribute('data-option-position');
                const clickedValue = this.getAttribute('data-option-value');
                const optionKey = 'option' + clickedPosition;

                matchingVariant = variants.find(variant =>
                  variant[optionKey] === clickedValue && variant.available
                );
              }

              if (matchingVariant) {
                // Update add to cart button
                if (addToCartBtn) {
                  addToCartBtn.setAttribute('data-variant-id', matchingVariant.id);
                }

                // Update subscribe button with variant parameter
                if (subscribeBtn) {
                  const baseUrl = subscribeBtn.href.split('?')[0];
                  subscribeBtn.href = baseUrl + '?variant=' + matchingVariant.id + '&subscribe=true';
                  subscribeBtn.setAttribute('data-variant-id', matchingVariant.id);
                }

                // Update price
                const priceElement = card.querySelector('[data-product-price]');
                if (priceElement) {
                  priceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.price) : '$' + (matchingVariant.price / 100).toFixed(2);
                }

                // Update compare price
                const comparePriceElement = card.querySelector('.sl-price-compare');
                if (comparePriceElement && matchingVariant.compare_at_price) {
                  comparePriceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.compare_at_price) : '$' + (matchingVariant.compare_at_price / 100).toFixed(2);
                  comparePriceElement.style.display = 'inline';
                } else if (comparePriceElement) {
                  comparePriceElement.style.display = 'none';
                }

                // Update product image when color is selected
                if (matchingVariant.featured_image && this.classList.contains('sl-color-swatch')) {
                  const productImage = card.querySelector('.sl-product-image img');
                  if (productImage) {
                    let newImageUrl = matchingVariant.featured_image.src;
                    newImageUrl = newImageUrl.replace(/(_\d+x\d+)?(\.[^.]+)$/, '_600x600$2');
                    productImage.src = newImageUrl;
                    productImage.srcset = newImageUrl + ' 600w';
                    productImage.alt = matchingVariant.featured_image.alt || matchingVariant.name;
                  }
                }
              }
            } catch (error) {
              console.error('Error selecting variant:', error);
            }
          });
        });

        // Add to Cart
        const addToCartBtn = card.querySelector('.sl-add-to-cart-btn');
        if (addToCartBtn) {
          addToCartBtn.addEventListener('click', function() {
            const variantId = this.getAttribute('data-variant-id');

            if (!variantId) {
              alert('Please select a variant');
              return;
            }

            const originalContent = this.innerHTML;
            this.innerHTML = 'Adding...';
            this.disabled = true;

            const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
            const formData = new FormData();
            formData.append('id', variantId);
            formData.append('quantity', '1');

            if (cart) {
              try {
                const sectionsToRender = cart.getSectionsToRender().map((section) => section.id);
                formData.append('sections', sectionsToRender);
                formData.append('sections_url', window.location.pathname);
                cart.setActiveElement(document.activeElement);
              } catch (e) {
                console.log('Cart sections error:', e);
              }
            }

            const btn = this;
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body: formData
            })
            .then(response => response.json())
            .then(response => {
              if (response.status) {
                throw new Error(response.description || 'Error adding to cart');
              }

              btn.innerHTML = 'Added!';

              if (!cart) {
                window.location = '/cart';
                return;
              }

              if (cart.classList.contains('is-empty')) {
                cart.classList.remove('is-empty');
              }

              cart.renderContents(response);

              setTimeout(() => {
                btn.innerHTML = originalContent;
                btn.disabled = false;
              }, 1500);
            })
            .catch(error => {
              console.error('Error adding to cart:', error);
              btn.innerHTML = originalContent;
              btn.disabled = false;
              alert('Error: ' + error.message);
            });
          });
        }
      })();
    </script>
  {%- endif -%}

{%- else -%}
  <div class="card-wrapper underline-links-hover">
    <div class="card
      card--{{ settings.card_style }}
      card--text
      {% if extend_height %} card--extend-height{% endif %}
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }}{% endif %}
      {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}"
      style="--ratio-percent: 100%;"
    >
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }}{% endif %}{% if settings.card_style == 'standard' %} ratio{% endif %}" style="--ratio-percent: 100%;">
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading">
              <a role="link" aria-disabled="true" class="full-unstyled-link">
                {{ 'onboarding.product_title' | t }}
              </a>
            </h3>
          </div>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price', product: card_product, price_class: '' %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
