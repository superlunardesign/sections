{%- comment -%}
  SL Why We Love It — full-width product feature row.
  Content comes from customizer settings (wire to metafields via dynamic source).
  Section hides entirely if heading and body are both empty.
  Layout: text left, image right.
{%- endcomment -%}

{%- style -%}

#SLWhyWeLove-{{ section.id }} {
  padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px ;

}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 80px {{ section.settings.padding_bottom }}px 80px;
  }
}



#SLWhyWeLove-{{ section.id }} .sl-wwl__card {
  background: {{ section.settings.card_bg }};
  border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
  border-radius: {{ section.settings.border_radius }}px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  min-height: 220px;
  margin: 0 16px;
}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} .sl-wwl__card {
    grid-template-columns: 1fr {{ section.settings.image_width }}%;
    min-height: 280px;
    margin: 0;
  }
}

#SLWhyWeLove-{{ section.id }} .sl-wwl__text {
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  order: 1;
}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} .sl-wwl__text {
    padding: {{ section.settings.text_padding }}px;
    order: 0;
  }
}

#SLWhyWeLove-{{ section.id }} .sl-wwl__heading {
  font-family: var(--font-heading-family);
  font-size: {{ section.settings.heading_size_mobile }}px;
  font-weight: {{ section.settings.heading_weight }};
  color: {{ section.settings.heading_color }};
  margin: 0 0 16px 0;
  line-height: 1.3;
}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} .sl-wwl__heading {
    font-size: {{ section.settings.heading_size }}px;
  }
}

#SLWhyWeLove-{{ section.id }} .sl-wwl__body {
  font-family: var(--font-body-family);
  font-size: {{ section.settings.body_size_mobile }}px;
  color: {{ section.settings.body_color }};
  line-height: 1.6;
  margin: 0;
}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} .sl-wwl__body {
    font-size: {{ section.settings.body_size }}px;
  }
}
#SLWhyWeLove-{{ section.id }} .sl-wwl__body p { margin: 0 0 0.5em; }
#SLWhyWeLove-{{ section.id }} .sl-wwl__body p:last-child { margin-bottom: 0; }

#SLWhyWeLove-{{ section.id }} .sl-wwl__image-wrap {
  position: relative;
  overflow: hidden;
  min-height: 200px;
  order: 0;
}
@media (min-width: 750px) {
  #SLWhyWeLove-{{ section.id }} .sl-wwl__image-wrap {
    min-height: 100%;
    order: 1;
  }
}

#SLWhyWeLove-{{ section.id }} .sl-wwl__image-wrap img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
}
{%- endstyle -%}

{%- assign wwl_heading = section.settings.heading -%}
{%- assign wwl_body = section.settings.body -%}
{%- comment -%} Fallback: read metafield directly if dynamic source didn't map {%- endcomment -%}
{%- if wwl_body == blank and product.metafields.custom.why_we_love_it != blank -%}
  {%- assign wwl_body = product.metafields.custom.why_we_love_it.value -%}
{%- endif -%}
{%- assign wwl_image = section.settings.image -%}

{%- comment -%}
  No auto-generated defaults — if the customizer fields (wired via dynamic source)
  are empty, the section hides entirely. This lets merchants control visibility
  by simply connecting or disconnecting metafields.
{%- endcomment -%}

{%- comment -%}
  Image logic: use setting first, then product.images[1] if 2+ images,
  otherwise product.images[0] if at least 1 image exists.
  (If product has only 1 image, Why We Love It gets it; How To Use does not.)
{%- endcomment -%}
{%- if wwl_image == blank and product != blank -%}
  {%- if product.images.size > 1 -%}
    {%- assign wwl_image = product.images[1] -%}
  {%- elsif product.images.size == 1 -%}
    {%- assign wwl_image = product.images[0] -%}
  {%- endif -%}
{%- endif -%}

{%- if wwl_body != blank -%}
<div id="SLWhyWeLove-{{ section.id }}">
  <div class="sl-wwl__card">
    <div class="sl-wwl__text">
      {%- if wwl_heading != blank -%}
        <h2 class="sl-wwl__heading">{{ wwl_heading }}</h2>
      {%- endif -%}
      {%- if wwl_body != blank -%}
        <div class="sl-wwl__body">{{ wwl_body }}</div>
      {%- endif -%}
    </div>
    <div class="sl-wwl__image-wrap">
      {%- if wwl_image != blank -%}
        <img
          src="{{ wwl_image | image_url: width: 800 }}"
          srcset="{{ wwl_image | image_url: width: 400 }} 400w,
                  {{ wwl_image | image_url: width: 600 }} 600w,
                  {{ wwl_image | image_url: width: 800 }} 800w"
          sizes="(min-width: 750px) 35vw, 100vw"
          alt="{{ wwl_image.alt | escape | default: wwl_heading }}"
          width="{{ wwl_image.width }}"
          height="{{ wwl_image.height }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Why We Love It",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional heading. Section visibility is controlled by body text."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "info": "Connect to a dynamic source (metafield). Section hides when this is empty. Falls back to product.metafields.custom.why_we_love_it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave blank to auto-use product image 2 (or image 1 if only one image)"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 1,
      "unit": "px",
      "label": "Border width"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px",
      "label": "Border radius"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 25,
      "max": 50,
      "step": 5,
      "default": 35,
      "unit": "%",
      "label": "Image width (desktop)"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "default": 22,
      "unit": "px",
      "label": "Heading size (desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 28,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "Heading size (mobile)"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Body size (desktop)"
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 13,
      "max": 16,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Body size (mobile)"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "text_padding",
      "min": 24,
      "max": 60,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Text padding (desktop)"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Padding top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 12,
      "unit": "px",
      "label": "Padding top (mobile)"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px",
      "label": "Padding bottom (mobile)"
    }
  ],
  "presets": [
    {
      "name": "Why We Love It"
    }
  ]
}
{% endschema %}
