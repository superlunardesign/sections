<!-- Custom Split Section -->
<div id="CustomSplitSection-{{ section.id }}" class="custom-split-section">
  <div class="split-container {% if section.settings.desktop_layout == 'image_right' %}layout-flipped{% endif %} {% if section.settings.mobile_layout == 'image_bottom' %}mobile-flipped{% endif %}">

    <!-- Image Column -->
    <div class="split-column split-column--image">
      <div class="image-wrapper">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                    {{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 800 }} 800w,
                    {{ section.settings.image | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {% else %}
          <div class="placeholder-image">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Content Column -->
    <div class="split-column split-column--content">
      <div class="content-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}

            {% when 'subheading' %}
              <p class="subheading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

            {% when 'heading' %}
              <{{ block.settings.heading_tag }} class="main-heading" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</{{ block.settings.heading_tag }}>

            {% when 'text' %}
              <div class="body-text" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {% when 'button' %}
              <a href="{{ block.settings.link }}" class="split-button" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
                {% if block.settings.show_arrow %}
                  <span class="button-arrow">→</span>
                {% endif %}
              </a>

          {% endcase %}
        {% endfor %}
      </div>
    </div>

  </div>
</div>

{%- style -%}
  /* =============================================
     CUSTOM SPLIT SECTION - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CustomSplitSection-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background_color }};
  }

  #CustomSplitSection-{{ section.id }} .split-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
    align-items: center;
  }

  /* Default: Image Left, Content Right */
  #CustomSplitSection-{{ section.id }} .split-column--image {
    order: 1;
  }

  #CustomSplitSection-{{ section.id }} .split-column--content {
    order: 2;
  }

  /* Flipped: Image Right, Content Left */
  #CustomSplitSection-{{ section.id }} .layout-flipped .split-column--image {
    order: 2;
  }

  #CustomSplitSection-{{ section.id }} .layout-flipped .split-column--content {
    order: 1;
  }

  /* Image Wrapper */
  #CustomSplitSection-{{ section.id }} .image-wrapper {
    background-color: {{ section.settings.image_background_color }};
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
  }

  #CustomSplitSection-{{ section.id }} .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  #CustomSplitSection-{{ section.id }} .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.image_background_color }};
  }

  #CustomSplitSection-{{ section.id }} .placeholder-image .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  /* Content Wrapper */
  #CustomSplitSection-{{ section.id }} .content-wrapper {
    padding: {{ section.settings.content_padding }}px;
  }

  /* Block Styles */
  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'subheading' %}
        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].subheading {
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
          color: {{ block.settings.color }};
          text-transform: {{ block.settings.text_transform }};
          letter-spacing: {{ block.settings.letter_spacing }}px;
          margin: 0 0 {{ block.settings.margin_bottom }}px 0;
        }

        @media (max-width: 990px) {
          #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].subheading {
            font-size: {{ block.settings.font_size_mobile }}px;
          }
        }

      {% when 'heading' %}
        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].main-heading {
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
          font-style: {{ block.settings.font_style }};
          color: {{ block.settings.color }};
          line-height: {{ block.settings.line_height }};
          margin: 0 0 {{ block.settings.margin_bottom }}px 0;
        }

        @media (max-width: 990px) {
          #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].main-heading {
            font-size: {{ block.settings.font_size_mobile }}px;
          }
        }

      {% when 'text' %}
        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].body-text {
          font-size: {{ block.settings.font_size }}px;
          color: {{ block.settings.color }};
          line-height: {{ block.settings.line_height }};
          margin: 0 0 {{ block.settings.margin_bottom }}px 0;
        }

        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].body-text p {
          margin: 0 0 1em 0;
        }

        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].body-text p:last-child {
          margin-bottom: 0;
        }

        @media (max-width: 990px) {
          #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].body-text {
            font-size: {{ block.settings.font_size_mobile }}px;
          }
        }

      {% when 'button' %}
        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].split-button {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
          background-color: {{ block.settings.background_color }};
          color: {{ block.settings.text_color }};
          border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
          border-radius: {{ block.settings.border_radius }}px;
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
          text-decoration: none;
          text-transform: {{ block.settings.text_transform }};
          letter-spacing: {{ block.settings.letter_spacing }}px;
          transition: all 0.3s ease;
          cursor: pointer;
          margin-top: {{ block.settings.margin_top }}px;
        }

        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].split-button:hover {
          background-color: {{ block.settings.hover_background_color }};
          color: {{ block.settings.hover_text_color }};
          border-color: {{ block.settings.hover_border_color }};
        }

        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].split-button .button-arrow {
          font-size: 1.1em;
          transition: transform 0.3s ease;
        }

        #CustomSplitSection-{{ section.id }} [data-block-id="{{ block.id }}"].split-button:hover .button-arrow {
          transform: translateX(4px);
        }

    {% endcase %}
  {% endfor %}

  /* Tablet/Mobile Styles */
  @media (max-width: 990px) {
    #CustomSplitSection-{{ section.id }} .split-container {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
      padding: 0 {{ section.settings.horizontal_padding_mobile }}px;
    }

    /* Default mobile: Image Top, Content Bottom */
    /* Use .split-container to match specificity of desktop .layout-flipped rules */
    #CustomSplitSection-{{ section.id }} .split-container .split-column--image {
      order: 1;
    }

    #CustomSplitSection-{{ section.id }} .split-container .split-column--content {
      order: 2;
    }

    /* Mobile Flipped: Content Top, Image Bottom */
    #CustomSplitSection-{{ section.id }} .split-container.mobile-flipped .split-column--image {
      order: 2;
    }

    #CustomSplitSection-{{ section.id }} .split-container.mobile-flipped .split-column--content {
      order: 1;
    }

    #CustomSplitSection-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #CustomSplitSection-{{ section.id }} .image-wrapper {
      aspect-ratio: {{ section.settings.image_aspect_ratio_mobile }};
    }

    #CustomSplitSection-{{ section.id }} .content-wrapper {
      padding: {{ section.settings.content_padding_mobile }}px;
    }
  }
{%- endstyle -%}

