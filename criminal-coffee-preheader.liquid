{%- style -%}
  #CriminalPreheader-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_vertical }}px 0;
    font-size: {{ section.settings.font_size }}px;
    border-bottom: 1px solid #ffffff;
  }

  #CriminalPreheader-{{ section.id }} .preheader-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #CriminalPreheader-{{ section.id }} .preheader-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #CriminalPreheader-{{ section.id }} .preheader-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  #CriminalPreheader-{{ section.id }} .preheader-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  #CriminalPreheader-{{ section.id }} .preheader-link:hover {
    opacity: 0.7;
  }

  #CriminalPreheader-{{ section.id }} .preheader-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  #CriminalPreheader-{{ section.id }} .preheader-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #CriminalPreheader-{{ section.id }} .subscription-icon {
    width: 20px;
    height: 16px;
  }

  #CriminalPreheader-{{ section.id }} .subscription-icon svg {
    width: 100%;
    height: 100%;
  }

  #CriminalPreheader-{{ section.id }} .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text_color }};
    transition: opacity 0.2s;
  }

  #CriminalPreheader-{{ section.id }} .social-link:hover {
    opacity: 0.7;
  }

  #CriminalPreheader-{{ section.id }} .social-icon {
    width: 18px;
    height: 18px;
  }

  /* Desktop: show social icons, hide mobile subscription link on left */
  #CriminalPreheader-{{ section.id }} .preheader-left-social {
    display: flex;
  }
  #CriminalPreheader-{{ section.id }} .preheader-left-subscription {
    display: none;
  }

  /* Desktop: show subscription link on right when logged in */
  #CriminalPreheader-{{ section.id }} .preheader-subscription-desktop {
    display: flex;
  }

  /* Mobile styles */
  @media (max-width: 749px) {
    /* When logged in on mobile: show subscription on left, hide social icons */
    {%- if customer -%}
      #CriminalPreheader-{{ section.id }} .preheader-left-social {
        display: none;
      }
      #CriminalPreheader-{{ section.id }} .preheader-left-subscription {
        display: flex;
      }
      #CriminalPreheader-{{ section.id }} .preheader-subscription-desktop {
        display: none;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<div id="CriminalPreheader-{{ section.id }}" class="criminal-preheader">
  <div class="preheader-container">
    <!-- Left side -->
    <div class="preheader-left">
      <!-- Social icons (desktop always, mobile only when logged out) -->
      <div class="preheader-left-social" style="display: flex; align-items: center; gap: 12px;">
        {%- if section.settings.social_twitter_link != blank -%}
          <a href="{{ section.settings.social_twitter_link }}" class="social-link" target="_blank" rel="noopener" aria-label="X (Twitter)">
            <span class="social-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
        {%- if section.settings.social_instagram_link != blank -%}
          <a href="{{ section.settings.social_instagram_link }}" class="social-link" target="_blank" rel="noopener" aria-label="Instagram">
            <span class="social-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      <!-- Subscription link (mobile only when logged in) -->
      {%- if customer -%}
        <a href="https://criminalcoffeeco.com/tools/recurring/login" class="preheader-link preheader-left-subscription">
          <span class="subscription-icon">{% render 'subsciption-icon' %}</span>
          <span>Manage Subscriptions</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Right side -->
    <div class="preheader-right">
      {%- if customer -%}
        <!-- Logged in -->
        <a href="{{ routes.account_url }}" class="preheader-link">
          <span class="preheader-icon">{% render 'icon-account' %}</span>
          <span>My Account</span>
        </a>
        <a href="https://criminalcoffeeco.com/tools/recurring/login" class="preheader-link preheader-subscription-desktop">
          <span class="subscription-icon">{% render 'subsciption-icon' %}</span>
          <span>Manage Subscriptions</span>
        </a>
      {%- else -%}
        <!-- Logged out -->
        <a href="{{ routes.account_login_url }}" class="preheader-link">
          <span class="preheader-icon">{% render 'icon-account' %}</span>
          <span>Log In</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Criminal Preheader",
  "class": "criminal-preheader-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 8
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Criminal Preheader"
    }
  ]
}
{% endschema %}
