{%- style -%}
  /* ========== Breadcrumbs ========== */
  #SLBreadcrumbs-{{ section.id }} {
    background-color: {{ section.settings.breadcrumb_bg_color }};
  }

  #SLBreadcrumbs-{{ section.id }} .sl-breadcrumbs__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    font-size: {{ section.settings.breadcrumb_font_size }}px;
    font-family: var(--font-body-family);
    line-height: 1;
  }

  #SLBreadcrumbs-{{ section.id }} .sl-breadcrumbs__nav a {
    color: {{ section.settings.breadcrumb_text_color }};
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  #SLBreadcrumbs-{{ section.id }} .sl-breadcrumbs__nav a:hover {
    opacity: 1;
  }

  #SLBreadcrumbs-{{ section.id }} .sl-breadcrumbs__separator {
    color: {{ section.settings.breadcrumb_text_color }};
    opacity: 0.5;
  }

  #SLBreadcrumbs-{{ section.id }} .sl-breadcrumbs__nav span[aria-current] {
    color: {{ section.settings.breadcrumb_text_color }};
  }

  /* ========== Banner Container ========== */
  #SLBanner-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    min-height: {{ section.settings.banner_height_mobile }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} {
      min-height: {{ section.settings.banner_height }}px;
    }
  }

  /* Banner Image */
  #SLBanner-{{ section.id }} .sl-banner-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  /* Banner Content */
  #SLBanner-{{ section.id }} .sl-banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_horizontal_position }};
    justify-content: {{ section.settings.content_position }};
    min-height: {{ section.settings.banner_height_mobile }}px;
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} .sl-banner-content {
      min-height: {{ section.settings.banner_height }}px;
      {%- if section.settings.use_page_width -%}
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- else -%}
        padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
      {%- endif -%}
    }
  }

  #SLBanner-{{ section.id }} .sl-banner-text {
    max-width: {{ section.settings.text_max_width }}px;
    width: 100%;
    display: flex;
    flex-direction: column;
    {%- case section.settings.text_alignment -%}
      {%- when 'left' -%}
        align-items: flex-start;
        text-align: left;
      {%- when 'center' -%}
        align-items: center;
        text-align: center;
      {%- when 'right' -%}
        align-items: flex-end;
        text-align: right;
    {%- endcase -%}
  }

  /* ========== Block Styles ========== */

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'heading' -%}
        #SLBlock-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
          font-weight: {{ block.settings.weight }};
          color: {{ block.settings.color }};
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
          line-height: {{ block.settings.line_height }};
          font-family: var(--font-heading-family);
          {%- if block.settings.letter_spacing != 0 -%}
            letter-spacing: {{ block.settings.letter_spacing }}em;
          {%- endif -%}
          {%- if block.settings.uppercase -%}
            text-transform: uppercase;
          {%- endif -%}
        }
        @media screen and (min-width: 750px) {
          #SLBlock-{{ block.id }} {
            font-size: {{ block.settings.size }}px;
          }
        }

      {%- when 'subheading' -%}
        #SLBlock-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
          font-weight: {{ block.settings.weight }};
          color: {{ block.settings.color }};
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
          line-height: 1.4;
          font-family: var(--font-body-family);
          letter-spacing: {{ block.settings.letter_spacing }}em;
          {%- if block.settings.uppercase -%}
            text-transform: uppercase;
          {%- endif -%}
        }
        @media screen and (min-width: 750px) {
          #SLBlock-{{ block.id }} {
            font-size: {{ block.settings.size }}px;
          }
        }

      {%- when 'description' -%}
        #SLBlock-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
          color: {{ block.settings.color }};
          line-height: {{ block.settings.line_height }};
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
          font-family: var(--font-body-family);
          max-width: {{ block.settings.max_width }}px;
          opacity: {{ block.settings.opacity | divided_by: 100.0 }};
        }
        #SLBlock-{{ block.id }} p {
          margin: 0;
        }
        @media screen and (min-width: 750px) {
          #SLBlock-{{ block.id }} {
            font-size: {{ block.settings.size }}px;
          }
        }

      {%- when 'richtext' -%}
        #SLBlock-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
          color: {{ block.settings.color }};
          line-height: 1.6;
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
          font-family: var(--font-body-family);
        }
        #SLBlock-{{ block.id }} p { margin: 0 0 0.5em 0; }
        #SLBlock-{{ block.id }} p:last-child { margin-bottom: 0; }
        @media screen and (min-width: 750px) {
          #SLBlock-{{ block.id }} {
            font-size: {{ block.settings.size }}px;
          }
        }

      {%- when 'button' -%}
        #SLBlock-{{ block.id }} {
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
        }
        #SLBlock-{{ block.id }} a {
          display: inline-block;
          padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
          font-family: var(--font-body-family);
          border-radius: {{ block.settings.border_radius }}px;
          text-decoration: none;
          transition: opacity 0.2s;
          cursor: pointer;
          letter-spacing: {{ block.settings.letter_spacing }}em;
          {%- if block.settings.uppercase -%}
            text-transform: uppercase;
          {%- endif -%}
          {%- if block.settings.style == 'filled' -%}
            background-color: {{ block.settings.bg_color }};
            color: {{ block.settings.text_color }};
            border: 2px solid {{ block.settings.bg_color }};
          {%- else -%}
            background-color: transparent;
            color: {{ block.settings.text_color }};
            border: 2px solid {{ block.settings.text_color }};
          {%- endif -%}
        }
        #SLBlock-{{ block.id }} a:hover {
          opacity: 0.85;
        }

      {%- when 'badge' -%}
        #SLBlock-{{ block.id }} {
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
        }
        #SLBlock-{{ block.id }} span {
          display: inline-block;
          padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
          background-color: {{ block.settings.bg_color }};
          color: {{ block.settings.text_color }};
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
          font-family: var(--font-body-family);
          border-radius: {{ block.settings.border_radius }}px;
          letter-spacing: {{ block.settings.letter_spacing }}em;
          line-height: 1;
          {%- if block.settings.uppercase -%}
            text-transform: uppercase;
          {%- endif -%}
        }

      {%- when 'divider' -%}
        #SLBlock-{{ block.id }} {
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
          width: {{ block.settings.width }}%;
        }
        #SLBlock-{{ block.id }} hr {
          border: none;
          border-top: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color }};
          margin: 0;
          opacity: {{ block.settings.opacity | divided_by: 100.0 }};
        }

      {%- when 'spacer' -%}
        #SLBlock-{{ block.id }} {
          height: {{ block.settings.height_mobile }}px;
        }
        @media screen and (min-width: 750px) {
          #SLBlock-{{ block.id }} {
            height: {{ block.settings.height }}px;
          }
        }

      {%- when 'icon_row' -%}
        #SLBlock-{{ block.id }} {
          display: flex;
          flex-wrap: wrap;
          gap: {{ block.settings.gap }}px;
          margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
        }
        #SLBlock-{{ block.id }} .sl-icon-item {
          display: flex;
          align-items: center;
          gap: 6px;
          font-size: {{ block.settings.font_size }}px;
          color: {{ block.settings.color }};
          font-family: var(--font-body-family);
        }
        #SLBlock-{{ block.id }} .sl-icon-item img {
          width: {{ block.settings.icon_size }}px;
          height: {{ block.settings.icon_size }}px;
          object-fit: contain;
        }
        #SLBlock-{{ block.id }} .sl-icon-item svg {
          width: {{ block.settings.icon_size }}px;
          height: {{ block.settings.icon_size }}px;
        }

    {%- endcase -%}
  {%- endfor -%}
{%- endstyle -%}

{%- if section.settings.show_breadcrumbs -%}
  <div class="sl-breadcrumbs" id="SLBreadcrumbs-{{ section.id }}">
    <nav class="sl-breadcrumbs__nav page-width" aria-label="Breadcrumb">
      <a href="/collections/all">Shop</a>

      {%- assign parent = collection.metafields.custom.parent_collection.value -%}
      {%- if parent != blank -%}
        <span class="sl-breadcrumbs__separator">/</span>
        <a href="{{ parent.url }}">{{ parent.title }}</a>
      {%- endif -%}

      <span class="sl-breadcrumbs__separator">/</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>
  </div>
{%- endif -%}

<div id="SLBanner-{{ section.id }}">
  {%- if collection.image -%}
    <img
      class="sl-banner-image"
      srcset="{%- if collection.image.width >= 375 -%}{{ collection.image | image_url: width: 375 }} 375w,{%- endif -%}
        {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if collection.image.width >= 1100 -%}{{ collection.image | image_url: width: 1100 }} 1100w,{%- endif -%}
        {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
        {%- if collection.image.width >= 1920 -%}{{ collection.image | image_url: width: 1920 }} 1920w,{%- endif -%}
        {{ collection.image | image_url }} {{ collection.image.width }}w"
      src="{{ collection.image | image_url: width: 1500 }}"
      sizes="100vw"
      alt="{{ collection.title | escape }}"
      width="{{ collection.image.width }}"
      height="{{ collection.image.height }}"
      loading="eager"
    >
  {%- endif -%}

  <div class="sl-banner-content{%- if section.settings.use_page_width %} page-width{%- endif -%}">
    <div class="sl-banner-text">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'heading' -%}
            <h1 id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}
                {{ block.settings.text }}
              {%- else -%}
                {{ collection.title }}
              {%- endif -%}
            </h1>

          {%- when 'subheading' -%}
            <p id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}
                {{ block.settings.text }}
              {%- else -%}
                {{ collection.metafields.custom.subtitle.value | default: '' }}
              {%- endif -%}
            </p>

          {%- when 'description' -%}
            {%- if collection.description != blank -%}
              <div id="SLBlock-{{ block.id }}" class="sl-banner-description" {{ block.shopify_attributes }}>
                {{ collection.description }}
              </div>
            {%- endif -%}

          {%- when 'richtext' -%}
            {%- if block.settings.text != blank -%}
              <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- when 'button' -%}
            <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: '#' }}">
                {{ block.settings.text | default: 'Shop Now' }}
              </a>
            </div>

          {%- when 'badge' -%}
            <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              <span>{{ block.settings.text | default: 'NEW' }}</span>
            </div>

          {%- when 'divider' -%}
            <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              <hr>
            </div>

          {%- when 'spacer' -%}
            <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}></div>

          {%- when 'icon_row' -%}
            <div id="SLBlock-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign text_key = 'text_' | append: i -%}
                {%- assign icon_key = 'icon_' | append: i -%}
                {%- assign icon_text = block.settings[text_key] -%}
                {%- assign icon_image = block.settings[icon_key] -%}
                {%- if icon_text != blank -%}
                  <div class="sl-icon-item">
                    {%- if icon_image != blank -%}
                      <img
                        src="{{ icon_image | image_url: width: 48 }}"
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                      >
                    {%- endif -%}
                    <span>{{ icon_text }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SL Collection Banner",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": false,
      "label": "Show breadcrumbs"
    },
    {
      "type": "color",
      "id": "breadcrumb_bg_color",
      "label": "Breadcrumb background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "breadcrumb_text_color",
      "label": "Breadcrumb text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 13,
      "unit": "px",
      "label": "Breadcrumb font size"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 250,
      "unit": "px",
      "label": "Banner height (desktop)"
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 100,
      "max": 400,
      "step": 10,
      "default": 200,
      "unit": "px",
      "label": "Banner height (mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Image opacity"
    },
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_horizontal_position",
      "label": "Horizontal content position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "default": 700,
      "unit": "px",
      "label": "Text max width"
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "checkbox",
      "id": "use_page_width",
      "default": false,
      "label": "Use page width container (desktop)",
      "info": "Uses the theme's page-width class at 750px+ instead of manual horizontal padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding horizontal"
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Padding bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Padding horizontal"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Custom text",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "range",
          "id": "size",
          "min": 18,
          "max": 72,
          "step": 2,
          "default": 36,
          "unit": "px",
          "label": "Size (desktop)"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 16,
          "max": 48,
          "step": 2,
          "default": 28,
          "unit": "px",
          "label": "Size (mobile)"
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "line_height",
          "min": 1,
          "max": 2,
          "step": 0.1,
          "default": 1.2,
          "label": "Line height"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "min": -0.05,
          "max": 0.3,
          "step": 0.01,
          "default": 0,
          "unit": "em",
          "label": "Letter spacing"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "default": false,
          "label": "Uppercase"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 40,
          "step": 2,
          "default": 0,
          "unit": "px",
          "label": "Margin top"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 40,
          "step": 2,
          "default": 12,
          "unit": "px",
          "label": "Margin bottom"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Leave blank to pull from collection subtitle metafield"
        },
        {
          "type": "range",
          "id": "size",
          "min": 10,
          "max": 24,
          "step": 1,
          "default": 14,
          "unit": "px",
          "label": "Size (desktop)"
        },
        {
          "type": "range",
          "id": "size_mobile",
          "min": 10,
          "max": 20,
          "step": 1,
          "default": 12,
          "unit": "px",
          "label": "Size (mobile)"
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "500"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "min": 0,
          "max": 0.3,
          "step": 0.01,
          "default": 0.1,
          "unit": "em",
          "label": "Letter spacing"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "default": true,
          "label": "Uppercase"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
