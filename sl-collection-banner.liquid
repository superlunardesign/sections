{%- style -%}
  /* ===== Breadcrumbs ===== */
  #SLBanner-{{ section.id }}-breadcrumbs {
    background-color: {{ section.settings.breadcrumb_bg_color }};
    padding: {{ section.settings.breadcrumb_padding }}px 0;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.breadcrumb_font_size }}px;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list li {
    display: flex;
    align-items: center;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list li:not(:last-child)::after {
    content: '{{ section.settings.breadcrumb_separator }}';
    margin: 0 8px;
    color: {{ section.settings.breadcrumb_text_color }};
    opacity: 0.5;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list a {
    color: {{ section.settings.breadcrumb_text_color }};
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list a:hover {
    opacity: 1;
  }

  #SLBanner-{{ section.id }}-breadcrumbs .sl-breadcrumb-list .sl-breadcrumb-current {
    color: {{ section.settings.breadcrumb_text_color }};
    opacity: 1;
  }

  /* ===== Banner Container ===== */
  #SLBanner-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    min-height: {{ section.settings.banner_height_mobile }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} {
      min-height: {{ section.settings.banner_height }}px;
    }
  }

  /* Banner Image - opacity on the image itself */
  #SLBanner-{{ section.id }} .sl-banner-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  /* Banner Content */
  #SLBanner-{{ section.id }} .sl-banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_position }};
    min-height: {{ section.settings.banner_height_mobile }}px;
    padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_horizontal_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} .sl-banner-content {
      min-height: {{ section.settings.banner_height }}px;
      {%- if section.settings.use_page_width -%}
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- else -%}
        padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
      {%- endif -%}
    }
  }

  /* Text wrapper for max-width constraint */
  #SLBanner-{{ section.id }} .sl-banner-text {
    max-width: {{ section.settings.text_max_width }}px;
  }

  /* Title */
  #SLBanner-{{ section.id }} .sl-banner-title {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.2;
    font-family: var(--font-heading-family);
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} .sl-banner-title {
      font-size: {{ section.settings.title_size }}px;
    }
  }

  /* Description */
  #SLBanner-{{ section.id }} .sl-banner-description {
    font-size: {{ section.settings.description_size_mobile }}px;
    color: {{ section.settings.text_color }};
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
    font-family: var(--font-body-family);
  }

  #SLBanner-{{ section.id }} .sl-banner-description p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #SLBanner-{{ section.id }} .sl-banner-description {
      font-size: {{ section.settings.description_size }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.show_breadcrumbs -%}
  <nav class="sl-breadcrumbs" id="SLBanner-{{ section.id }}-breadcrumbs" aria-label="Breadcrumb">
    <div class="page-width">
      <ol class="sl-breadcrumb-list">
        <li><a href="/">Home</a></li>
        {%- if collection -%}
          <li><span class="sl-breadcrumb-current">{{ collection.title }}</span></li>
        {%- endif -%}
      </ol>
    </div>
  </nav>
{%- endif -%}

<div id="SLBanner-{{ section.id }}">
  {%- if collection.image -%}
    <img
      class="sl-banner-image"
      srcset="{%- if collection.image.width >= 375 -%}{{ collection.image | image_url: width: 375 }} 375w,{%- endif -%}
        {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if collection.image.width >= 1100 -%}{{ collection.image | image_url: width: 1100 }} 1100w,{%- endif -%}
        {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
        {%- if collection.image.width >= 1920 -%}{{ collection.image | image_url: width: 1920 }} 1920w,{%- endif -%}
        {{ collection.image | image_url }} {{ collection.image.width }}w"
      src="{{ collection.image | image_url: width: 1500 }}"
      sizes="100vw"
      alt="{{ collection.title | escape }}"
      width="{{ collection.image.width }}"
      height="{{ collection.image.height }}"
      loading="eager"
    >
  {%- endif -%}

  <div class="sl-banner-content{% if section.settings.use_page_width %} page-width{% endif %}">
    <div class="sl-banner-text">
      {%- if section.settings.show_title -%}
        <h1 class="sl-banner-title">{{ collection.title }}</h1>
      {%- endif -%}

      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="sl-banner-description">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SL Collection Banner",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "Show breadcrumbs"
    },
    {
      "type": "color",
      "id": "breadcrumb_bg_color",
      "label": "Breadcrumb background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "breadcrumb_text_color",
      "label": "Breadcrumb text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 13,
      "unit": "px",
      "label": "Breadcrumb font size"
    },
    {
      "type": "range",
      "id": "breadcrumb_padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10,
      "unit": "px",
      "label": "Breadcrumb vertical padding"
    },
    {
      "type": "select",
      "id": "breadcrumb_separator",
      "label": "Breadcrumb separator",
      "options": [
        { "value": "/", "label": "/" },
        { "value": ">", "label": ">" },
        { "value": "|", "label": "|" },
        { "value": "\\2022", "label": "Bullet" }
      ],
      "default": "/"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 250,
      "unit": "px",
      "label": "Banner height (desktop)"
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 100,
      "max": 400,
      "step": 10,
      "default": 200,
      "unit": "px",
      "label": "Banner height (mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Image opacity"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Show collection title"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "default": 700,
      "unit": "px",
      "label": "Text max width"
    },
    {
      "type": "header",
      "content": "Content Layout (desktop)"
    },
    {
      "type": "checkbox",
      "id": "use_page_width",
      "default": false,
      "label": "Use Shopify page-width on desktop",
      "info": "When enabled, content uses Shopify's page-width class on desktop instead of custom horizontal padding."
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px",
      "label": "Title size (desktop)"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 28,
      "unit": "px",
      "label": "Title size (mobile)"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15,
      "unit": "px",
      "label": "Description size (desktop)"
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Description size (mobile)"
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Padding horizontal",
      "info": "Only used when page-width toggle is off."
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Padding bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Padding horizontal"
    }
  ]
}
{% endschema %}
