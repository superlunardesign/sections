{%- style -%}
  .sl-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    position: relative;
    z-index: 1;
  }

  .sl-announcement-bar__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ section.settings.padding_vertical }}px 0;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.font_size_mobile }}px;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .sl-announcement-bar__inner {
      font-size: {{ section.settings.font_size }}px;
    }
  }

  .sl-announcement-bar a,
  .sl-announcement-bar__text {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: opacity 0.2s;
  }

  .sl-announcement-bar a:hover {
    opacity: 0.8;
  }
{%- endstyle -%}

{%- if section.settings.show_announcement -%}
  <div class="sl-announcement-bar" id="SLAnnouncement-{{ section.id }}">
    <div class="page-width">
      <div class="sl-announcement-bar__inner">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
        {%- else -%}
          <span class="sl-announcement-bar__text">{{ section.settings.text }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SL Announcement Bar",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "Show announcement bar"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Announcement text",
      "default": "FREE SHIPPING ON ALL SKINCARE ORDERS $50+ →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#b5b88f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13,
      "unit": "px",
      "label": "Font size (desktop)"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 12,
      "unit": "px",
      "label": "Font size (mobile)"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px",
      "label": "Vertical padding"
    }
  ]
}
{% endschema %}
