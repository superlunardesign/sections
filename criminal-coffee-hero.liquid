{%- style -%}
  /* ==========================================================================
     Criminal Coffee Hero Section - Instance {{ section.id }}
     All styles scoped to this specific section instance
     ========================================================================== */

  /* Section Padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Base Section Styles */
  #CriminalHero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.mobile_height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} {
      height: {{ section.settings.desktop_height }}px;
    }
  }

  /* Background Container */
  #CriminalHero-{{ section.id }} .criminal-hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Background Color Layer */
  #CriminalHero-{{ section.id }} .criminal-hero__bg-color {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.background_color }};
    z-index: 1;
  }

  /* Overlay Layer */
  #CriminalHero-{{ section.id }} .criminal-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 10;
    pointer-events: none;
  }

  /* Single Background Container */
  #CriminalHero-{{ section.id }} .criminal-hero__single-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  /* Background Image Styles */
  #CriminalHero-{{ section.id }} .criminal-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder Styles */
  #CriminalHero-{{ section.id }} .criminal-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #3a2b28;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* Video Styles */
  #CriminalHero-{{ section.id }} .criminal-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__video-embed {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
  }

  /* Scale video embeds to cover container */
  @media screen and (min-aspect-ratio: 16/9) {
    #CriminalHero-{{ section.id }} .criminal-hero__video-embed {
      width: 100%;
      height: 56.25vw;
      min-height: 100%;
      min-width: 177.77vh;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }

  @media screen and (max-aspect-ratio: 16/9) {
    #CriminalHero-{{ section.id }} .criminal-hero__video-embed {
      width: 177.77vh;
      height: 100%;
      min-width: 100%;
      min-height: 56.25vw;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }

  /* ==========================================================================
     Slideshow Styles
     ========================================================================== */

  #CriminalHero-{{ section.id }} .criminal-hero__slideshow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slide.is-exiting {
    opacity: 0;
    visibility: visible;
    z-index: 1;
  }

  /* Fade Transition */
  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--fade .criminal-hero__slide {
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  /* Slide Transition */
  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--slide .criminal-hero__slide {
    opacity: 1;
    visibility: visible;
    transform: translateX(100%);
    transition: transform 0.8s ease;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--slide .criminal-hero__slide.is-active {
    transform: translateX(0);
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--slide .criminal-hero__slide.is-exiting {
    transform: translateX(-100%);
  }

  /* Zoom Transition */
  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--zoom .criminal-hero__slide {
    transition: opacity 0.8s ease, visibility 0.8s ease, transform 0.8s ease;
    transform: scale(1.1);
  }

  #CriminalHero-{{ section.id }} .criminal-hero__slideshow--zoom .criminal-hero__slide.is-active {
    transform: scale(1);
  }

  /* Slideshow Indicators */
  #CriminalHero-{{ section.id }} .criminal-hero__indicators {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 20;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__indicator:hover {
    background-color: rgba(255, 255, 255, 0.6);
  }

  #CriminalHero-{{ section.id }} .criminal-hero__indicator.is-active {
    background-color: #ffffff;
    border-color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__indicators {
      bottom: 30px;
    }

    #CriminalHero-{{ section.id }} .criminal-hero__indicator {
      width: 14px;
      height: 14px;
    }
  }

  /* ==========================================================================
     Content Styles
     ========================================================================== */

  #CriminalHero-{{ section.id }} .criminal-hero__content-wrapper {
    position: relative;
    z-index: 15;
    width: 100%;
    height: 100%;
    display: flex;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__content-wrapper {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  #CriminalHero-{{ section.id }} .criminal-hero__content {
    max-width: {{ section.settings.content_max_width }}px;
    color: {{ section.settings.text_color }};
    padding: 20px;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__content {
      padding: 40px;
    }
  }

  /* Horizontal Positioning */
  #CriminalHero-{{ section.id }} .criminal-hero__content--left {
    margin-right: auto;
    text-align: left;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__content--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__content--right {
    margin-left: auto;
    text-align: right;
  }

  /* Vertical Positioning */
  #CriminalHero-{{ section.id }} .criminal-hero__content--v-top {
    align-self: flex-start;
    padding-top: 40px;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__content--v-center {
    align-self: center;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__content--v-bottom {
    align-self: flex-end;
    padding-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__content--v-top {
      padding-top: 60px;
    }

    #CriminalHero-{{ section.id }} .criminal-hero__content--v-bottom {
      padding-bottom: 60px;
    }
  }

  /* Subheading */
  #CriminalHero-{{ section.id }} .criminal-hero__subheading {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    opacity: 0.9;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__subheading {
      font-size: 14px;
      margin-bottom: 15px;
    }
  }

  /* Heading */
  #CriminalHero-{{ section.id }} .criminal-hero__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 15px 0;
    font-family: var(--font-heading-family, inherit);
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
      margin-bottom: 20px;
    }
  }

  /* Description Text */
  #CriminalHero-{{ section.id }} .criminal-hero__text {
    font-size: {{ section.settings.subtext_size_mobile }}px;
    line-height: 1.6;
    margin: 0 0 20px 0;
    opacity: 0.9;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__text p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__text {
      font-size: {{ section.settings.subtext_size_desktop }}px;
      margin-bottom: 30px;
    }
  }

  /* Buttons */
  #CriminalHero-{{ section.id }} .criminal-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-right: 10px;
    margin-bottom: 10px;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button:hover {
    background-color: {{ section.settings.button_background_hover }};
    color: {{ section.settings.button_text_color_hover }};
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button[aria-disabled="true"] {
    pointer-events: none;
    opacity: 0.6;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button--secondary {
    background-color: transparent;
    border: 2px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }};
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button--secondary:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button-arrow {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button:hover .criminal-hero__button-arrow {
    transform: translateX(4px);
  }

  @media screen and (min-width: 750px) {
    #CriminalHero-{{ section.id }} .criminal-hero__button {
      padding: 14px 28px;
      font-size: 13px;
    }
  }

  /* Center aligned buttons */
  #CriminalHero-{{ section.id }} .criminal-hero__content--center .criminal-hero__button {
    margin-left: 5px;
    margin-right: 5px;
  }

  /* Right aligned buttons */
  #CriminalHero-{{ section.id }} .criminal-hero__content--right .criminal-hero__button {
    margin-left: 10px;
    margin-right: 0;
  }

  /* ==========================================================================
     Responsive Adjustments
     ========================================================================== */

  @media screen and (max-width: 749px) {
    /* Adjust content width on mobile */
    #CriminalHero-{{ section.id }} .criminal-hero__content {
      max-width: 100%;
    }

    /* Stack buttons on mobile */
    #CriminalHero-{{ section.id }} .criminal-hero__content--center .criminal-hero__button,
    #CriminalHero-{{ section.id }} .criminal-hero__content--right .criminal-hero__button {
      margin-left: 0;
      margin-right: 0;
      display: inline-flex;
    }
  }

  /* ==========================================================================
     Animation Enhancements
     ========================================================================== */

  @keyframes heroFadeIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #CriminalHero-{{ section.id }} .criminal-hero__subheading,
  #CriminalHero-{{ section.id }} .criminal-hero__heading,
  #CriminalHero-{{ section.id }} .criminal-hero__text,
  #CriminalHero-{{ section.id }} .criminal-hero__button {
    animation: heroFadeIn-{{ section.id }} 0.8s ease forwards;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__subheading {
    animation-delay: 0.1s;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__heading {
    animation-delay: 0.2s;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__text {
    animation-delay: 0.3s;
  }

  #CriminalHero-{{ section.id }} .criminal-hero__button {
    animation-delay: 0.4s;
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    #CriminalHero-{{ section.id }} .criminal-hero__subheading,
    #CriminalHero-{{ section.id }} .criminal-hero__heading,
    #CriminalHero-{{ section.id }} .criminal-hero__text,
    #CriminalHero-{{ section.id }} .criminal-hero__button,
    #CriminalHero-{{ section.id }} .criminal-hero__slide,
    #CriminalHero-{{ section.id }} .criminal-hero__button-arrow {
      animation: none;
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="CriminalHero-{{ section.id }}"
  class="criminal-hero criminal-hero-{{ section.id }} section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-slideshow-enabled="{{ section.settings.enable_slideshow }}"
  data-slideshow-speed="{{ section.settings.slideshow_speed }}"
  data-slideshow-transition="{{ section.settings.slideshow_transition }}"
>
  {%- comment -%} Background Container {%- endcomment -%}
  <div class="criminal-hero__background">
    {%- comment -%} Overlay {%- endcomment -%}
    <div class="criminal-hero__overlay"></div>

    {%- comment -%} Background Color Fallback {%- endcomment -%}
    <div class="criminal-hero__bg-color"></div>

    {%- comment -%} Single Background or Slideshow Container {%- endcomment -%}
    {%- if section.settings.enable_slideshow and section.blocks.size > 0 -%}
      <div class="criminal-hero__slideshow" data-slideshow>
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div
              class="criminal-hero__slide {% if forloop.first %}is-active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.video != blank -%}
                <video
                  class="criminal-hero__video"
                  autoplay
                  muted
                  loop
                  playsinline
                  style="object-position: {{ block.settings.background_position }};"
                >
                  {{ block.settings.video | video_tag }}
                </video>
              {%- elsif block.settings.video_url != blank -%}
                {%- if block.settings.video_url.type == 'youtube' -%}
                  <iframe
                    class="criminal-hero__video-embed"
                    src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    style="object-position: {{ block.settings.background_position }};"
                  ></iframe>
                {%- elsif block.settings.video_url.type == 'vimeo' -%}
                  <iframe
                    class="criminal-hero__video-embed"
                    src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&playsinline=1"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    style="object-position: {{ block.settings.background_position }};"
                  ></iframe>
                {%- endif -%}
              {%- elsif block.settings.image != blank -%}
                {%- assign image = block.settings.image -%}
                <picture class="criminal-hero__picture">
                  <source
                    media="(min-width: 750px)"
                    srcset="{{ image | image_url: width: 1920 }} 1920w,
                            {{ image | image_url: width: 2560 }} 2560w,
                            {{ image | image_url: width: 3840 }} 3840w"
                    sizes="100vw"
                  >
                  <source
                    srcset="{{ image | image_url: width: 750 }} 750w,
                            {{ image | image_url: width: 1080 }} 1080w,
                            {{ image | image_url: width: 1500 }} 1500w"
                    sizes="100vw"
                  >
                  <img
                    class="criminal-hero__image"
                    src="{{ image | image_url: width: 1920 }}"
                    alt="{{ image.alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                    style="object-position: {{ block.settings.background_position }};"
                  >
                </picture>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'criminal-hero__placeholder' }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Slideshow Indicators {%- endcomment -%}
        {%- if section.settings.show_slideshow_indicators and section.blocks.size > 1 -%}
          <div class="criminal-hero__indicators">
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                <button
                  class="criminal-hero__indicator {% if forloop.first %}is-active{% endif %}"
                  data-slide-indicator="{{ forloop.index0 }}"
                  aria-label="Go to slide {{ forloop.index }}"
                ></button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- comment -%} Single Background {%- endcomment -%}
      <div class="criminal-hero__single-bg">
        {%- if section.settings.video != blank -%}
          <video
            class="criminal-hero__video"
            autoplay
            muted
            loop
            playsinline
            style="object-position: {{ section.settings.background_position }};"
          >
            {{ section.settings.video | video_tag }}
          </video>
        {%- elsif section.settings.video_url != blank -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              class="criminal-hero__video-embed"
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
              allow="autoplay; encrypted-media"
              allowfullscreen
              style="object-position: {{ section.settings.background_position }};"
            ></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe
              class="criminal-hero__video-embed"
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&playsinline=1"
              allow="autoplay; encrypted-media"
              allowfullscreen
              style="object-position: {{ section.settings.background_position }};"
            ></iframe>
          {%- endif -%}
        {%- elsif section.settings.image != blank -%}
          {%- assign image = section.settings.image -%}
          <picture class="criminal-hero__picture">
            <source
              media="(min-width: 750px)"
              srcset="{{ image | image_url: width: 1920 }} 1920w,
                      {{ image | image_url: width: 2560 }} 2560w,
                      {{ image | image_url: width: 3840 }} 3840w"
              sizes="100vw"
            >
            <source
              srcset="{{ image | image_url: width: 750 }} 750w,
                      {{ image | image_url: width: 1080 }} 1080w,
                      {{ image | image_url: width: 1500 }} 1500w"
              sizes="100vw"
            >
            <img
              class="criminal-hero__image"
              src="{{ image | image_url: width: 1920 }}"
              alt="{{ image.alt | escape }}"
              loading="eager"
              fetchpriority="high"
              style="object-position: {{ section.settings.background_position }};"
            >
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'criminal-hero__placeholder' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Content Container {%- endcomment -%}
  <div class="criminal-hero__content-wrapper page-width">
    <div
      class="criminal-hero__content criminal-hero__content--{{ section.settings.content_position }} criminal-hero__content--v-{{ section.settings.content_vertical_position }}"
    >
      {%- if section.settings.subheading != blank -%}
        <p class="criminal-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="criminal-hero__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="criminal-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="criminal-hero__button button"
          {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label }}
          {%- if section.settings.show_button_arrow -%}
            <svg class="criminal-hero__button-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_button_label != blank -%}
        <a
          href="{{ section.settings.secondary_button_link }}"
          class="criminal-hero__button criminal-hero__button--secondary button button--secondary"
          {% if section.settings.secondary_button_link == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    const hero = document.querySelector('#CriminalHero-{{ section.id }}');
    if (!hero) return;

    const slideshowEnabled = hero.dataset.slideshowEnabled === 'true';
    const slideshowSpeed = parseInt(hero.dataset.slideshowSpeed) || 5000;
    const transitionType = hero.dataset.slideshowTransition || 'fade';

    if (!slideshowEnabled) return;

    const slideshow = hero.querySelector('[data-slideshow]');
    if (!slideshow) return;

    const slides = slideshow.querySelectorAll('.criminal-hero__slide');
    const indicators = hero.querySelectorAll('.criminal-hero__indicator');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let interval;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.remove('is-active', 'is-exiting');
        if (i === currentIndex && i !== index) {
          slide.classList.add('is-exiting');
        }
      });

      slides[index].classList.add('is-active');

      indicators.forEach((indicator, i) => {
        indicator.classList.toggle('is-active', i === index);
      });

      currentIndex = index;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      showSlide(next);
    }

    function startSlideshow() {
      interval = setInterval(nextSlide, slideshowSpeed);
    }

    function stopSlideshow() {
      clearInterval(interval);
    }

    indicators.forEach((indicator, i) => {
      indicator.addEventListener('click', () => {
        stopSlideshow();
        showSlide(i);
        startSlideshow();
      });
    });

    hero.addEventListener('mouseenter', stopSlideshow);
    hero.addEventListener('mouseleave', startSlideshow);

    startSlideshow();

    slideshow.classList.add('criminal-hero__slideshow--' + transitionType);
  })();
</script>

