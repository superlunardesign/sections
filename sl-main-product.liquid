      <script>
        document.addEventListener('DOMContentLoaded', function() {
          /* — Wishlist heart toggle — */
          (function() {
            var heartBtns = document.querySelectorAll('.sl-pdp-heart-btn');
            heartBtns.forEach(function(btn) {
              btn.addEventListener('click', function(e) {
                e.preventDefault();
                btn.classList.toggle('is-wishlisted');
                var wrapper = btn.closest('dtx-wishlist');
                if (wrapper) wrapper.classList.toggle('is-wishlisted');
              });
            });
          })();

          /* — Sticky ATC bar: IntersectionObserver — */
          {% if section.settings.enable_sticky_bar %}
          (function() {
            var nativeATC = document.getElementById('sl-native-atc-{{ section.id }}');
            var stickyBar = document.getElementById('sl-sticky-atc-{{ section.id }}');
            if (nativeATC && stickyBar) {
              var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                  if (entry.isIntersecting) {
                    stickyBar.classList.remove('is-visible');
                  } else {
                    stickyBar.classList.add('is-visible');
                  }
                });
              }, { threshold: 0, rootMargin: '0px' });
              observer.observe(nativeATC);
            }
          })();

          /* — Sticky ATC: AJAX add + open cart drawer — */
          (function() {
            var stickyBtn = document.getElementById('sl-sticky-btn-{{ section.id }}');
            if (!stickyBtn) return;
            stickyBtn.addEventListener('click', function() {
              if (stickyBtn.disabled) return;
              var variantId = stickyBtn.getAttribute('data-variant-id');
              var qtyInput = document.getElementById('sl-sticky-qty-{{ section.id }}');
              var qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

              stickyBtn.disabled = true;
              stickyBtn.textContent = 'Adding...';

              var cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
              var formData = new FormData();
              formData.append('id', variantId);
              formData.append('quantity', qty);

              if (cart) {
                try {
                  var sectionsToRender = cart.getSectionsToRender().map(function(s) { return s.id; });
                  formData.append('sections', sectionsToRender);
                  formData.append('sections_url', window.location.pathname);
                  cart.setActiveElement(document.activeElement);
                } catch(e) {}
              }

              fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
              })
              .then(function(res) { return res.json(); })
              .then(function(response) {
                if (response.status) throw new Error(response.description);

                if (cart) {
                  if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
                  cart.renderContents(response);
                } else {
                  window.location = '/cart';
                }
              })
              .catch(function(err) { console.error('Sticky ATC error:', err); })
              .finally(function() {
                stickyBtn.disabled = false;
                {%- if product.selected_or_first_available_variant.available -%}
                  {%- if section.settings.sticky_btn_text != blank -%}
                    stickyBtn.textContent = '{{ section.settings.sticky_btn_text | escape }} | {{ product.selected_or_first_available_variant.price | money }}';
                  {%- else -%}
                    stickyBtn.textContent = '{{ "products.product.add_to_cart" | t | escape }} | {{ product.selected_or_first_available_variant.price | money }}';
                  {%- endif -%}
                {%- endif -%}
              });
            });
          })();
          {% endif %}

          /* — IE fallback — */
          function isIE() {
            const ua = window.navigator.userAgent;
            const msie = ua.indexOf('MSIE ');
            const trident = ua.indexOf('Trident/');
            return (msie > 0 || trident > 0);
          }
          if (!isIE()) return;
          const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id"]');
          const noScriptInputWrapper = document.createElement('div');
          const variantSwitcher = document.querySelector('variant-radios[data-section="{{ section.id }}"]') || document.querySelector('variant-selects[data-section="{{ section.id }}"]');
          noScriptInputWrapper.innerHTML = document.querySelector('.product-form__noscript-wrapper-{{ section.id }}').textContent;
          variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;
          document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function(event) {
            hiddenInput.value = event.currentTarget.value;
          });
        });

        function openTab(evt, TabName) {
          var i, tabcontent, tablinks;
          tabcontent = document.getElementsByClassName("dt-sc-tabs-content");
          for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
          }
          tablinks = document.getElementsByClassName("tablinks");
          for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
          }
          document.getElementById(TabName).style.display = "block";
          evt.currentTarget.className += " active";
        }
        $( ".tablinks" ).first().addClass( "active" );
        $( ".dt-sc-tabs-content" ).first().css( "display", "block" );

        // Add this function to update the variant when selected
function selectVariantUpdated(element) {
  const productInfoWrapper = element.closest('.product__info-wrapper');
  const variantDataScript = productInfoWrapper.querySelector('.variant-data');
  const addToCartBtn = productInfoWrapper.querySelector('.add-to-cart-btn');
  
  if (!variantDataScript || !addToCartBtn) return;
  
  try {
    const variants = JSON.parse(variantDataScript.textContent);
    
    // Get all selected options
    const selectedOptions = [];
    productInfoWrapper.querySelectorAll('input[type="radio"]:checked').forEach(input => {
      selectedOptions.push(input.value);
    });
    
    // Find matching variant
    const matchingVariant = variants.find(variant => {
      return selectedOptions.every((option, index) => 
        variant[`option${index + 1}`] === option
      );
    });
    
    if (matchingVariant) {
      // Update the button's variant ID
      addToCartBtn.setAttribute('data-variant-id', matchingVariant.id);

      // Update the hidden input too
      const hiddenInput = productInfoWrapper.querySelector('input[name="id"]');
      if (hiddenInput) {
        hiddenInput.value = matchingVariant.id;
      }

      // Update button text based on availability
      const buttonText = addToCartBtn.querySelector('span:nth-child(2)');
      if (buttonText) {
        if (matchingVariant.available) {
          buttonText.textContent = 'Add to cart';
          addToCartBtn.disabled = false;
        } else {
          buttonText.textContent = 'Sold out';
          addToCartBtn.disabled = true;
        }
      }

      // --- Update displayed prices for the selected variant ---
      var formatMoney = function(cents) {
        return Shopify.formatMoney ? Shopify.formatMoney(cents) : ('$' + (cents / 100).toFixed(2));
      };

      // Main price block (rendered by 'price' snippet)
      var priceContainer = document.getElementById('price-{{ section.id }}');
      if (priceContainer) {
        // Update regular / sale prices
        var regularItems = priceContainer.querySelectorAll('.price-item--regular');
        var saleItems    = priceContainer.querySelectorAll('.price-item--sale, .price-item--last');
        var priceDiv     = priceContainer.querySelector('.price');

        if (matchingVariant.compare_at_price && matchingVariant.compare_at_price > matchingVariant.price) {
          // On sale
          if (priceDiv) priceDiv.classList.add('price--on-sale');
          regularItems.forEach(function(el) { el.innerHTML = formatMoney(matchingVariant.compare_at_price); });
          saleItems.forEach(function(el)    { el.innerHTML = formatMoney(matchingVariant.price); });
        } else {
          // Regular price
          if (priceDiv) priceDiv.classList.remove('price--on-sale');
          regularItems.forEach(function(el) { el.innerHTML = formatMoney(matchingVariant.price); });
          saleItems.forEach(function(el)    { el.innerHTML = formatMoney(matchingVariant.price); });
        }
      }

      // Subtotal value
      var subtotalEl = document.getElementById('subtotal-value');
      if (subtotalEl) {
        var qtyInput = productInfoWrapper.querySelector('.quantity__input');
        var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
        subtotalEl.innerHTML = formatMoney(matchingVariant.price * qty);
      }

      // Sticky ATC button price
      var stickyBtn = document.getElementById('sl-sticky-btn-{{ section.id }}');
      if (stickyBtn) {
        if (matchingVariant.available) {
          stickyBtn.disabled = false;
          var stickyLabel = '{{ section.settings.sticky_btn_text | escape }}' || '{{ "products.product.add_to_cart" | t | escape }}';
          stickyBtn.textContent = stickyLabel + ' | ' + formatMoney(matchingVariant.price);
        } else {
          stickyBtn.disabled = true;
          stickyBtn.textContent = '{{ "products.product.sold_out" | t | default: "Sold out" }}';
        }
        stickyBtn.setAttribute('data-variant-id', matchingVariant.id);
      }

      console.log('Selected variant:', matchingVariant.id);
    }
  } catch (error) {
    console.error('Error selecting variant:', error);
  }
}


function addToCart(button) {
  const variantId = button.getAttribute('data-variant-id');

  if (!variantId) {
    alert('Please select a variant');
    return;
  }

  // Get the quantity from the quantity input
  const productInfoWrapper = button.closest('.product__info-wrapper');
  const quantityInput = productInfoWrapper.querySelector('.quantity__input');
  const quantity = quantityInput ? quantityInput.value : '1';

  console.log('Adding variant to cart:', variantId, 'Quantity:', quantity);

  // Show loading state
  const originalContent = button.innerHTML;
  button.innerHTML = '<span>Adding...</span>';
  button.disabled = true;

  // Get cart element
  const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');

  // Prepare form data like your working product-form.js does
  const formData = new FormData();
  formData.append('id', variantId);
  formData.append('quantity', quantity); // Use the actual quantity value

  if (cart) {
    // Add sections exactly like your working theme
    try {
      const sectionsToRender = cart.getSectionsToRender().map((section) => section.id);
      formData.append('sections', sectionsToRender);
      formData.append('sections_url', window.location.pathname);
      cart.setActiveElement(document.activeElement);
    } catch (e) {
      console.log('Cart sections error (non-critical):', e);
    }
  }

  // Use AJAX instead of form submission to avoid redirect
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: formData
  })
  .then(response => response.json())
  .then(response => {
    console.log('Cart add response:', response);

    if (response.status) {
      throw new Error(response.description || 'Error adding to cart');
    }

    // Show success
    button.innerHTML = '<span>Added!</span>';

    if (!cart) {
      // No cart drawer, redirect to cart page
      window.location = '/cart';
      return;
    }

    // Use the exact same method as your working product-form.js
    // Remove empty class before rendering
    if (cart.classList.contains('is-empty')) {
      cart.classList.remove('is-empty');
    }

    // This is the key - use renderContents exactly like your working theme
    cart.renderContents(response);

    // Reset button after delay
    setTimeout(() => {
      button.innerHTML = originalContent;
      button.disabled = false;
    }, 1500);
  })
  .catch(error => {
    console.error('Error adding to cart:', error);
    button.innerHTML = originalContent;
    button.disabled = false;
    alert('Error adding to cart: ' + error.message);
  });
}

//PICKUP/DELIVERY CARDS

function updateDeliveryOption(input) {
  // Remove selected class from all cards
  document.querySelectorAll('.delivery-option-card').forEach(card => {
    card.classList.remove('selected');
  });
  
  // Add selected class to the parent label
  input.closest('.delivery-option-card').classList.add('selected');
  
  // Show/hide relevant info
  const shippingInfo = document.querySelector('.shipping-info');
  const pickupInfo = document.querySelector('.pickup-info');
  
  if (input.value === 'pickup') {
    shippingInfo.style.display = 'none';
    pickupInfo.style.display = 'GRID';
  } else {
    shippingInfo.style.display = 'block';
    pickupInfo.style.display = 'none';
  }
}


