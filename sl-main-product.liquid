}
.dT_VProdWishList .add-wishlist:hover { border-color: #7f9f6f; background: #f0f5ec; }
.dT_VProdWishList .add-wishlist.adding, .dT_VProdWishList .add-wishlist.removing { opacity: 0.6; pointer-events: none; }
.dT_VProdWishList .add-wishlist.added { background: #7f9f6f; border-color: #7f9f6f; color: white; }
.dT_VProdWishList .add-wishlist.added span.wishlist-icon-empty { display: none !important; }
.dT_VProdWishList .add-wishlist.added span.wishlist-icon-filled { display: inline !important; }
.dT_VProdWishList .add-wishlist:not(.added) span.wishlist-icon-filled { display: none; }
.dT_VProdWishList .add-wishlist:not(.added) span.wishlist-icon-empty { display: inline; }
@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }

{% if section.settings.enable_sticky_bar %}
/* ====================  STICKY ADD-TO-CART BAR (mobile only)  ==================== */
.sl-sticky-atc { display: none; }
@media (max-width: 989px) {
  .sl-sticky-atc {
    display: block;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 999;
    background: {{ section.settings.sticky_bar_bg | default: '#fff' }};
    border-top: 1px solid rgba(0,0,0,.1);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 10px 16px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  }
  .sl-sticky-atc.is-visible { transform: translateY(0); }

  .sl-sticky-atc__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: center;
  }

  /* Quantity in sticky bar */
  .sl-sticky-atc .quantity {
    display: flex;
    align-items: center;
    border: 1.5px solid #d4d4d4;
    border-radius: 8px;
    height: 46px;
  }
  .sl-sticky-atc .quantity__button {
    width: 38px; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: transparent; border: none; cursor: pointer;
    font-size: 16px; color: #333;
  }
  .sl-sticky-atc .quantity__input {
    width: 32px; text-align: center;
    border: none; background: transparent;
    font-size: 15px; font-weight: 600;
    -moz-appearance: textfield;
  }
  .sl-sticky-atc .quantity__input::-webkit-outer-spin-button,
  .sl-sticky-atc .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* ATC button in sticky bar */
  .sl-sticky-atc__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 24px;
    border: none;
    border-radius: 8px;
    background: {{ section.settings.sticky_btn_bg | default: '#7f9f6f' }};
    color: {{ section.settings.sticky_btn_color | default: '#fff' }};
    font-size: 14px;
    font-weight: 100;
    font-family: var(--font-body-family);
    letter-spacing: 0.02em;
    text-transform: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .sl-sticky-atc__btn:hover { background: #6d8d5d; }
  .sl-sticky-atc__btn[disabled] { opacity: .6; cursor: not-allowed; }
}
{% endif %}

/* ====================  HIGHLIGHTS  ==================== */
.from-main-product .icon-text__row, .from-main-product .icon_text { display: flex; gap: 10px; flex-wrap: wrap; }
.from-main-product .icon-text__item, .from-main-product .icon_text .icon_wrap {
  display: flex; align-items: center; gap: 8px;
  background: #f5f7f3; border: 1px solid #e4eadf; padding: 8px 12px; border-radius: 999px; font-size: 14px;
}

/* ====================  ACCORDIONS — SL +/− toggle  ==================== */
.main-product-template .product__accordion { margin-top: 0; }
.main-product-template .product__accordion .dt-details > summary {
  display: flex; align-items: center; justify-content: space-between;
  border-radius: 0; border-top: none; border-bottom: 1px solid rgba(0,0,0,.1);
  padding: 16px 0; background: transparent; cursor: pointer; list-style: none;
}
.main-product-template .product__accordion .dt-details > summary::-webkit-details-marker { display: none; }
.main-product-template .product__accordion .dt-details > summary .accordion__title {
  font-size: 16px; font-weight: 500; color: #8C9B6D;
  font-family: var(--font-body-family); margin: 0; letter-spacing: normal;
}
.main-product-template .product__accordion .dt-details > summary .icon-caret { display: none; }
.main-product-template .product__accordion .dt-details > summary .sl-accordion-icon {
  font-size: 20px; font-weight: 300; color: #8C9B6D; line-height: 1;
  width: 24px; text-align: center; flex-shrink: 0;
}
.main-product-template .product__accordion .dt-details[open] > summary .sl-accordion-icon .sl-icon-plus { display: none; }
.main-product-template .product__accordion .dt-details:not([open]) > summary .sl-accordion-icon .sl-icon-minus { display: none; }
.main-product-template .product__accordion .dt-details[open] > summary { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.main-product-template .product__accordion .accordion__content {
  background: transparent; border-bottom: none; padding: 12px 0 20px;
  font-size: 14px; line-height: 1.6; color: #333;
}

/* ====================  TABS STYLING  ==================== */
.main-product-template .product__info-as-bottom-tabs {
  margin-top: 24px;
}
.main-product-template .product__info-as-bottom-tabs .tabs {
  display: flex;
  gap: 0;
  border-bottom: 1px solid rgba(0,0,0,.15);
  margin-bottom: 0;
}
.main-product-template .product__info-as-bottom-tabs .tablinks {
  padding: 12px 20px;
  cursor: pointer;
  border: none;
  border-bottom: 2px solid transparent;
  background: transparent;
  margin-bottom: -1px;
  transition: border-color 0.2s ease, color 0.2s ease;
}
.main-product-template .product__info-as-bottom-tabs .tablinks .accordion__title {
  font-size: 14px;
  font-weight: 500;
  color: #666;
  font-family: var(--font-body-family);
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  transition: color 0.2s ease;
}
.main-product-template .product__info-as-bottom-tabs .tablinks:hover .accordion__title,
.main-product-template .product__info-as-bottom-tabs .tablinks.active .accordion__title {
  color: #8C9B6D;
}
.main-product-template .product__info-as-bottom-tabs .tablinks.active {
  border-bottom-color: #8C9B6D;
}
.main-product-template .product__info-as-bottom-tabs .dt-sc-tabs-content {
  padding: 16px 0;
  font-size: 14px;
  line-height: 1.6;
  color: #333;
}

/* Hide slick arrows */
button.slick-prev.slick-arrow, button.slick-next.slick-arrow { display: none !important; }

/* --- Hide Mangomint chat --- */
.mangomint-chat-container { display: none !important; }

/* ====================  DELIVERY OPTIONS  ==================== */
.delivery-options-section { margin: 20px 0; font-family: inherit; }
.delivery-options-title { font-size: 16px; font-weight: 500; margin-bottom: 12px; color: #1a1a1a; }
.delivery-options-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 10px;
}
.delivery-option-card {
  position: relative;
  display: block;
  padding: 16px;
  border: 2px solid #e0e0e0;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  background: white;
  min-height: 80px;
}
.delivery-option-card input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.delivery-option-card.selected {
  background: #f0f5ec;
  border-color: #7f9f6f;
}
.delivery-option-card:hover:not(.disabled) {
  border-color: #7f9f6f;
}
.delivery-option-card.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.option-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 8px;
}
.delivery-icon, .pickup-icon {
  width: 24px;
  height: 24px;
}
.option-text {
  font-size: 14px;
  line-height: 1.3;
  color: #1a1a1a;
  font-weight: 450;
}
.shipping-info, .pickup-info {
  font-size: 13px;
  color: #666;
  margin-top: 8px;
}
.pickup-ready-time {
  margin-bottom: 4px;
}
.pickup-location {
  font-size: 12px;
  line-height: 1.4;
}
.pickup-location p {
  grid-column: 2;
}
@media (max-width: 480px) {
  .delivery-options-container {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   PRODUCT HIGHLIGHTS
   ========================================================= */
.product-highlights-block {
  margin: 25px 0;
}
.highlights-heading {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 15px;
  font-family: 'Nunito Sans';
  color: #1a1a1a;
  letter-spacing: -0.02em;
}
.highlights-pills-container {
  display: flex;
  flex-wrap: wrap;
  row-gap: 0;
  column-gap: 12px;
}
.highlight-pill {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px 10px 10px;
  border-radius: 30px;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}
.pill-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #c8e6c9 0%, #a5d6a7 100%);
  border-radius: 50%;
  display: flex;
  align-items: end;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.pill-text {
  font-size: 15px;
  font-weight: 500;
  color: #1a1a1a;
  letter-spacing: 0.01em;
}
@media (max-width: 640px) {
  .highlights-heading { font-size: 1.5rem; }
  .highlights-pills-container { gap: 8px; }
  .highlight-pill { padding: 8px 14px 8px 8px; }
  .pill-icon { width: 32px; height: 32px; font-size: 16px; }
  .pill-text { font-size: 14px; }
}

/* Zoom (if enabled) */
{% if section.settings.enable_product_zoom != "default" %}
#ex1 { overflow: hidden !important; z-index: 9; cursor: zoom-in; }
{% endif %}

/* =========================================================
   SL NOTABLE TAGS — olive green checkmark badges
   ========================================================= */
.sl-pdp-notable-tags {
  display: flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 12px;
}
.sl-pdp-notable-tag {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 13px; font-weight: 500; color: #8C9B6D;
}

/* =========================================================
   SL RATING STARS — olive green
   ========================================================= */
.main-product-template .rating { display: flex; align-items: center; gap: 4px; margin-bottom: 4px; }
.main-product-template .rating-star { --star-foreground: #8C9B6D; --star-background: #ddd; color: #8C9B6D; }
.main-product-template .rating-text { color: #8C9B6D; }
.main-product-template .rating-count { font-size: 13px; color: #888; }
.sl-pdp-rating { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
.sl-pdp-rating__stars { font-size: 16px; letter-spacing: 1px; color: #8C9B6D; }
.sl-pdp-rating__count { font-size: 13px; color: #888; }

/* =========================================================
   SL GENERIC QUANTITY INPUT
   ========================================================= */
.main-product-template .product-form__input.product-form__quantity { margin-bottom: 0; }
.main-product-template .product-form__input.product-form__quantity .form__label { display: none; }
.main-product-template quantity-input.quantity {
  display: inline-flex; align-items: center; border: 1px solid #ddd;
  border-radius: 8px; overflow: hidden; height: 48px; width:auto;
}
.main-product-template .quantity__button {
  width: 40px; height: 100%; background: transparent; border: none;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  border-radius: 0 !important;
}
.main-product-template .quantity__input {
  width: 40px; text-align: center; border: none !important;
  font-size: 15px; font-weight: 200;
}


