<script src="{{ 'slick.min.js' | asset_url }}" async></script>
{% if section.settings.enable_product_zoom == 'zoom' %}
  <script src="{{ 'jquery.zoom.min.js' | asset_url }}" defer></script>
{% elsif section.settings.enable_product_zoom == 'outer' or section.settings.enable_product_zoom == 'cloud' %}
  <script src="{{ 'jquery.ez-plus.js' | asset_url }}" defer></script>
{% endif %}

<section id="MainProduct-{{ section.id }}" class="main-product-template">
  <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}section-{{ section.id }}-padding isolate">
    <div class="row {% for block in section.blocks %}{% case block.type %}{% when 'fbt' %} fbt_hide_primary_cart_btn{% endcase %}{% endfor %}">
      {{ 'slick.min.css' | asset_url | stylesheet_tag }}
      {{ 'sticky-cart.css' | asset_url | stylesheet_tag }}
      {{ 'custom.css' | asset_url | stylesheet_tag }}
      {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
      {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}
      {{ 'component-rte.css' | asset_url | stylesheet_tag }}
      {{ 'component-slider.css' | asset_url | stylesheet_tag }}
      {{ 'component-rating.css' | asset_url | stylesheet_tag }}
      {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
      {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
      {{ 'product-detail-page.css' | asset_url | stylesheet_tag }}
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
{%- style -%}
/* ====================  MAIN PRODUCT STYLES  ==================== */

{%- assign _br = section.settings.image_border_radius | default: 0 -%}
{%- assign _bw = section.settings.image_border_width | default: 0 -%}
{%- assign _bc = section.settings.image_border_color | default: 'transparent' -%}
{%- assign _gl = section.settings.gallery_layout -%}
{%- assign _sp = section.settings.slider_position -%}
{%- assign _ms = section.settings.media_size -%}
{%- assign _ml = section.settings.mobile_layout | default: 'carousel' -%}

/* --- Resets --- */
.main-product-template * { box-sizing: border-box; }
.main-product-template img { max-width: 100%; height: auto; display: block; }
.main-product-template ul { list-style: none; margin: 0; padding: 0; }
.main-product-template { overflow-x: hidden; }

/* --- Section padding --- */
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}
@media (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* ====================  LAYOUT GRID  ==================== */
.main-product-template .facets-vertical {
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
  display: block;
}
.row { margin-top: 5%; }

.main-product-template .main-product_info.product {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  align-items: start;
  width: 100%;
}
@media (min-width: 990px) {
  .main-product-template .main-product_info.product {
    {% if _ms == 'small' %}grid-template-columns: 40% 1fr !important;
    {% elsif _ms == 'medium' %}grid-template-columns: 52% 1fr !important;
    {% else %}grid-template-columns: 60% 1fr !important;  /* large */
    {% endif %}
    column-gap: 48px;
    row-gap: 0;
    justify-content: center;
  }
}

.main-product-template .product__media-wrapper { grid-column: 1; max-width: 100%; overflow: hidden; }
.main-product-template .product__info-wrapper  { grid-column: 1; max-width: 100%; position: relative; z-index: 0; padding-top: 0 !important; }
@media (min-width: 990px) {
  .main-product-template .product__info-wrapper { grid-column: 2; }
  .main-product-template .product__media-wrapper { position: sticky; top: 110px; z-index: 1; }
}
.grid--2-col-tablet .grid__item { width: 100%; }

/* ====================  PRODUCT IMAGE  ==================== */
.main-product-template .product__media-gallery { width: 100%; }

.main-product-template .product__media-item {
  background: transparent;
  border-radius: {{ _br }}px;
  border: {{ _bw }}px solid {{ _bc }};
  overflow: hidden;
  position: relative;
}
.main-product-template .product__media-item {
  {% if section.settings.image_aspect_ratio == 'natural' %}aspect-ratio: auto;{% else %}aspect-ratio: {{ section.settings.image_aspect_ratio | default: '1 / 1' }};{% endif %}
}
/* Override theme external CSS (section-main-product.css) */
.main-product-template .product__media-item::before,
.main-product-template .product__media-item::after {
  content: none !important;
  display: none !important;
}
.main-product-template .thumbnail.global-media-settings img {
  padding: 0 !important;
}
.main-product-template .product__modal-opener,
.main-product-template .product__media-item .modal-opener {
  border: none !important;
  border-radius: {{ _br }}px !important;
  background: transparent !important;
  width: 100%;
  height: 100%;
  display: block;
}
.main-product-template .product__media-item img,
.main-product-template .product__media-item .product-media-container {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit | default: 'cover' }};
  object-position: center center;
}
/* Ensure all containers between media-item and img fill the space for cover to work */
.main-product-template .product__media-item modal-opener,
.main-product-template .product__media-item .product__modal-opener,
.main-product-template .product__media-item .product__media-toggle {
  display: block;
  width: 100%;
  height: 100%;
}
/* Kill .media's own padding-bottom aspect ratio so it fills the parent container instead */
{% if section.settings.image_aspect_ratio != 'natural' %}
.main-product-template .product__media-item .media {
  padding-bottom: 0 !important;
  height: 100%;
  display: contents;
}
{% endif %}

/* Contain slides */
.main-product-template .product__media-list.grid--peek { margin: 0 !important; }
.main-product-template .grid--peek.slider--mobile .grid__item { box-sizing: border-box !important; }

{% if _ml == 'carousel' %}
/* ====================  MOBILE CAROUSEL  ==================== */
@media (max-width: 989px) {
  /* Carousel: each slide ~82%, next peeks from right */
  .main-product-template .product__media-list {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 !important;
    margin: 0 !important;
  }
  .main-product-template .product__media-list .slider__slide {
    flex: 0 0 82% !important;
    width: 82% !important;
    min-width: 82% !important;
    max-width: 82% !important;
    scroll-snap-align: center;
    padding: 0 !important;
    margin: 0 !important;
  }
  .main-product-template .product__media-list .slider__slide:first-child { margin-left: 4% !important; }
  .main-product-template .product__media-list .slider__slide:last-child  { margin-right: 4% !important; }
  /* Override base.css grid--peek margins */
  .main-product-template .grid--peek.slider .grid__item:first-of-type { margin-left: 4% !important; }
  .main-product-template .grid--peek.slider .grid__item:last-of-type  { margin-right: 4% !important; }
  .main-product-template .grid--peek .grid__item { min-width: 0 !important; }

  /* Hide thumbnails completely in carousel mode */
  .main-product-template .thumbnail-slider,
  .main-product-template .thumbnail-slider.slider-vertical { display: none !important; }

  /* Arrow buttons */
  .main-product-template .product__media-wrapper { position: relative; }
  .main-product-template .slider-buttons {
    display: flex !important;
    position: absolute;
    top: 50%;
    left: 0; right: 0;
    transform: translateY(-50%);
    justify-content: space-between;
    padding: 0 6px;
    pointer-events: none;
    z-index: 5;
  }
  .main-product-template .slider-buttons .slider-counter { display: none !important; }
  .main-product-template .slider-button {
    pointer-events: all;
    width: 40px !important; height: 40px !important;
    min-width: 40px !important; min-height: 40px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.7) !important;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
    transition: background 0.2s ease;
    padding: 0 !important;
    overflow: visible !important;
  }
  .main-product-template .slider-button:hover { background: rgba(255, 255, 255, 0.95) !important; }
  .main-product-template .slider-button svg,
  .main-product-template .slider-button .icon-caret {
    width: 16px !important; height: 16px !important;
    min-width: 16px !important; min-height: 16px !important;
    color: #333;
    display: block !important;
  }

  /* Single image: stretch to full width, hide arrows */
  .main-product-template .product__media-list .slider__slide:only-child {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  .main-product-template .product__media-list .slider__slide:only-child ~ .slider-buttons,
  .main-product-template .product__media-list:has(.slider__slide:only-child) + .slider-buttons {
    display: none !important;
  }
}
/* Desktop: full-width slides, no carousel peek */
@media (min-width: 990px) {
  .main-product-template .product__media-list { padding: 0 !important; margin: 0 !important; }
  .main-product-template .product__media-list .slider__slide {
    width: 100% !important; min-width: 100% !important;
    padding: 0 !important; margin: 0 !important;
  }
}
{% else %}
/* ====================  MOBILE THUMBNAILS  ==================== */
/* Full-width slides, no peek, no arrows — still swipeable */
.main-product-template .product__media-list {
  padding: 0 !important; margin: 0 !important;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}
/* Kill ALL peek sizing — force every slide to 100% */
.main-product-template .product__media-list .slider__slide,
.main-product-template .grid--peek .grid__item,
.main-product-template .grid--peek.slider .grid__item,
.main-product-template .grid--peek.slider--mobile .grid__item,
.main-product-template .slider--mobile.grid--peek .grid__item,
.main-product-template .grid--peek.grid--1-col-tablet-down .grid__item,
.main-product-template .slider--mobile.grid--peek.grid--1-col-tablet-down .grid__item {
  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;
  flex: 0 0 100% !important;
  padding: 0 !important;
  margin: 0 !important;
  scroll-snap-align: start;
  box-sizing: border-box !important;
}
/* Kill peek margins on first/last */
.main-product-template .grid--peek.slider .grid__item:first-of-type,
.main-product-template .grid--peek.slider .grid__item:last-of-type,
.main-product-template .grid--peek.slider--mobile .grid__item:first-of-type,
.main-product-template .grid--peek.slider--mobile .grid__item:last-of-type {
  margin-left: 0 !important;
  margin-right: 0 !important;
}
/* Hide arrows completely */
.main-product-template .slider-buttons { display: none !important; }
{% endif %}

{% if _gl == 'stacked' %}
/* Stacked: all images visible, no thumbnails */
.main-product-template .product__media-list { display: flex; flex-direction: column; gap: 12px; }
.main-product-template .product__media-list .product__media-item { width: 100%; }
{% if section.settings.stacked_column_alignment == 'two' %}
@media (min-width: 750px) {
  .main-product-template .product__media-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
}
{% endif %}
.main-product-template .thumbnail-slider,
.main-product-template .thumbnail-slider.slider-vertical { display: none !important; }
{% endif %}

/* ====================  THUMBNAILS  ==================== */
{% unless _gl == 'stacked' %}

/* Shared: force theme slider into our layout */
.main-product-template .thumbnail-slider,
.main-product-template .thumbnail-slider.slider-vertical {
  display: block !important;
  position: relative !important;
  height: auto !important;
}
.main-product-template .thumbnail-slider .slider-button { display: none !important; }

{% if _sp == 'left' or _sp == 'right' %}
/* Side thumbnails ({{ _sp }}) */
.main-product-template .product__media-gallery {
  display: flex !important;
  flex-direction: row !important;
  gap: 12px;
}
/* Main image takes remaining space */
.main-product-template .product__media-gallery > slider-component:first-of-type,
.main-product-template .product__media-gallery > .slider-mobile-gutter {
  flex: 1 1 auto !important;
  min-width: 0;
  order: 1;
}
/* Thumbnail strip fixed width on the side */
.main-product-template .thumbnail-slider,
.main-product-template .thumbnail-slider.slider-vertical {
  width: 89px !important;
  flex: 0 0 90px !important;
  align-self: stretch !important;
  margin: 0;
  {% if _sp == 'right' %}order: 2;{% else %}order: 0;{% endif %}
}
.main-product-template .thumbnail-slider .thumbnail-list,
.main-product-template .thumbnail-slider .thumbnail-list.slider {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-end !important;
  gap: 8px;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  width: 100% !important;
  height: 100% !important;
  max-height: 600px;
  padding: 0 !important;
}
@media (max-width: 989px) {
  .main-product-template .product__media-gallery { flex-direction: column !important; }
  .main-product-template .product__media-gallery > slider-component:first-of-type,
  .main-product-template .product__media-gallery > .slider-mobile-gutter { order: 0; }
  .main-product-template .thumbnail-slider,
  .main-product-template .thumbnail-slider.slider-vertical { width: 100% !important; flex: 0 0 auto !important; margin-top: 8px; order: 1; }
  .main-product-template .thumbnail-slider .thumbnail-list,
  .main-product-template .thumbnail-slider .thumbnail-list.slider {
    flex-direction: row !important; justify-content: flex-start !important;
    gap: 8px; overflow-x: auto !important; overflow-y: hidden !important; max-height: none; padding: 0 !important;
  }
}
{% else %}
/* Bottom thumbnails */
.main-product-template .thumbnail-slider,
.main-product-template .thumbnail-slider.slider-vertical {
  width: 100% !important;
  margin-top: 14px;
}
.main-product-template .thumbnail-slider .thumbnail-list,
.main-product-template .thumbnail-slider .thumbnail-list.slider {
  display: flex !important;
  flex-direction: row !important;
  justify-content: flex-start !important;
  gap: 8px;
  overflow-x: auto !important;
  overflow-y: hidden !important;
  width: 100% !important;
  height: auto !important;
  min-height: 94px;
  scroll-snap-type: x proximity;
  padding: 0 !important;
}
{% endif %}

/* Thumbnail items */
.main-product-template .thumbnail-list__item { flex: 0 0 auto !important; }
/* Kill ::before spacer on thumbnail list items */
.main-product-template .thumbnail-list__item::before {
  content: none !important;
  display: none !important;
  padding: 0 !important;
}
.main-product-template .thumbnail-list__item .thumbnail {
  display: block !important;
  width: 90px !important;
  height: 90px !important;
  border-radius: {{ _br }}px;
  overflow: hidden !important;
  background: transparent;
  border: {{ _bw }}px solid {{ _bc }};
  padding: 0 !important;
  position: relative !important;
}
/* Kill theme's ::before padding on thumbnails */
.main-product-template .thumbnail-list__item .thumbnail::before,
.main-product-template .thumbnail-list__item .thumbnail::after {
  content: none !important;
  display: none !important;
  padding: 0 !important;
}
.main-product-template .thumbnail-list__item .thumbnail img {
  position: absolute !important;
  top: 0; left: 0;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
}
@media (max-width: 989px) {
  .main-product-template .thumbnail-list__item .thumbnail { width: 80px !important; height: 80px !important; }
}
.main-product-template .thumbnail-list__item[aria-current="true"] .thumbnail,
.main-product-template .thumbnail-list__item.is-active .thumbnail {
  outline: 2px solid var(--color-foreground, #222);
  outline-offset: 0;
}

{% if _ml == 'carousel' %}
/* Carousel mode: ensure thumbnails stay hidden on mobile (overrides display:block above) */
@media (max-width: 989px) {
  .main-product-template .thumbnail-slider,
  .main-product-template .thumbnail-slider.slider-vertical { display: none !important; }
}
{% endif %}

{% endunless %}

/* ====================  BREADCRUMBS & TITLE  ==================== */
.sl-pdp-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 13px; font-family: var(--font-body-family); margin-bottom: 8px; }
.sl-pdp-breadcrumb a, .sl-pdp-breadcrumb a:link, .sl-pdp-breadcrumb a:visited { color: #888; text-decoration: none; }
.sl-pdp-breadcrumb a:hover { color: #555; }
.sl-pdp-breadcrumb__sep { color: #bbb; }

/* Title row: [title] ........... [heart] [badge] */
.sl-pdp-title-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 8px;
  align-items: center;
}
.sl-pdp-title-row .product__title { min-width: 0; }

/* Heart icon next to title */
.sl-pdp-heart-btn {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px;
  border: none; background: transparent;
  cursor: pointer; color: #555; padding: 0;
  transition: color 0.2s;
}
.sl-pdp-heart-btn:hover { color: #c44; }
.sl-pdp-heart-btn svg { width: 22px; height: 22px; }
.sl-pdp-heart-btn.is-wishlisted { color: #c44; }
.sl-pdp-heart-btn.is-wishlisted svg { fill: #c44; stroke: #c44; }
/* Also handle when dtx-wishlist wrapper receives the active class */
dtx-wishlist.is-wishlisted .sl-pdp-heart-btn { color: #c44; }
dtx-wishlist.is-wishlisted .sl-pdp-heart-btn svg { fill: #c44; stroke: #c44; }

/* Priority badge (sale > new > editor's pick) */
.sl-pdp-badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
  text-transform: lowercase;
  white-space: nowrap; font-family: var(--font-body-family);
}
.sl-pdp-badge--sale  { background: #f8e4e4; color: #b44; }
.sl-pdp-badge--new   { background: #f3eef8; color: #555; }
.sl-pdp-badge--pick  { background: #eef3ea; color: #6b7f5a; }
.sl-pdp-subtitle { font-size: 14px; color: #666; margin: 0 0 6px; font-family: var(--font-body-family); }
.notable-tags { display: flex; gap: 16px; color: #8C9B6D; font-size: 14px; margin-bottom: 4px; }
.notable-tags p { margin: 0; }

/* ====================  TYPOGRAPHY  ==================== */
.main-product-template .product__title { max-width: 42ch; }
.main-product-template .product__title h1,
.main-product-template .product__title .h1 {
  font-size: clamp(26px, 2.4vw + 8px, 38px);
  line-height: 1.15; margin: 0 0 10px 0; font-weight: 600;
  letter-spacing: normal !important; text-transform: none !important;
  writing-mode: horizontal-tb !important; word-break: normal; hyphens: auto;
}
.main-product-template .product__info-container { max-width: 520px; }
.main-product-template #price-{{ section.id }} .price--large { line-height: 1.15; }
.main-product-template .installment.caption-large { margin-top: 6px; opacity: .85; }
.main-product-template .product-attributes .product-label,
.main-product-template .product__text.subtitle { opacity: .8; }

/* ====================  VARIANT PICKER  ==================== */
.product-form__input.js { margin: 0 0 14px; }
.product-form__input.js legend.form__label { margin-bottom: 8px; }
.product-form__input.js label:not(.swatch-variant-image):not(.swatch-variant-color) {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 38px; padding: 0 14px; border-radius: 999px;
  border: 1px solid black; margin: 6px 8px 6px 0;
  cursor: pointer; background: #fff; transition: all .2s ease; color: black;
}
.product-form__input.js input[type=radio]:checked + label {
  border-color: #0a7a2a; box-shadow: 0 0 0 3px rgba(10,122,42,.12) inset; background-color: black;
}

/* ====================  INVENTORY  ==================== */
.inventory-form__label label.form__label { display: block; margin-bottom: 6px; }
.inventory-form__label p {
  display: flex; align-items: center; gap: 8px;
  background-color: #faf4ee; color: #1b1b1b;
  border: 1px solid #F3F0F8; border-radius: 8px; padding: 8px 10px; margin: 6px 0 12px; font-size: 14px;
}

/* ====================  DELIVERY / PICKUP  ==================== */
.main-product-template .product__pickup-availabilities,
.main-product-template .html-sections-product { margin-top: 8px; }
.main-product-template .product__pickup-availabilities .pickup-availability-preview,
.main-product-template .html-sections-product p {
  display: flex; align-items: center; gap: 10px;
  background: #eef3ea; border: 1px solid #e0eadb; border-radius: 12px; padding: 14px 16px; font-size: 14px;
}
.quantity__button { border-radius: 0 !important; }
.quantity__input { border: 0 !important; }
.pickup-info { margin-top: 12px; }
.pickup-info > *:nth-child(2) { grid-column: 2; }
.pickup-info > *:nth-child(2):before { content: "Pickup at: "; font-weight: 600; }
.pickup-details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 12px 0; }
.pickup-time, .pickup-location { font-size: 13px; color: #666; }
.pickup-label { margin: 0 0 4px 0; font-weight: 450; }
.pickup-address { margin: 0; line-height: 1.4; font-size: 12px; color: #666; }
@media (max-width: 480px) { .pickup-details-grid { grid-template-columns: 1fr; gap: 12px; } }

/* ====================  QUANTITY + ADD TO CART GRID  ==================== */
/* Side-by-side: quantity | ATC button */
.main-product-template .product-form__input.product-form__quantity {
  margin-bottom: 0 !important;
}
.main-product-template .product-form__input.product-form__quantity .form__label { display: none; }
.main-product-template .sl-qty-atc-row {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;
  align-items: stretch;
}
.main-product-template .sl-qty-atc-row .quantity {
  min-height: 52px;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 0;
  background: #fff;
  box-shadow: none !important;
}
.main-product-template .sl-qty-atc-row .quantity__button {
  width: 44px; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: transparent; border: none !important; cursor: pointer;
  font-size: 18px; color: #333;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.main-product-template .sl-qty-atc-row .quantity__input {
  width: 40px; text-align: center;
  border: none !important; background: transparent;
  font-size: 16px; font-weight: 200;
