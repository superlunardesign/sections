  box-shadow: none !important;
}
.main-product-template .sl-qty-atc-row .quantity__input::-webkit-outer-spin-button,
.main-product-template .sl-qty-atc-row .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
/* Kill ALL inherited shadows on qty + ATC */
.main-product-template .sl-qty-atc-row *,
.main-product-template .sl-qty-atc-row *::before,
.main-product-template .sl-qty-atc-row *::after {
  box-shadow: none !important;
}
/* ====================  ADD TO CART + WISHLIST  ==================== */
.main-product-template .product-form__buttons { display: grid; gap: 10px; grid-template-columns: 1fr; }
.main-product-template .product-form__submit {


  min-height: 52px; 
  font-size: 15px;
  font-family: var(--font-body-family);
  font-weight: 200;
  letter-spacing: .02em; 


}

.main-product-template .product-form__submit::before,
.main-product-template .product-form__submit::after,
.main-product-template .add-to-cart-btn::before,
.main-product-template .add-to-cart-btn::after {
  box-shadow: none !important;
  display: none !important;
}
.main-product-template .product-form__submit[disabled] { opacity: .6; }
.dT_VProdWishList .add-wishlist {
