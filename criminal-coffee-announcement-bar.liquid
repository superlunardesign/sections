{%- if section.settings.show_announcement_bar -%}
  <div class="criminal-announcement-bar" style="
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_vertical }}px 0;
    text-align: center;
    font-size: {{ section.settings.font_size }}px;
  ">
    <div class="page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" style="
          color: {{ section.settings.text_color }};
          text-decoration: none;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
        ">
          <span>{{ section.settings.text }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Criminal Announcement Bar",
  "class": "criminal-announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement_bar",
      "default": true,
      "label": "Show announcement bar"
    },
    {
      "type": "text",
      "id": "text",
      "default": "BUNDLE ANY 3+ COFFEES & SAVE 10%",
      "label": "Announcement text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#722F37",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "Font size"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10,
      "label": "Vertical padding"
    }
  ],
  "presets": [
    {
      "name": "Criminal Announcement Bar"
    }
  ]
}
{% endschema %}
