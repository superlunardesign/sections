{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- Criminal Coffee Footer -->
<footer id="CriminalFooter-{{ section.id }}" class="criminal-footer">
  <div class="footer-container">
    <!-- Main Footer Content -->
    <div class="footer-main">
      <!-- Newsletter Column -->
      <div class="footer-column footer-column--newsletter">
        {% if section.settings.newsletter_enable %}
          {% if section.settings.newsletter_heading != blank %}
            <h3 class="footer-column__heading">{{ section.settings.newsletter_heading }}</h3>
          {% endif %}
          {%- form 'customer', id: 'FooterNewsletter', class: 'footer-newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer-newsletter__field">
              <input
                id="NewsletterEmail--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="footer-newsletter__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="FooterNewsletter-error"
                {% endif %}
              >
              <button type="submit" class="footer-newsletter__button" aria-label="Subscribe">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="footer-newsletter__error" id="FooterNewsletter-error">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer-newsletter__success">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        {% endif %}
      </div>

      <!-- Logo Column -->
      {% if section.settings.logo != blank %}
        <div class="footer-column footer-column--logo">
          <a href="{{ routes.root_url }}" class="footer-logo">
            <img
              src="{{ section.settings.logo | image_url: width: 400 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              loading="lazy"
              class="footer-logo__image"
            >
          </a>
        </div>
      {% endif %}

      <!-- Menu Columns from Blocks -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="footer-column footer-column--menu" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="footer-menu">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer-menu__item">
                      <a href="{{ link.url }}" class="footer-menu__link{% if link.active %} footer-menu__link--active{% endif %}">
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {% endif %}
            </div>

          {%- when 'text' -%}
            <div class="footer-column footer-column--text" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-text-content">
                {{ block.settings.subtext }}
              </div>
            </div>

          {%- when 'contact' -%}
            <div class="footer-column footer-column--contact" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-contact">
                {% if block.settings.email != blank %}
                  <a href="mailto:{{ block.settings.email }}" class="footer-contact__link">
                    {{ block.settings.email }}
                  </a>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" class="footer-contact__link">
                    {{ block.settings.phone }}
                  </a>
                {% endif %}
                {% if block.settings.address != blank %}
                  <p class="footer-contact__address">
                    {{ block.settings.address }}
                  </p>
                {% endif %}
              </div>
            </div>

          {%- when 'image' -%}
            <div class="footer-column footer-column--image" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  class="footer-column__image"
                  style="max-width: {{ block.settings.image_width2 }}px;"
                >
              {% endif %}
            </div>

          {%- when 'liquid' -%}
            <div class="footer-column footer-column--custom" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-custom-content">
                {{ block.settings.liquid }}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      {% if section.settings.payment_enable %}
        <div class="footer-payment">
          <ul class="footer-payment__list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="footer-payment__item">
                {{ type | payment_type_svg_tag: class: 'footer-payment__icon' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {% endif %}

      <div class="footer-bottom__row">
        <div class="footer-bottom__spacer"></div>
        <p class="footer-copyright">
          &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.
        </p>
        <div class="footer-bottom__credit">
          {% unless section.settings.hide_site_credit %}
            <p class="footer-credit">
              Site by <a href="https://superlunardesign.com" target="_blank" rel="noopener" class="footer-credit__link">Superlunar Design</a>
            </p>
          {% endunless %}
        </div>
      </div>
    </div>
  </div>
</footer>

{%- style -%}
  /* =============================================
     CRIMINAL COFFEE FOOTER - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CriminalFooter-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  #CriminalFooter-{{ section.id }} .footer-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
  }

  /* Main Footer - Flexbox Layout */
  #CriminalFooter-{{ section.id }} .footer-main {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.column_gap }}px;
    padding-bottom: {{ section.settings.section_spacing }}px;
    border-bottom: 1px solid {{ section.settings.border_color }};
    align-items: flex-start;
  }

  /* Footer Columns */
  #CriminalFooter-{{ section.id }} .footer-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 120px;
  }

  /* Newsletter Column - Fixed Width */
  #CriminalFooter-{{ section.id }} .footer-column--newsletter {
    flex: 0 0 auto;
    width: 220px;
    max-width: 100%;
  }

  /* Logo Column */
  #CriminalFooter-{{ section.id }} .footer-column--logo {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  #CriminalFooter-{{ section.id }} .footer-column__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
  }

  /* Logo */
  #CriminalFooter-{{ section.id }} .footer-logo {
    display: block;
    text-decoration: none;
  }

  #CriminalFooter-{{ section.id }} .footer-logo__image {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  /* Newsletter */
  #CriminalFooter-{{ section.id }} .footer-newsletter__form {
    width: 100%;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__field {
    display: flex;
    border: 1px solid {{ section.settings.input_border_color }};
    background: {{ section.settings.input_background }};
    overflow: hidden;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__input {
    flex: 1;
    padding: 12px 16px;
    border: none;
    background: transparent;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    outline: none;
    min-width: 0;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__input::placeholder {
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__button {
    padding: 12px 16px;
    border: none;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    flex-shrink: 0;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__button:hover {
    opacity: 0.8;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__error {
    color: #ff4444;
    font-size: 12px;
    margin-top: 8px;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__success {
    color: #44ff44;
    font-size: 12px;
    margin-top: 8px;
  }

  /* Menu Links */
  #CriminalFooter-{{ section.id }} .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.link_spacing }}px;
  }

  #CriminalFooter-{{ section.id }} .footer-menu__link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: {{ section.settings.link_font_size }}px;
    font-weight: {{ section.settings.link_font_weight }};
    transition: color 0.2s ease;
    display: inline-block;
  }

  #CriminalFooter-{{ section.id }} .footer-menu__link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  /* Text Content */
  #CriminalFooter-{{ section.id }} .footer-text-content {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.link_font_size }}px;
    line-height: 1.6;
  }

  #CriminalFooter-{{ section.id }} .footer-text-content a {
    color: {{ section.settings.link_color }};
    text-decoration: underline;
  }

  /* Contact */
  #CriminalFooter-{{ section.id }} .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #CriminalFooter-{{ section.id }} .footer-contact__link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: {{ section.settings.link_font_size }}px;
    transition: color 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-contact__link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  #CriminalFooter-{{ section.id }} .footer-contact__address {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.link_font_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  /* Custom Liquid Column */
  #CriminalFooter-{{ section.id }} .footer-column--custom {
    min-height: 50px;
  }

  /* Footer Bottom */
  #CriminalFooter-{{ section.id }} .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: {{ section.settings.bottom_padding_top }}px;
    gap: 16px;
  }

  /* Payment Icons - Centered */
  #CriminalFooter-{{ section.id }} .footer-payment {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  #CriminalFooter-{{ section.id }} .footer-payment__list {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  #CriminalFooter-{{ section.id }} .footer-payment__icon {
    height: 24px;
    width: auto;
  }

  /* Bottom Row - Copyright + Site Credit */
  #CriminalFooter-{{ section.id }} .footer-bottom__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  #CriminalFooter-{{ section.id }} .footer-bottom__spacer {
    flex: 1;
  }

  #CriminalFooter-{{ section.id }} .footer-copyright {
    color: {{ section.settings.copyright_color }};
    font-size: {{ section.settings.copyright_font_size }}px;
    margin: 0;
    text-align: center;
  }

  #CriminalFooter-{{ section.id }} .footer-bottom__credit {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  #CriminalFooter-{{ section.id }} .footer-credit {
    color: {{ section.settings.copyright_color }};
    font-size: {{ section.settings.copyright_font_size }}px;
    margin: 0;
  }

  #CriminalFooter-{{ section.id }} .footer-credit__link {
    color: {{ section.settings.credit_link_color }};
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-credit__link:hover {
    color: {{ section.settings.link_hover_color }};
    text-decoration: underline;
  }

  /* Tablet Styles */
  @media (max-width: 990px) {
    #CriminalFooter-{{ section.id }} .footer-container {
      padding: 0 {{ section.settings.horizontal_padding_tablet }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-main {
      gap: 30px;
    }

    #CriminalFooter-{{ section.id }} .footer-column {
      flex: 1 1 calc(33.333% - 20px);
      min-width: 140px;
    }

    #CriminalFooter-{{ section.id }} .footer-column--newsletter {
      flex: 1 1 100%;
      width: 100%;
      max-width: 300px;
    }

    #CriminalFooter-{{ section.id }} .footer-column--logo {
      flex: 1 1 100%;
      justify-content: flex-start;
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CriminalFooter-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-container {
      padding: 0 {{ section.settings.horizontal_padding_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-main {
      flex-direction: column;
      gap: 32px;
      text-align: center;
    }

    #CriminalFooter-{{ section.id }} .footer-column {
      flex: 1 1 100%;
      width: 100%;
      align-items: center;
    }

    #CriminalFooter-{{ section.id }} .footer-column--newsletter {
      max-width: 100%;
    }

    #CriminalFooter-{{ section.id }} .footer-column--logo {
      justify-content: center;
    }

    #CriminalFooter-{{ section.id }} .footer-newsletter__field {
      max-width: 100%;
    }

    #CriminalFooter-{{ section.id }} .footer-menu {
      align-items: center;
    }

    #CriminalFooter-{{ section.id }} .footer-contact {
      align-items: center;
    }

    #CriminalFooter-{{ section.id }} .footer-bottom__row {
      flex-direction: column;
      gap: 12px;
    }

    #CriminalFooter-{{ section.id }} .footer-bottom__spacer {
      display: none;
    }

    #CriminalFooter-{{ section.id }} .footer-bottom__credit {
      justify-content: center;
    }

    #CriminalFooter-{{ section.id }} .footer-column__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-menu__link,
    #CriminalFooter-{{ section.id }} .footer-contact__link,
    #CriminalFooter-{{ section.id }} .footer-contact__address,
    #CriminalFooter-{{ section.id }} .footer-text-content {
      font-size: {{ section.settings.link_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Criminal Coffee Footer",
  "tag": "section",
  "class": "criminal-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "SUBSCRIBE TO OUR EMAIL LIST"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "header",
      "content": "Column Headings"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size (mobile)",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading margin bottom",
      "min": 10,
      "max": 40,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Link font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "link_font_size_mobile",
      "label": "Link font size (mobile)",
      "min": 12,
      "max": 16,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "link_font_weight",
      "label": "Link font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Space between links",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Newsletter Input"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Payment Icons"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Copyright & Site Credit"
    },
    {
      "type": "range",
      "id": "copyright_font_size",
      "label": "Copyright font size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright color",
      "default": "#888888"
    },
    {
      "type": "checkbox",
      "id": "hide_site_credit",
      "label": "Hide site credit",
      "default": false
    },
    {
      "type": "color",
      "id": "credit_link_color",
      "label": "Site credit link color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
