{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- Criminal Coffee Footer -->
<footer id="CriminalFooter-{{ section.id }}" class="criminal-footer">
  <div class="footer-container">
    <!-- Main Footer Content -->
    <div class="footer-main">
      <!-- Column 1: Logo + Newsletter -->
      <div class="footer-column footer-column--primary">
        {% if section.settings.logo != blank %}
          <div class="footer-logo">
            <a href="{{ routes.root_url }}">
              <img
                src="{{ section.settings.logo | image_url: width: 400 }}"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
                loading="lazy"
                class="footer-logo__image"
              >
            </a>
          </div>
        {% endif %}

        {% if section.settings.newsletter_enable %}
          <div class="footer-newsletter">
            {% if section.settings.newsletter_heading != blank %}
              <h3 class="footer-newsletter__heading">{{ section.settings.newsletter_heading }}</h3>
            {% endif %}
            {%- form 'customer', id: 'FooterNewsletter', class: 'footer-newsletter__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="footer-newsletter__field">
                <input
                  id="NewsletterEmail--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="footer-newsletter__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
                  required
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="FooterNewsletter-error"
                  {% endif %}
                >
                <button type="submit" class="footer-newsletter__button" aria-label="Subscribe">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              {%- if form.errors -%}
                <p class="footer-newsletter__error" id="FooterNewsletter-error">
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="footer-newsletter__success">{{ 'newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="footer-social">
            <ul class="footer-social__list">
              {%- if settings.social_instagram_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="footer-social__link" aria-label="Instagram" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="18" cy="6" r="1" fill="currentColor"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="footer-social__link" aria-label="Facebook" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18 2H15C13.6739 2 12.4021 2.52678 11.4645 3.46447C10.5268 4.40215 10 5.67392 10 7V10H7V14H10V22H14V14H17L18 10H14V7C14 6.73478 14.1054 6.48043 14.2929 6.29289C14.4804 6.10536 14.7348 6 15 6H18V2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_twitter_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="footer-social__link" aria-label="Twitter" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="footer-social__link" aria-label="TikTok" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12V3H18C18 5.20914 19.7909 7 22 7V10C19.7909 10 18 8.20914 18 6V12C18 15.3137 15.3137 18 12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6V9C10.3431 9 9 10.3431 9 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="footer-social__link" aria-label="YouTube" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22.54 6.42C22.4212 5.94541 22.1793 5.51057 21.8387 5.15941C21.498 4.80824 21.0708 4.55318 20.6 4.42C18.88 4 12 4 12 4C12 4 5.12 4 3.4 4.46C2.92925 4.59318 2.50198 4.84824 2.16135 5.19941C1.82072 5.55057 1.57879 5.98541 1.46 6.46C1.14521 8.20556 0.991235 9.97631 1 11.75C0.988687 13.537 1.14266 15.3213 1.46 17.08C1.59096 17.5398 1.83831 17.9581 2.17814 18.2945C2.51798 18.6308 2.93882 18.8738 3.4 19C5.12 19.46 12 19.46 12 19.46C12 19.46 18.88 19.46 20.6 19C21.0708 18.8668 21.498 18.6118 21.8387 18.2606C22.1793 17.9094 22.4212 17.4746 22.54 17C22.8524 15.2676 23.0063 13.5103 23 11.75C23.0113 9.96295 22.8573 8.1787 22.54 6.42Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.75 15.02L15.5 11.75L9.75 8.48V15.02Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="footer-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="footer-social__link" aria-label="Pinterest" target="_blank" rel="noopener">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.477 2 2 6.477 2 12C2 16.237 4.636 19.855 8.356 21.312C8.268 20.522 8.189 19.306 8.391 18.432C8.574 17.647 9.554 13.564 9.554 13.564C9.554 13.564 9.252 12.958 9.252 12.077C9.252 10.699 10.049 9.663 11.04 9.663C11.88 9.663 12.288 10.293 12.288 11.047C12.288 11.888 11.757 13.14 11.484 14.297C11.253 15.268 11.985 16.059 12.942 16.059C14.675 16.059 16.005 14.232 16.005 11.55C16.005 9.158 14.316 7.477 11.961 7.477C9.228 7.477 7.612 9.504 7.612 11.597C7.612 12.437 7.926 13.339 8.325 13.829C8.406 13.926 8.418 14.011 8.394 14.107C8.319 14.426 8.148 15.111 8.115 15.254C8.072 15.435 7.97 15.474 7.782 15.385C6.54 14.823 5.76 13.009 5.76 11.56C5.76 8.382 8.094 5.461 12.21 5.461C15.522 5.461 18.086 7.806 18.086 11.504C18.086 14.791 16.043 17.446 13.186 17.446C12.188 17.446 11.248 16.926 10.937 16.31L10.314 18.678C10.086 19.546 9.471 20.641 9.066 21.314C9.99 21.598 10.971 21.75 12 21.75C17.385 21.75 21.75 17.385 21.75 12C21.75 6.615 17.385 2.25 12 2.25" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {% endif %}
      </div>

      <!-- Menu Columns from Blocks -->
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="footer-column footer-column--menu" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="footer-menu">
                  {%- for link in block.settings.menu.links -%}
                    <li class="footer-menu__item">
                      <a href="{{ link.url }}" class="footer-menu__link{% if link.active %} footer-menu__link--active{% endif %}">
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {% endif %}
            </div>

          {%- when 'text' -%}
            <div class="footer-column footer-column--text" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-text-content">
                {{ block.settings.subtext }}
              </div>
            </div>

          {%- when 'contact' -%}
            <div class="footer-column footer-column--contact" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-contact">
                {% if block.settings.email != blank %}
                  <a href="mailto:{{ block.settings.email }}" class="footer-contact__link">
                    {{ block.settings.email }}
                  </a>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" class="footer-contact__link">
                    {{ block.settings.phone }}
                  </a>
                {% endif %}
                {% if block.settings.address != blank %}
                  <p class="footer-contact__address">
                    {{ block.settings.address }}
                  </p>
                {% endif %}
              </div>
            </div>

          {%- when 'image' -%}
            <div class="footer-column footer-column--image" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  class="footer-column__image"
                  style="max-width: {{ block.settings.image_width }}px;"
                >
              {% endif %}
            </div>

          {%- when 'liquid' -%}
            <div class="footer-column footer-column--custom" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="footer-column__heading">{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="footer-custom-content">
                {{ block.settings.liquid }}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom__left">
        {% if section.settings.payment_enable %}
          <div class="footer-payment">
            <ul class="footer-payment__list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="footer-payment__item">
                  {{ type | payment_type_svg_tag: class: 'footer-payment__icon' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {% endif %}
      </div>
      <div class="footer-bottom__center">
        <p class="footer-copyright">
          &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.
        </p>
      </div>
      <div class="footer-bottom__right">
        {% unless section.settings.hide_site_credit %}
          <p class="footer-credit">
            Site by <a href="https://superlunardesign.com" target="_blank" rel="noopener" class="footer-credit__link">Superlunar Design</a>
          </p>
        {% endunless %}
      </div>
    </div>
  </div>
</footer>

{%- style -%}
  /* =============================================
     CRIMINAL COFFEE FOOTER - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CriminalFooter-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
  }

  #CriminalFooter-{{ section.id }} .footer-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
  }

  /* Main Footer Grid */
  #CriminalFooter-{{ section.id }} .footer-main {
    display: grid;
    grid-template-columns: 1.5fr repeat({{ section.blocks.size | default: 3 }}, 1fr);
    gap: {{ section.settings.column_gap }}px;
    padding-bottom: {{ section.settings.section_spacing }}px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  /* Footer Columns */
  #CriminalFooter-{{ section.id }} .footer-column {
    display: flex;
    flex-direction: column;
  }

  #CriminalFooter-{{ section.id }} .footer-column__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
  }

  /* Logo */
  #CriminalFooter-{{ section.id }} .footer-logo {
    margin-bottom: 24px;
  }

  #CriminalFooter-{{ section.id }} .footer-logo__image {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  /* Newsletter */
  #CriminalFooter-{{ section.id }} .footer-newsletter {
    margin-bottom: 24px;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__heading {
    font-size: {{ section.settings.newsletter_heading_size }}px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px 0;
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__form {
    width: 100%;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__field {
    display: flex;
    border: 1px solid {{ section.settings.input_border_color }};
    background: {{ section.settings.input_background }};
    overflow: hidden;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__input {
    flex: 1;
    padding: 12px 16px;
    border: none;
    background: transparent;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    outline: none;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__input::placeholder {
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__button {
    padding: 12px 16px;
    border: none;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__button:hover {
    opacity: 0.8;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__error {
    color: #ff4444;
    font-size: 12px;
    margin-top: 8px;
  }

  #CriminalFooter-{{ section.id }} .footer-newsletter__success {
    color: #44ff44;
    font-size: 12px;
    margin-top: 8px;
  }

  /* Social Links */
  #CriminalFooter-{{ section.id }} .footer-social__list {
    display: flex;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #CriminalFooter-{{ section.id }} .footer-social__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: {{ section.settings.social_icon_color }};
    border: 1px solid {{ section.settings.social_border_color }};
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-social__link:hover {
    color: {{ section.settings.social_hover_color }};
    border-color: {{ section.settings.social_hover_color }};
    background-color: {{ section.settings.social_hover_background }};
  }

  #CriminalFooter-{{ section.id }} .footer-social__link svg {
    width: 20px;
    height: 20px;
  }

  /* Menu Links */
  #CriminalFooter-{{ section.id }} .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.link_spacing }}px;
  }

  #CriminalFooter-{{ section.id }} .footer-menu__link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: {{ section.settings.link_font_size }}px;
    font-weight: {{ section.settings.link_font_weight }};
    transition: color 0.2s ease;
    display: inline-block;
  }

  #CriminalFooter-{{ section.id }} .footer-menu__link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  /* Text Content */
  #CriminalFooter-{{ section.id }} .footer-text-content {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.link_font_size }}px;
    line-height: 1.6;
  }

  #CriminalFooter-{{ section.id }} .footer-text-content a {
    color: {{ section.settings.link_color }};
    text-decoration: underline;
  }

  /* Contact */
  #CriminalFooter-{{ section.id }} .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #CriminalFooter-{{ section.id }} .footer-contact__link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    font-size: {{ section.settings.link_font_size }}px;
    transition: color 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-contact__link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  #CriminalFooter-{{ section.id }} .footer-contact__address {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.link_font_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  /* Footer Bottom */
  #CriminalFooter-{{ section.id }} .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: {{ section.settings.bottom_padding_top }}px;
    gap: 20px;
  }

  #CriminalFooter-{{ section.id }} .footer-bottom__left,
  #CriminalFooter-{{ section.id }} .footer-bottom__center,
  #CriminalFooter-{{ section.id }} .footer-bottom__right {
    flex: 1;
  }

  #CriminalFooter-{{ section.id }} .footer-bottom__center {
    text-align: center;
  }

  #CriminalFooter-{{ section.id }} .footer-bottom__right {
    text-align: right;
  }

  /* Payment Icons */
  #CriminalFooter-{{ section.id }} .footer-payment__list {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  #CriminalFooter-{{ section.id }} .footer-payment__icon {
    height: 24px;
    width: auto;
  }

  /* Copyright */
  #CriminalFooter-{{ section.id }} .footer-copyright {
    color: {{ section.settings.copyright_color }};
    font-size: {{ section.settings.copyright_font_size }}px;
    margin: 0;
  }

  /* Site Credit */
  #CriminalFooter-{{ section.id }} .footer-credit {
    color: {{ section.settings.copyright_color }};
    font-size: {{ section.settings.copyright_font_size }}px;
    margin: 0;
  }

  #CriminalFooter-{{ section.id }} .footer-credit__link {
    color: {{ section.settings.credit_link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #CriminalFooter-{{ section.id }} .footer-credit__link:hover {
    color: {{ section.settings.link_hover_color }};
    text-decoration: underline;
  }

  /* Tablet Styles */
  @media (max-width: 990px) {
    #CriminalFooter-{{ section.id }} .footer-container {
      padding: 0 {{ section.settings.horizontal_padding_tablet }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-main {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 30px;
    }

    #CriminalFooter-{{ section.id }} .footer-column--primary {
      grid-column: 1 / -1;
    }

    #CriminalFooter-{{ section.id }} .footer-newsletter__field {
      max-width: 400px;
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CriminalFooter-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-container {
      padding: 0 {{ section.settings.horizontal_padding_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-main {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }

    #CriminalFooter-{{ section.id }} .footer-logo {
      display: flex;
      justify-content: center;
    }

    #CriminalFooter-{{ section.id }} .footer-newsletter__field {
      max-width: 100%;
    }

    #CriminalFooter-{{ section.id }} .footer-social__list {
      justify-content: center;
    }

    #CriminalFooter-{{ section.id }} .footer-menu {
      align-items: center;
    }

    #CriminalFooter-{{ section.id }} .footer-contact {
      align-items: center;
    }

    #CriminalFooter-{{ section.id }} .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    #CriminalFooter-{{ section.id }} .footer-bottom__left,
    #CriminalFooter-{{ section.id }} .footer-bottom__center,
    #CriminalFooter-{{ section.id }} .footer-bottom__right {
      text-align: center;
      width: 100%;
    }

    #CriminalFooter-{{ section.id }} .footer-payment__list {
      justify-content: center;
    }

    #CriminalFooter-{{ section.id }} .footer-column__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #CriminalFooter-{{ section.id }} .footer-menu__link,
    #CriminalFooter-{{ section.id }} .footer-contact__link,
    #CriminalFooter-{{ section.id }} .footer-contact__address,
    #CriminalFooter-{{ section.id }} .footer-text-content {
      font-size: {{ section.settings.link_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

