  "presets": [
    {
      "name": "Custom Philanthropy",
      "settings": {
        "text": "A PORTION OF THE PROCEEDS FROM EVERY BAG SOLD WILL BE DONATED TO ORGANIZATIONS DEDICATED TO COMBATTING CRIME.",
