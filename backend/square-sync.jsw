/**
 * Square <-> Wix Sync Web Module
 *
 * .jsw files are "web modules" — their exported functions can be called
 * from frontend code (e.g., a dashboard page button) while running securely
 * on the backend.
 *
 * This module handles:
 *   1. Full product sync (Square -> Wix): imports/updates products
 *   2. Inventory sync (Square -> Wix): updates Wix stock levels
 *   3. Inventory push (Wix -> Square): after a Wix sale, decrements Square stock
 */

import wixData from "wix-data";
import wixStoresBackend from "wix-stores-backend";
import { mediaManager } from "wix-media-backend";
import { listSquareCatalogItems, listSquareItemIds, getInventoryCounts, adjustSquareInventory, batchRetrieveCatalogObjects } from "./square-api";
import { MAPPING_COLLECTION, SYNC_CATEGORY_IDS } from "./square-config";

// ─── FULL PRODUCT SYNC (Square -> Wix) ─────────────────────────────────────

/**
 * Step 1: Fetches all Square item IDs (filtered by category).
 * Call this once from the frontend to get the full list of IDs.
 *
 * @returns {Promise<Object>} { itemIds: string[], total: number }
 */
export async function getSquareItemIds() {
  const itemIds = await listSquareItemIds();
  return { itemIds, total: itemIds.length };
}

/**
 * Step 2: Processes a batch of Square items by their IDs.
 * Call this in a loop from the frontend, passing a slice of IDs each time.
 *
 * @param {Array<string>} itemIds - Square catalog item IDs to process
 * @returns {Promise<Object>} Summary of this batch's results
 */
export async function syncBatch(itemIds) {
  const results = { created: [], updated: [], skipped: [], errors: [] };

  try {
    // Fetch the full item objects for just this batch
    const squareItems = await batchRetrieveCatalogObjects(itemIds);

    for (const squareItem of squareItems) {
      if (squareItem.type !== "ITEM") continue;
      const name = squareItem.item_data?.name || squareItem.id;
      try {
        await syncSingleItem(squareItem, results);
      } catch (err) {
        results.errors.push(`${name}: ${err.message}`);
      }
      // Small delay between API calls to avoid Wix rate limiting
      await new Promise(resolve => setTimeout(resolve, 500));
    }
  } catch (err) {
    results.errors.push(`Batch error: ${err.message}`);
  }

  return results;
}

/**
 * Step 3a: Get all variation IDs that need inventory syncing.
 * Returns the mapping data needed for batched inventory sync.
 */
export async function getInventoryMappings() {
  try {
    const mappings = await wixData.query(MAPPING_COLLECTION)
      .ne("squareVariationId", "")
      .limit(1000)
      .find();

    // Get all Square inventory counts in one batch call
    const variationIds = mappings.items.map(m => m.squareVariationId);
    const inventoryCounts = await getInventoryCounts(variationIds);

    // Build lookup
    const countLookup = {};
    for (const count of inventoryCounts) {
      countLookup[count.catalog_object_id] = parseFloat(count.quantity) || 0;
    }

    // Return mappings with Square quantities attached
    const items = mappings.items.map(m => ({
      _id: m._id,
      wixProductId: m.wixProductId,
      squareVariationId: m.squareVariationId,
      squareItemName: m.squareItemName,
      squareQty: countLookup[m.squareVariationId] || 0
    }));

    return { items, total: items.length };
  } catch (err) {
    return { items: [], total: 0, error: err.message };
  }
}

/**
 * Step 3b: Sync inventory for a batch of mappings.
 * Called in a loop from the frontend.
 *
 * @param {Array} batch - Array of { _id, wixProductId, squareQty, squareItemName }
 * @returns {Promise<Object>} { synced: number, errors: string[] }
 */
export async function syncInventoryBatch(batch) {
  const results = { synced: 0, updated: [], skipped: 0, errors: [] };

  for (const item of batch) {
    try {
      const product = await wixData.get("Stores/Products", item.wixProductId);
      const currentWixQty = product?.stock?.quantity || 0;

      const delta = item.squareQty - currentWixQty;

      if (delta > 0) {
        await wixStoresBackend.incrementInventory(item.wixProductId, null, delta);
      } else if (delta < 0) {
        await wixStoresBackend.decrementInventory(item.wixProductId, null, Math.abs(delta));
      }

      // Update lastSynced timestamp
      const mapping = await wixData.get(MAPPING_COLLECTION, item._id);
      mapping.lastSynced = new Date();
      await wixData.update(MAPPING_COLLECTION, mapping);

      if (delta !== 0) {
        results.updated.push({
          name: item.squareItemName,
          change: `${currentWixQty} → ${item.squareQty} (${delta > 0 ? "+" : ""}${delta})`
        });
      } else {
        results.skipped++;
      }
      results.synced++;
    } catch (err) {
      results.errors.push(`${item.squareItemName}: ${err.message}`);
    }
  }

  return results;
}

/**
 * Step 1 for images: Fetches all Square items that have images and builds
 * a list of { squareItemId, name, wixProductId, imageUrls } for each.
 * Call once from the frontend, then loop through the list calling syncSingleProductImages.
 *
 * @returns {Promise<Object>} { items: Array, total: number }
 */
export async function getImageSyncList() {
  const items = [];

  try {
    const squareItems = await listSquareCatalogItems();
    if (!squareItems || squareItems.length === 0) return { items, total: 0 };

    // Fetch all image URLs from Square
    const imageUrlMap = await fetchSquareImageUrls(squareItems);

    for (const squareItem of squareItems) {
      const itemData = squareItem.item_data;
      if (!itemData || !itemData.image_ids || itemData.image_ids.length === 0) continue;

      // Find the Wix product mapping
      const mapping = await wixData.query(MAPPING_COLLECTION)
        .eq("squareCatalogId", squareItem.id)
        .eq("squareVariationId", "")
        .find();

      if (mapping.items.length === 0) continue;

      const imageUrls = itemData.image_ids
        .map(id => imageUrlMap[id])
        .filter(Boolean);

      if (imageUrls.length === 0) continue;

      items.push({
        name: itemData.name || squareItem.id,
        wixProductId: mapping.items[0].wixProductId,
        imageUrls: imageUrls
      });
    }
  } catch (err) {
    console.error("Failed to build image sync list:", err);
  }

  return { items, total: items.length };
}

/**
 * Step 2 for images: Imports images for a single product.
 * Called in a loop from the frontend.
 *
 * @param {string} wixProductId - The Wix product ID
 * @param {Array<string>} imageUrls - URLs of images to import
 * @param {string} [productName] - Product name used for file naming
 * @returns {Promise<Object>} { success: boolean, error: string|null }
 */
export async function syncSingleProductImages(wixProductId, imageUrls, productName) {
  try {
    const imageResult = await importImagesToWixProduct(wixProductId, imageUrls, productName);
    return {
      success: true,
      imported: imageResult.imported,
      failed: imageResult.failed,
      error: null
    };
  } catch (err) {
    return { success: false, imported: 0, failed: imageUrls.length, error: err.message };
  }
}

/**
 * Sync a single Square catalog item to Wix.
 * Creates the product if it doesn't exist, updates it if it does.
 */
async function syncSingleItem(squareItem, results) {
  const itemData = squareItem.item_data;
  if (!itemData) return;

  const name = itemData.name || squareItem.id;

  // Check if we already have a mapping for this Square item
  const existingMapping = await wixData.query(MAPPING_COLLECTION)
    .eq("squareCatalogId", squareItem.id)
    .find();

  if (existingMapping.items.length > 0) {
    // Update existing Wix product — track what changed
    const mapping = existingMapping.items[0];
    const changes = await updateWixProduct(mapping.wixProductId, squareItem);
    if (changes.length > 0) {
      results.updated.push({ name, changes });
    } else {
      results.skipped.push(name);
    }
  } else {
    // Create new Wix product
    const wixProductId = await createWixProduct(squareItem);
    if (wixProductId) {
      // Save the mapping
      await saveMappings(squareItem, wixProductId);
      results.created.push(name);
    } else {
      results.errors.push(`${name}: failed to create`);
    }
  }
}

/**
 * Creates a new product in Wix Stores from a Square catalog item.
 *
 * @param {Object} squareItem - The Square CatalogObject (type: ITEM)
 * @returns {Promise<string|null>} The new Wix product ID, or null on failure
 */
async function createWixProduct(squareItem) {
  const itemData = squareItem.item_data;

  // Use description_html if available, fall back to plain description
  const description = itemData.description_html || itemData.description || "";

  // Build the Wix product info object
  const productInfo = {
    name: (itemData.name || "Untitled Product").substring(0, 80),
    description: description,
    productType: "physical",
    visible: true,
    trackInventory: true,
    manageVariants: false
  };

  // Set price from the first variation
  if (itemData.variations && itemData.variations.length > 0) {
    const priceMoney = itemData.variations[0].item_variation_data?.price_money;
    if (priceMoney) {
      productInfo.price = priceMoney.amount / 100;
    }
  }

  // Set SKU from the first variation
  if (itemData.variations && itemData.variations.length > 0) {
    const sku = itemData.variations[0].item_variation_data?.sku;
    if (sku) {
      productInfo.sku = sku;
    }
  }

  try {
    const wixProduct = await wixStoresBackend.createProduct(productInfo);
    return wixProduct._id;
  } catch (err) {
    console.error("Failed to create Wix product:", err);
    return null;
  }
}

/**
 * Updates an existing Wix product with data from Square.
 * Returns a list of field names that actually changed.
 *
 * @param {string} wixProductId - The Wix product ID
 * @param {Object} squareItem - The Square CatalogObject
 * @returns {Promise<string[]>} List of changed fields (e.g. ["price", "name"])
 */
async function updateWixProduct(wixProductId, squareItem) {
  const itemData = squareItem.item_data;
  const changes = [];

  // Fetch current Wix product to compare
  let currentProduct;
  try {
    currentProduct = await wixData.get("Stores/Products", wixProductId);
  } catch (err) {
    console.error(`Failed to read Wix product ${wixProductId}:`, err);
    return changes;
  }

  // Use description_html if available, fall back to plain description
  const newDescription = itemData.description_html || itemData.description || undefined;
  const newName = itemData.name ? itemData.name.substring(0, 80) : undefined;

  // Determine new price from Square
  let newPrice;
  if (itemData.variations && itemData.variations.length > 0) {
    const priceMoney = itemData.variations[0].item_variation_data?.price_money;
    if (priceMoney) {
      newPrice = priceMoney.amount / 100;
    }
  }

  // Compare and build updateFields only for actual changes
  const updateFields = { trackInventory: true };

  if (newName && newName !== currentProduct.name) {
    updateFields.name = newName;
    changes.push("name");
  }

  if (newDescription && newDescription !== currentProduct.description) {
    updateFields.description = newDescription;
    changes.push("description");
  }

  if (newPrice !== undefined && newPrice !== currentProduct.price) {
    updateFields.price = newPrice;
    changes.push(`price ($${currentProduct.price || 0} → $${newPrice})`);
  }

  // Only call the API if something actually changed
  if (changes.length > 0) {
    try {
      await wixStoresBackend.updateProductFields(wixProductId, updateFields);
    } catch (err) {
      console.error(`Failed to update Wix product ${wixProductId}:`, err);
    }
  }

  return changes;
}

/**
 * Saves mapping entries for a Square item and all its variations.
 */
async function saveMappings(squareItem, wixProductId) {
  const itemData = squareItem.item_data;

  // Save the main item mapping
  const mapping = {
    squareCatalogId: squareItem.id,
    squareVariationId: "",
    wixProductId: wixProductId,
    wixVariantId: "",
    squareCategoryId: (itemData.categories && itemData.categories[0]?.id) || itemData.category_id || "",
    squareItemName: itemData.name || "",
    lastSynced: new Date()
  };

  await wixData.insert(MAPPING_COLLECTION, mapping);

  // Save mappings for each variation
  if (itemData.variations) {
    for (const variation of itemData.variations) {
      const varMapping = {
        squareCatalogId: squareItem.id,
        squareVariationId: variation.id,
        wixProductId: wixProductId,
        wixVariantId: "", // Will be populated if Wix variants are created
        squareCategoryId: (itemData.categories && itemData.categories[0]?.id) || itemData.category_id || "",
        squareItemName: `${itemData.name} - ${variation.item_variation_data?.name || "Default"}`,
        lastSynced: new Date()
      };

      await wixData.insert(MAPPING_COLLECTION, varMapping);
    }
  }
}

// ─── IMAGE HELPERS ──────────────────────────────────────────────────────────

/**
 * Fetches all Square image objects for the given items and returns a map of imageId -> URL.
 */
async function fetchSquareImageUrls(squareItems) {
  const imageUrlMap = {};

  // Collect all unique image IDs from all items
  const allImageIds = [];
  for (const item of squareItems) {
    const imageIds = item.item_data?.image_ids || [];
    for (const id of imageIds) {
      if (!allImageIds.includes(id)) {
        allImageIds.push(id);
      }
    }
  }

  if (allImageIds.length === 0) return imageUrlMap;

  try {
    // Batch retrieve image objects from Square (max 1000 per request)
    const imageObjects = await batchRetrieveCatalogObjects(allImageIds);

    for (const obj of imageObjects) {
      if (obj.type === "IMAGE" && obj.image_data?.url) {
        imageUrlMap[obj.id] = obj.image_data.url;
      }
    }
  } catch (err) {
    console.error("Failed to fetch Square image URLs:", err);
  }

  return imageUrlMap;
}

/**
 * Imports images from external URLs and attaches them to a Wix product.
 * Uses wix-media-backend importFile to bring images into the Media Manager,
 * then attaches them to the product via addProductMedia.
 */
async function importImagesToWixProduct(wixProductId, imageUrls, productName) {
  const mediaItems = [];
  let failedCount = 0;

  // Import images sequentially to avoid overwhelming the API
  for (let i = 0; i < imageUrls.length; i++) {
    const url = imageUrls[i];
    try {
      const result = await mediaManager.importFile("/square-products", url, {
        mediaOptions: { mimeType: "image/jpeg" },
        metadataOptions: { isVisitorUpload: false }
      });

      // fileUrl is the current property; fileName is the legacy equivalent
      const wixUrl = result?.fileUrl || result?.fileName;

      if (wixUrl) {
        mediaItems.push({ src: wixUrl });
      } else {
        // Import succeeded but no URL yet — use external URL as fallback
        console.warn(`Import of ${url} returned no fileUrl (keys: ${Object.keys(result || {}).join(", ")}). Using external URL.`);
        mediaItems.push({ src: url });
      }
    } catch (err) {
      console.error(`Failed to import image ${url}: ${err.message}`);
      failedCount++;
    }
  }

  if (mediaItems.length > 0) {
    try {
      await wixStoresBackend.addProductMedia(wixProductId, mediaItems);
    } catch (err) {
      console.error(`Failed to attach ${mediaItems.length} images to product ${wixProductId}: ${err.message}`);
      console.error("Media items attempted:", JSON.stringify(mediaItems));
    }
  }

  return { imported: mediaItems.length, failed: failedCount };
}

// ─── INVENTORY SYNC (Square -> Wix) ────────────────────────────────────────

/**
 * Syncs inventory counts from Square to Wix for all mapped products.
 * Called as part of the full sync and also independently on a schedule.
 *
 * @param {Object} results - Optional results accumulator
 */
export async function syncAllInventoryCounts(results = { inventorySynced: 0, errors: [] }) {
  try {
    // Get all mappings that have a Square variation ID
    const mappings = await wixData.query(MAPPING_COLLECTION)
      .ne("squareVariationId", "")
      .limit(1000)
      .find();

    if (mappings.items.length === 0) return results;

    // Collect all Square variation IDs
    const variationIds = mappings.items.map(m => m.squareVariationId);

    // Batch retrieve inventory from Square
    const inventoryCounts = await getInventoryCounts(variationIds);

    // Build a lookup: squareVariationId -> quantity
    const countLookup = {};
    for (const count of inventoryCounts) {
      countLookup[count.catalog_object_id] = parseFloat(count.quantity) || 0;
    }

    // Update each Wix product's inventory
    for (const mapping of mappings.items) {
      const squareQty = countLookup[mapping.squareVariationId] || 0;

      try {
        // Get current Wix inventory to calculate the delta
        const product = await wixData.get("Stores/Products", mapping.wixProductId);
        const currentWixQty = product?.stock?.quantity || 0;

        const delta = squareQty - currentWixQty;

        if (delta > 0) {
          await wixStoresBackend.incrementInventory(mapping.wixProductId, null, delta);
        } else if (delta < 0) {
          await wixStoresBackend.decrementInventory(mapping.wixProductId, null, Math.abs(delta));
        }

        // Update the lastSynced timestamp
        mapping.lastSynced = new Date();
        await wixData.update(MAPPING_COLLECTION, mapping);

        results.inventorySynced++;
      } catch (err) {
        results.errors.push(`Inventory sync error for ${mapping.squareItemName}: ${err.message}`);
      }
    }
  } catch (err) {
    results.errors.push(`Inventory sync fatal error: ${err.message}`);
  }

  return results;
}

// ─── INVENTORY PUSH (Wix -> Square) ────────────────────────────────────────

/**
 * After a Wix order is completed, decrement the corresponding Square inventory.
 * Called from events.js when an order is paid.
 *
 * @param {Array} lineItems - Array of { productId, quantity } from the Wix order
 * @returns {Promise<Object>} Results of the Square inventory adjustments
 */
export async function decrementSquareInventoryForOrder(lineItems) {
  const results = { adjusted: 0, errors: [] };

  for (const item of lineItems) {
    try {
      // Look up the Square variation ID from our mapping
      const mapping = await wixData.query(MAPPING_COLLECTION)
        .eq("wixProductId", item.productId)
        .ne("squareVariationId", "")
        .find();

      if (mapping.items.length === 0) {
        results.errors.push(`No Square mapping found for Wix product ${item.productId}`);
        continue;
      }

      // Use the first variation mapping (for products without variants)
      const squareVariationId = mapping.items[0].squareVariationId;

      // Decrement inventory in Square
      await adjustSquareInventory(
        squareVariationId,
        -item.quantity,
        `Wix order - sold ${item.quantity}`
      );

      results.adjusted++;
    } catch (err) {
      results.errors.push(`Failed to adjust Square inventory for ${item.productId}: ${err.message}`);
    }
  }

  return results;
}

// ─── UTILITY FUNCTIONS ─────────────────────────────────────────────────────

/**
 * Get all current mappings (useful for a dashboard display).
 *
 * @returns {Promise<Array>} All mapping records
 */
export async function getAllMappings() {
  const result = await wixData.query(MAPPING_COLLECTION)
    .limit(1000)
    .ascending("squareItemName")
    .find();

  return result.items;
}

/**
 * Remove a mapping and optionally delete the Wix product.
 *
 * @param {string} mappingId - The _id of the mapping record
 * @param {boolean} deleteWixProduct - Whether to also delete the Wix product
 */
export async function removeMapping(mappingId, deleteWixProduct = false) {
  const mapping = await wixData.get(MAPPING_COLLECTION, mappingId);

  if (deleteWixProduct && mapping.wixProductId) {
    try {
      await wixStoresBackend.deleteProduct(mapping.wixProductId);
    } catch (err) {
      console.error("Failed to delete Wix product:", err);
    }
  }

  // Remove all mappings for this Square item
  const allMappings = await wixData.query(MAPPING_COLLECTION)
    .eq("squareCatalogId", mapping.squareCatalogId)
    .find();

  for (const m of allMappings.items) {
    await wixData.remove(MAPPING_COLLECTION, m._id);
  }
}

/**
 * Sync inventory for a single product (by Wix product ID).
 * Useful for on-demand sync from a product page.
 *
 * @param {string} wixProductId - The Wix product ID
 */
export async function syncSingleProductInventory(wixProductId) {
  const mapping = await wixData.query(MAPPING_COLLECTION)
    .eq("wixProductId", wixProductId)
    .ne("squareVariationId", "")
    .find();

  if (mapping.items.length === 0) {
    throw new Error("No Square mapping found for this product.");
  }

  const squareVariationId = mapping.items[0].squareVariationId;
  const counts = await getInventoryCounts([squareVariationId]);

  if (counts.length > 0) {
    const squareQty = parseFloat(counts[0].quantity) || 0;
    const product = await wixData.get("Stores/Products", wixProductId);
    const currentWixQty = product?.stock?.quantity || 0;
    const delta = squareQty - currentWixQty;

    if (delta > 0) {
      await wixStoresBackend.incrementInventory(wixProductId, null, delta);
    } else if (delta < 0) {
      await wixStoresBackend.decrementInventory(wixProductId, null, Math.abs(delta));
    }
  }

  // Update sync timestamp
  for (const m of mapping.items) {
    m.lastSynced = new Date();
    await wixData.update(MAPPING_COLLECTION, m);
  }

  return { success: true };
}
