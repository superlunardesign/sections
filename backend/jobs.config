{
  "jobs": [
    {
      "functionLocation": "/square-scheduled-sync.js",
      "functionName": "scheduledInventorySync",
      "description": "Syncs inventory counts from Square to Wix every 30 minutes",
      "executionConfig": {
        "cronExpression": "*/30 * * * *"
      }
    },
    {
      "functionLocation": "/square-scheduled-sync.js",
      "functionName": "scheduledFullSync",
      "description": "Full product and inventory sync from Square to Wix (hourly)",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    }
  ]
}
