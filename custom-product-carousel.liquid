<!-- Custom Product Carousel Section -->
<div id="CustomProductCarousel-{{ section.id }}" class="custom-product-carousel-section">
  <div class="carousel-container">
    <h2 class="carousel-section-title">{{ section.settings.section_title | default: 'Explore our bestsellers' }}</h2>

    <div class="carousel-wrapper">
      <div class="product-carousel">
        {% assign collection = collections[section.settings.collection] %}
        {% if collection == blank %}
          {% assign collection = collections.all %}
        {% endif %}
        {% for product in collection.products limit: section.settings.products_limit %}
          <div class="product-card-wrapper" data-product-id="{{ product.id }}">
            {%- comment -%} Row 1: Card (image + title + price only) {%- endcomment -%}
            <div class="product-card">
              <!-- Status Indicators -->
              {% if product.available == false %}
                <div class="status-badge status-badge--out-of-stock">{{ section.settings.out_of_stock_badge_text }}</div>
              {% elsif product.compare_at_price > product.price %}
                <div class="status-badge status-badge--sale">{{ section.settings.sale_badge_text }}</div>
              {% elsif product.tags contains section.settings.new_product_tag %}
                <div class="status-badge status-badge--new">{{ section.settings.new_badge_text }}</div>
              {% elsif product.tags contains section.settings.editors_pick_tag %}
                <div class="status-badge status-badge--editors-pick">{{ section.settings.editors_pick_badge_text }}</div>
              {% endif %}

              <!-- Product Image -->
              <div class="product-image">
                {% if product.featured_image %}
                  <a href="{{ product.url }}">
                    <img src="{{ product.featured_image | img_url: '600x600' }}"
                         alt="{{ product.featured_image.alt | escape }}"
                         loading="lazy"
                         width="600"
                         height="600">
                  </a>
                {% else %}
                  <div class="no-image">No image available</div>
                {% endif %}
              </div>

              <!-- Product Info (title + price only) -->
              <div class="product-info">
                <a href="{{ product.url }}"><p class="product-title">{{ product.title }}</p></a>

                {% if section.settings.show_price %}
                  <div class="product-price">
                    {% if product.compare_at_price > product.price %}
                      <span class="price-compare">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="price-current" data-product-price>{{ product.price | money }}</span>
                  </div>
                {% endif %}

                <!-- Mini Description from metafield -->
                {% if section.settings.show_mini_description and product.metafields.custom.mini_description %}
                  <p class="product-mini-description">{{ product.metafields.custom.mini_description }}</p>
                {% endif %}

                <!-- Star Rating (if enabled and metafield exists) -->
                {% if section.settings.show_ratings and product.metafields.reviews.rating.value != blank %}
                  {% liquid
                    assign rating_decimal = 0
                    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                    if decimal >= 0.3 and decimal <= 0.7
                      assign rating_decimal = 0.5
                    elsif decimal > 0.7
                      assign rating_decimal = 1
                    endif
                  %}
                  <div class="rating">
                    <div class="stars">
                      {% assign full_stars = product.metafields.reviews.rating.value.rating | floor %}
                      {% assign half_star_position = full_stars | plus: 1 %}
                      {% for i in (1..5) %}
                        {% if i <= full_stars %}
                          <span class="star star--filled">★</span>
                        {% elsif i == half_star_position and rating_decimal == 0.5 %}
                          <span class="star star--half">★</span>
                        {% else %}
                          <span class="star">★</span>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% if product.metafields.reviews.rating_count %}
                      <span class="review-count">({{ product.metafields.reviews.rating_count }})</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>

            {%- comment -%} Row 2: Button (outside the card) {%- endcomment -%}
            {% if section.settings.show_variants_and_button %}
              <div class="outside-button">
                {% if product.available %}
                  <button class="add-to-cart-btn"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                    <span>{{ section.settings.add_to_cart_text }}</span>
                  </button>
                {% else %}
                  <button class="add-to-cart-btn" disabled>
                    <span>{{ section.settings.out_of_stock_button_text }}</span>
                  </button>
                {% endif %}
              </div>
            {% endif %}

            {%- comment -%} Row 3: Variants (outside the card) {%- endcomment -%}
            <div class="outside-variants">
              {% if section.settings.show_variant_options and section.settings.show_variants_and_button and product.has_only_default_variant == false %}
                <div class="product-options">
                  <script type="application/json" class="variant-data">
                    {{ product.variants | json }}
                  </script>
                  {% for option in product.options_with_values %}
                    {% assign option_name_lower = option.name | downcase %}
                    {% assign is_color = false %}
                    {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
                      {% assign is_color = true %}
                    {% endif %}

                    <div class="option-group" data-option-type="{% if is_color %}color{% else %}size{% endif %}">
                      <div class="size-options">
                        {% assign max_visible = section.settings.max_visible_variants %}
                        {% assign total_values = option.values.size %}
                        {% assign remaining = total_values | minus: max_visible %}

                        {% for value in option.values %}
                          {% if is_color %}
                            <button class="color-swatch"
                                    data-option-position="{{ option.position }}"
                                    data-option-value="{{ value | escape }}"
                                    style="background-color:{%- assign matching_color = product.metafields.shopify.color-pattern.value | where: "label", value | first -%}{{ matching_color.color }};"
                                    title="{{ value }}"
                                    {% if forloop.first %}data-selected="true"{% endif %}>
                            </button>
                          {% else %}
                            {% if forloop.index <= max_visible %}
                              <button class="size-btn"
                                      data-option-position="{{ option.position }}"
                                      data-option-value="{{ value | escape }}"
                                      {% if forloop.first %}data-selected="true"{% endif %}>
                                {{ value }}
                              </button>
                            {% endif %}
                          {% endif %}
                        {% endfor %}

                        {% if remaining > 0 and is_color == false %}
                          <a href="{{ product.url }}" class="more-options">+{{ remaining }} More</a>
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Navigation: Arrows + Dots together -->
    <div class="carousel-navigation">
      <button class="carousel-nav-btn carousel-nav-btn--prev" aria-label="Previous products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {% if section.settings.show_dots %}
        <div class="carousel-dots"></div>
      {% endif %}

      <button class="carousel-nav-btn carousel-nav-btn--next" aria-label="Next products">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{%- style -%}
  /* =============================================
     CUSTOM PRODUCT CAROUSEL - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CustomProductCarousel-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #CustomProductCarousel-{{ section.id }} .carousel-container {
    max-width: 100vw;
    margin: 0 auto;
    padding: 0 80px;
  }

  #CustomProductCarousel-{{ section.id }} .carousel-section-title {
    text-align: {{ section.settings.title_alignment }};
    font-size: {{ section.settings.title_font_size }}px;
    margin-bottom: 40px;
    color: {{ section.settings.title_color }};
    font-weight: {{ section.settings.title_font_weight }};
    letter-spacing: {{ section.settings.title_letter_spacing }}em;
    text-transform: {{ section.settings.title_text_transform }};
  }

  #CustomProductCarousel-{{ section.id }} .carousel-wrapper {
    position: relative;
    margin: 0;
  }

  #CustomProductCarousel-{{ section.id }} .product-carousel {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 0;
  }

  #CustomProductCarousel-{{ section.id }} .product-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Card Wrapper - the flex item in the carousel */
  #CustomProductCarousel-{{ section.id }} .product-card-wrapper {
    flex: 0 0 {{ section.settings.card_width }}px;
    display: flex;
    flex-direction: column;
  }

  /* Row 1: The card itself (image + title + price) */
  #CustomProductCarousel-{{ section.id }} .product-card {
    background: {{ section.settings.card_background_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    position: relative;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  #CustomProductCarousel-{{ section.id }} .product-card:hover {
    transform: translateY(-5px);
  }

  /* Row 2: Button container (outside card) */
  #CustomProductCarousel-{{ section.id }} .outside-button {
    padding: 10px 0 8px 0;
  }

  #CustomProductCarousel-{{ section.id }} .outside-button .add-to-cart-btn {
    width: 100%;
  }

  /* Row 3: Variants container (outside card) */
  #CustomProductCarousel-{{ section.id }} .outside-variants {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #CustomProductCarousel-{{ section.id }} .outside-variants .product-options {
    margin-bottom: 0;
  }

  /* Status Badges */
  #CustomProductCarousel-{{ section.id }} .status-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 2;
    letter-spacing: 0.5px;
  }

  #CustomProductCarousel-{{ section.id }} .status-badge--new {
    background: {{ section.settings.new_badge_color }};
    color: {{ section.settings.badge_text_color }};
  }

  #CustomProductCarousel-{{ section.id }} .status-badge--sale {
    background: {{ section.settings.sale_badge_color }};
    color: {{ section.settings.badge_text_color }};
  }

  #CustomProductCarousel-{{ section.id }} .status-badge--out-of-stock {
    background: {{ section.settings.out_of_stock_badge_color }};
    color: {{ section.settings.badge_text_color }};
  }

  #CustomProductCarousel-{{ section.id }} .status-badge--editors-pick {
    background: {{ section.settings.editors_pick_badge_color }};
    color: {{ section.settings.badge_text_color }};
  }

  /* Product Image */
  #CustomProductCarousel-{{ section.id }} .product-image {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    background: {{ section.settings.image_background_color }};
    border-radius: {{ section.settings.card_border_radius }}px {{ section.settings.card_border_radius }}px 0 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #CustomProductCarousel-{{ section.id }} .product-image a {
    display: block;
    width: 100%;
    height: 100%;
    background-color: transparent;
  }

  #CustomProductCarousel-{{ section.id }} .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #CustomProductCarousel-{{ section.id }} .no-image {
    color: #999;
    font-size: 0.9rem;
  }

  /* Product Info */
  #CustomProductCarousel-{{ section.id }} .product-info {
    padding: 15px;
    display: flex;
    flex-direction: column;
  }

  #CustomProductCarousel-{{ section.id }} .product-title {
    font-size: {{ section.settings.product_title_font_size }}px;
    font-weight: 400;
    margin: 0 0 2px 0;
    color: {{ section.settings.product_title_color }};
    line-height: 1.2;
    min-height: 45px;
  }

  #CustomProductCarousel-{{ section.id }} .product-info a {
    text-decoration: none;
  }

  /* Product Price */
  #CustomProductCarousel-{{ section.id }} .product-price {
    margin: 8px 0 12px 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  #CustomProductCarousel-{{ section.id }} .price-current {
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.price_color }};
    font-weight: 400;
  }

  #CustomProductCarousel-{{ section.id }} .price-compare {
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.price_compare_color }};
    text-decoration: line-through;
    font-weight: 400;
  }

  #CustomProductCarousel-{{ section.id }} .product-mini-description {
    margin-block: 5px !important;
    font-size: 14px;
    color: {{ section.settings.description_color }};
  }

  /* Rating */
  #CustomProductCarousel-{{ section.id }} .rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 15px;
  }

  #CustomProductCarousel-{{ section.id }} .stars {
    display: flex;
    gap: 2px;
  }

  #CustomProductCarousel-{{ section.id }} .star {
    color: #ddd;
    font-size: 1rem;
  }

  #CustomProductCarousel-{{ section.id }} .star--filled {
    color: {{ section.settings.star_color }};
  }

  #CustomProductCarousel-{{ section.id }} .star--half {
    color: {{ section.settings.star_color }};
    opacity: 0.6;
  }

  #CustomProductCarousel-{{ section.id }} .review-count {
    color: {{ section.settings.description_color }};
    font-size: 0.9rem;
  }

  /* Variant Options */
  #CustomProductCarousel-{{ section.id }} .product-options {
    margin-bottom: 15px;
  }

  #CustomProductCarousel-{{ section.id }} .option-group {
    margin-bottom: 8px;
  }

  #CustomProductCarousel-{{ section.id }} .size-options {
    display: flex;
    gap: 8px;
    font-size: 14px;
    flex-wrap: wrap;
  }

  #CustomProductCarousel-{{ section.id }} .size-btn {
    padding: 4px 14px;
    border: {{ section.settings.variant_button_border_width }}px solid {{ section.settings.variant_button_border_color }};
    background: {{ section.settings.variant_button_background }};
    color: {{ section.settings.variant_button_text_color }};
    border-radius: {{ section.settings.variant_button_border_radius }}px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #CustomProductCarousel-{{ section.id }} .size-btn:hover {
    border-color: {{ section.settings.variant_button_hover_border_color }};
  }

  #CustomProductCarousel-{{ section.id }} .size-btn[data-selected="true"] {
    background: {{ section.settings.variant_button_selected_background }};
    color: {{ section.settings.variant_button_selected_text_color }};
    border-color: {{ section.settings.variant_button_selected_border_color }};
  }

  /* Unavailable Variant Styles */
  #CustomProductCarousel-{{ section.id }} .size-btn[data-unavailable="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    position: relative;
  }

  #CustomProductCarousel-{{ section.id }} .size-btn[data-unavailable="true"]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transform: rotate(-15deg);
  }

  /* Color Swatches */
  #CustomProductCarousel-{{ section.id }} .color-swatch {
    width: {{ section.settings.color_swatch_size }}px;
    height: {{ section.settings.color_swatch_size }}px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
  }

  #CustomProductCarousel-{{ section.id }} .color-swatch:hover {
    transform: scale(1.1);
  }

  #CustomProductCarousel-{{ section.id }} .color-swatch[data-selected="true"] {
    border-color: {{ section.settings.color_swatch_selected_border }};
    box-shadow: 0 0 0 2px {{ section.settings.color_swatch_selected_border }};
  }

  #CustomProductCarousel-{{ section.id }} .color-swatch[data-unavailable="true"] {
    opacity: 0.4;
    cursor: not-allowed;
    position: relative;
  }

  #CustomProductCarousel-{{ section.id }} .color-swatch[data-unavailable="true"]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -2px;
    right: -2px;
    height: 2px;
    background: #cc0000;
    transform: rotate(-45deg);
  }

  /* +X More Link */
  #CustomProductCarousel-{{ section.id }} .more-options {
    padding: 4px 10px;
    font-size: 12px;
    color: {{ section.settings.variant_button_text_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  #CustomProductCarousel-{{ section.id }} .more-options:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Add to Cart Button */
  #CustomProductCarousel-{{ section.id }} .add-to-cart-btn {
    width: 100%;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: 400;
    cursor: pointer;
    font-size: {{ section.settings.button_font_size }}px;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #CustomProductCarousel-{{ section.id }} .add-to-cart-btn:hover {
    opacity: 0.9;
  }

  #CustomProductCarousel-{{ section.id }} .add-to-cart-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Carousel Navigation - Arrows + Dots inline */
  #CustomProductCarousel-{{ section.id }} .carousel-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.nav_gap }}px;
    margin-top: {{ section.settings.dot_margin_top }}px;
  }

  #CustomProductCarousel-{{ section.id }} .carousel-nav-btn {
    background: {{ section.settings.nav_button_background }};
    border: {{ section.settings.nav_button_border_width }}px solid {{ section.settings.nav_button_border_color }};
    border-radius: {{ section.settings.nav_button_border_radius }}px;
    width: {{ section.settings.nav_button_size }}px;
    height: {{ section.settings.nav_button_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: {{ section.settings.nav_button_color }};
    padding: 0;
  }

  #CustomProductCarousel-{{ section.id }} .carousel-nav-btn:hover {
    background: {{ section.settings.nav_button_hover_background }};
    border-color: {{ section.settings.nav_button_hover_border_color }};
    color: {{ section.settings.nav_button_hover_color }};
  }

  /* Carousel Dots */
  #CustomProductCarousel-{{ section.id }} .carousel-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.dot_gap }}px;
  }

  #CustomProductCarousel-{{ section.id }} .dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0.5;
  }

  #CustomProductCarousel-{{ section.id }} .dot:hover {
    opacity: 0.8;
  }

  #CustomProductCarousel-{{ section.id }} .dot--active {
    background: {{ section.settings.dot_active_color }};
    opacity: 1;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CustomProductCarousel-{{ section.id }} .product-card-wrapper {
      flex: 0 0 {{ section.settings.card_width_mobile }}px;
    }
#CustomProductCarousel-{{ section.id }} .product-content {
  text-align:center;
}
#CustomProductCarousel-{{ section.id }} .product-price {
  justify-content:center;
}
   /* #CustomProductCarousel-{{ section.id }} .carousel-nav-btn {
     display: none;
    }
     */

    #CustomProductCarousel-{{ section.id }} .carousel-wrapper {
      margin: 0;
      margin-left:4vw;
    }

    #CustomProductCarousel-{{ section.id }} .carousel-container {
      padding: 0 15px;
    }

    #CustomProductCarousel-{{ section.id }} .carousel-section-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }

    #CustomProductCarousel-{{ section.id }} .product-image {
      height: {{ section.settings.image_height_mobile }}px;
    }

    #CustomProductCarousel-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #CustomProductCarousel-{{ section.id }} .carousel-navigation {
      gap: {{ section.settings.dot_gap }}px;
    }
  }
{%- endstyle -%}

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('CustomProductCarousel-' + sectionId);
  if (!section) return;

  const carousel = section.querySelector('.product-carousel');
  const prevBtn = section.querySelector('.carousel-nav-btn--prev');
  const nextBtn = section.querySelector('.carousel-nav-btn--next');
  const dotsContainer = section.querySelector('.carousel-dots');
  const totalProducts = {{ collection.products.size | at_most: section.settings.products_limit }};
  const cardWidthDesktop = {{ section.settings.card_width }};
  const cardWidthMobile = {{ section.settings.card_width_mobile }};
  const cardGap = {{ section.settings.card_gap }};

  // Mark unavailable variants on page load
  section.querySelectorAll('.product-card-wrapper').forEach(productCard => {
    const variantDataScript = productCard.querySelector('.variant-data');
    if (!variantDataScript) return;

    try {
      const variants = JSON.parse(variantDataScript.textContent);

      // Check each option button for availability
      productCard.querySelectorAll('.size-btn, .color-swatch').forEach(btn => {
        const optionPosition = parseInt(btn.getAttribute('data-option-position'));
        const optionValue = btn.getAttribute('data-option-value');

        // Check if ANY variant with this option value is available
        const hasAvailableVariant = variants.some(variant => {
          const optionKey = 'option' + optionPosition;
          return variant[optionKey] === optionValue && variant.available;
        });

        if (!hasAvailableVariant) {
          btn.setAttribute('data-unavailable', 'true');
        }
      });
    } catch (error) {
      console.error('Error checking variant availability:', error);
    }
  });

  // Variant Selection (size buttons and color swatches)
  section.querySelectorAll('.size-btn, .color-swatch').forEach(button => {
    button.addEventListener('click', function() {
      // Don't allow selection of unavailable variants
      if (this.getAttribute('data-unavailable') === 'true') return;

      const optionGroup = this.closest('.option-group');
      const productCard = this.closest('.product-card-wrapper');
      const addToCartBtn = productCard.querySelector('.add-to-cart-btn');

      // Remove selected from other buttons in this group
      optionGroup.querySelectorAll('.size-btn, .color-swatch').forEach(btn => {
        btn.removeAttribute('data-selected');
      });

      // Mark this button as selected
      this.setAttribute('data-selected', 'true');

      // Get the variant data from the script tag
      const variantDataScript = productCard.querySelector('.variant-data');
      if (!variantDataScript) return;

      try {
        const variants = JSON.parse(variantDataScript.textContent);

        // Get all selected options from ALL option groups
        const selectedOptions = {};
        productCard.querySelectorAll('.size-btn[data-selected="true"], .color-swatch[data-selected="true"]').forEach(selectedBtn => {
          const position = selectedBtn.getAttribute('data-option-position');
          const value = selectedBtn.getAttribute('data-option-value');
          if (position && value) {
            selectedOptions['option' + position] = value;
          }
        });

        // Find matching variant based on all selected options
        let matchingVariant = variants.find(variant => {
          return Object.keys(selectedOptions).every(key => variant[key] === selectedOptions[key]) && variant.available;
        });

        // Fallback: if no available variant matches all options, find any variant with the clicked option
        if (!matchingVariant) {
          const clickedPosition = this.getAttribute('data-option-position');
          const clickedValue = this.getAttribute('data-option-value');
          const optionKey = 'option' + clickedPosition;

          matchingVariant = variants.find(variant =>
            variant[optionKey] === clickedValue && variant.available
          );
        }

        if (matchingVariant) {
          // Update button with new variant ID
          addToCartBtn.setAttribute('data-variant-id', matchingVariant.id);

          // Update price display
          const priceElement = productCard.querySelector('[data-product-price]');
          if (priceElement) {
            priceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.price) : '$' + (matchingVariant.price / 100).toFixed(2);
          }

          // Update compare price if exists
          const comparePriceElement = productCard.querySelector('.price-compare');
          if (comparePriceElement && matchingVariant.compare_at_price) {
            comparePriceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.compare_at_price) : '$' + (matchingVariant.compare_at_price / 100).toFixed(2);
            comparePriceElement.style.display = 'inline';
          } else if (comparePriceElement) {
            comparePriceElement.style.display = 'none';
          }

          // Update product image when color is selected
          if (matchingVariant.featured_image && this.classList.contains('color-swatch')) {
            const productImage = productCard.querySelector('.product-image img');
            if (productImage) {
              let newImageUrl = matchingVariant.featured_image.src;
              newImageUrl = newImageUrl.replace(/(_\d+x\d+)?(\.[^.]+)$/, '_600x600$2');
              productImage.src = newImageUrl;
              productImage.srcset = newImageUrl + ' 600w';
              productImage.alt = matchingVariant.featured_image.alt || matchingVariant.name;
            }
          }
        }
      } catch (error) {
        console.error('Error selecting variant:', error);
      }
    });
  });

  // Add to Cart
  section.querySelectorAll('.add-to-cart-btn').forEach(button => {
    button.addEventListener('click', function() {
      const variantId = this.getAttribute('data-variant-id');

      if (!variantId) {
        alert('Please select a variant');
        return;
      }

      // Show loading state
      const originalContent = this.innerHTML;
      this.innerHTML = '<span>Adding...</span>';
      this.disabled = true;

      // Get cart element
      const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');

      // Prepare form data
      const formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      if (cart) {
        try {
          const sectionsToRender = cart.getSectionsToRender().map((section) => section.id);
          formData.append('sections', sectionsToRender);
          formData.append('sections_url', window.location.pathname);
          cart.setActiveElement(document.activeElement);
        } catch (e) {
          console.log('Cart sections error (non-critical):', e);
        }
      }

      const btn = this;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData
      })
      .then(response => response.json())
      .then(response => {
        if (response.status) {
          throw new Error(response.description || 'Error adding to cart');
        }

        btn.innerHTML = '<span>Added!</span>';

        if (!cart) {
          window.location = '/cart';
          return;
        }

        if (cart.classList.contains('is-empty')) {
          cart.classList.remove('is-empty');
        }

        cart.renderContents(response);

        setTimeout(() => {
          btn.innerHTML = originalContent;
          btn.disabled = false;
        }, 1500);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        btn.innerHTML = originalContent;
        btn.disabled = false;
        alert('Error adding to cart: ' + error.message);
      });
    });
  });

  // Carousel Navigation - Dynamic dots based on visible products
  let dots = [];
  let cardWidth = window.innerWidth <= 768 ? cardWidthMobile : cardWidthDesktop;

  function calculateVisibleCards() {
    const carouselWidth = carousel.clientWidth;
    return Math.floor(carouselWidth / (cardWidth + cardGap)) || 1;
  }

  function generateDots() {
    if (!dotsContainer) return;

    cardWidth = window.innerWidth <= 768 ? cardWidthMobile : cardWidthDesktop;
    const visibleCards = calculateVisibleCards();
    const dotCount = Math.ceil(totalProducts / visibleCards);

    // Clear existing dots
    dotsContainer.innerHTML = '';

    // Generate new dots
    for (let i = 0; i < dotCount; i++) {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === 0 ? ' dot--active' : '');
      dot.setAttribute('data-slide', i);
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    }

    dots = dotsContainer.querySelectorAll('.dot');
  }

  function scrollCarouselBy(direction) {
    const visibleCards = calculateVisibleCards();
    const scrollAmount = (cardWidth + cardGap) * visibleCards;
    carousel.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }

  function goToSlide(index) {
    const visibleCards = calculateVisibleCards();
    const scrollPosition = index * (cardWidth + cardGap) * visibleCards;
    carousel.scrollTo({
      left: scrollPosition,
      behavior: 'smooth'
    });
  }

  function updateActiveDot() {
    if (!dots.length) return;
    const visibleCards = calculateVisibleCards();
    const scrollPerSlide = (cardWidth + cardGap) * visibleCards;
    const currentSlide = Math.round(carousel.scrollLeft / scrollPerSlide);
    dots.forEach((dot, index) => {
      dot.classList.toggle('dot--active', index === currentSlide);
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => scrollCarouselBy(-1));
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => scrollCarouselBy(1));
  }

  carousel.addEventListener('scroll', updateActiveDot);

  // Generate dots on load and resize
  generateDots();
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(generateDots, 150);
  });

  // Auto-scroll functionality
  {% if section.settings.auto_scroll %}
  let animationFrameId = null;
  let isHovered = false;
  let isManuallyControlled = false;
  const autoScrollSpeed = {{ section.settings.auto_scroll_speed }};

  function startAutoScroll() {
    if (animationFrameId) return;

    function animate() {
      if (!isHovered && !isManuallyControlled) {
        carousel.scrollLeft += autoScrollSpeed;

        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        if (carousel.scrollLeft >= maxScroll) {
          carousel.scrollLeft = 0;
        }
      }
      animationFrameId = requestAnimationFrame(animate);
    }

    animationFrameId = requestAnimationFrame(animate);
  }

  function stopAutoScroll() {
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }
  }

  carousel.addEventListener('mouseenter', () => { isHovered = true; });
  carousel.addEventListener('mouseleave', () => { isHovered = false; });
  carousel.addEventListener('touchstart', () => {
    isManuallyControlled = true;
    stopAutoScroll();
  }, { passive: true });

  if (prevBtn) prevBtn.addEventListener('click', () => { isManuallyControlled = true; stopAutoScroll(); });
  if (nextBtn) nextBtn.addEventListener('click', () => { isManuallyControlled = true; stopAutoScroll(); });

  startAutoScroll();
  {% endif %}
})();
</script>

