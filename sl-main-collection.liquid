{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<link rel="preload" href="{{ 'component-rte.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  /* Section Padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Product Grid */
  #SLCollection-{{ section.id }} .sl-product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.grid_gap_mobile }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Reset Dawn's grid__item styles that interfere with our grid */
  #SLCollection-{{ section.id }} .sl-product-grid .grid__item {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #SLCollection-{{ section.id }} .sl-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.grid_gap }}px;
    }
  }

  /* Product Card (regular layout) */
  #SLCollection-{{ section.id }} .sl-product-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  /* Compact Layout - Card has fixed structure, not flex-based */
  #SLCollection-{{ section.id }} .sl-card-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* Card with fixed internal heights for consistency */
  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-product-card {
    display: flex;
    flex-direction: column;
  }

  /* Force consistent image height via aspect ratio */
  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-product-image {
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
  }

  /* Fixed height for title/price area to accommodate 2-line titles */
  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-product-info {
    min-height: 85px;
    flex-grow: 0;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Row 2: Button container */
  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-outside-button {
    padding: 10px 0 8px 0;
  }

  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-outside-button .sl-add-to-cart-btn {
    width: 100%;
    background: {{ section.settings.atc_button_background }};
    color: {{ section.settings.atc_button_text }};
    border: {{ section.settings.atc_button_border_width }}px solid {{ section.settings.atc_button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
  }

  /* Row 3: Variants container - uniform min-height */
  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-outside-variants {
    min-height: {{ section.settings.variant_area_min_height }}px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #SLCollection-{{ section.id }} .sl-card-wrapper .sl-outside-variants .sl-variant-options {
    margin-bottom: 0;
  }

  /* Status Badges */
  #SLCollection-{{ section.id }} .sl-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 2;
    letter-spacing: 0.5px;
  }

  #SLCollection-{{ section.id }} .sl-badge--sale {
    background: {{ section.settings.sale_badge_color }};
    color: #ffffff;
  }

  #SLCollection-{{ section.id }} .sl-badge--soldout {
    background: {{ section.settings.soldout_badge_color }};
    color: #ffffff;
  }

  /* Product Image */
  #SLCollection-{{ section.id }} .sl-product-image {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: {{ section.settings.image_background }};
  }

  #SLCollection-{{ section.id }} .sl-product-image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  #SLCollection-{{ section.id }} .sl-product-image img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.3s ease;
  }

  #SLCollection-{{ section.id }} .sl-product-card:hover .sl-product-image img {
    transform: scale(1.05);
  }

  /* Product Info */
  #SLCollection-{{ section.id }} .sl-product-info {
    padding: 15px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  #SLCollection-{{ section.id }} .sl-product-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 400;
    margin: 0 0 5px 0;
    color: {{ section.settings.title_color }};
    line-height: 1.3;
    min-height:45px;
  }

  #SLCollection-{{ section.id }} .sl-product-title a {
    color: inherit;
    text-decoration: none;
  }

  #SLCollection-{{ section.id }} .sl-product-title a:hover {
    opacity: 0.8;
  }

  /* Price */
  #SLCollection-{{ section.id }} .sl-product-price {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }

  #SLCollection-{{ section.id }} .sl-price-current {
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.price_color }};
    font-weight: 500;
  }

  #SLCollection-{{ section.id }} .sl-price-compare {
    font-size: {{ section.settings.price_font_size }}px;
    color: {{ section.settings.compare_price_color }};
    text-decoration: line-through;
  }

  /* Variant Options */
  #SLCollection-{{ section.id }} .sl-variant-options {
    margin-bottom: 15px;
    min-height: {{ section.settings.variant_area_min_height }}px;
  }

  /* Spacer for products without variants to maintain consistent card height */
  #SLCollection-{{ section.id }} .sl-variant-spacer {
    min-height: {{ section.settings.variant_area_min_height }}px;
    margin-bottom: 15px;
  }

  #SLCollection-{{ section.id }} .sl-option-group {
    margin-bottom: 8px;
  }

  #SLCollection-{{ section.id }} .sl-option-values {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  /* Size Buttons */
  #SLCollection-{{ section.id }} .sl-size-btn {
    padding: 4px 12px;
    border: {{ section.settings.variant_border_width }}px solid {{ section.settings.variant_border_color }};
    background: {{ section.settings.variant_background }};
    color: {{ section.settings.variant_text_color }};
    border-radius: {{ section.settings.variant_border_radius }}px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  #SLCollection-{{ section.id }} .sl-size-btn:hover {
    border-color: {{ section.settings.variant_hover_border }};
  }

  #SLCollection-{{ section.id }} .sl-size-btn[data-selected="true"] {
    background: {{ section.settings.variant_selected_background }};
    color: {{ section.settings.variant_selected_text }};
    border-color: {{ section.settings.variant_selected_border }};
  }

  #SLCollection-{{ section.id }} .sl-size-btn[data-unavailable="true"] {
    opacity: 0.4;
    cursor: not-allowed;
    position: relative;
  }

  #SLCollection-{{ section.id }} .sl-size-btn[data-unavailable="true"]::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transform: rotate(-15deg);
  }

  /* Color Swatches */
  #SLCollection-{{ section.id }} .sl-color-swatch {
    width: {{ section.settings.swatch_size }}px;
    height: {{ section.settings.swatch_size }}px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
  }

  #SLCollection-{{ section.id }} .sl-color-swatch:hover {
    transform: scale(1.1);
  }

  #SLCollection-{{ section.id }} .sl-color-swatch[data-selected="true"] {
    border-color: {{ section.settings.swatch_selected_border }};
    box-shadow: 0 0 0 2px {{ section.settings.swatch_selected_border }};
  }

  #SLCollection-{{ section.id }} .sl-color-swatch[data-unavailable="true"] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* More Options Link */
  #SLCollection-{{ section.id }} .sl-more-options {
    font-size: 12px;
    color: {{ section.settings.variant_text_color }};
    text-decoration: none;
    opacity: 0.8;
    padding: 4px 8px;
  }

  #SLCollection-{{ section.id }} .sl-more-options:hover {
    text-decoration: underline;
    opacity: 1;
  }

  /* Action Buttons */
  #SLCollection-{{ section.id }} .sl-product-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }

  #SLCollection-{{ section.id }} .sl-add-to-cart-btn {
    width: 100%;
    padding: 12px 16px;
    background: {{ section.settings.atc_button_background }};
    color: {{ section.settings.atc_button_text }};
    border: {{ section.settings.atc_button_border_width }}px solid {{ section.settings.atc_button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }

  #SLCollection-{{ section.id }} .sl-add-to-cart-btn:hover {
    opacity: 0.9;
  }

  #SLCollection-{{ section.id }} .sl-add-to-cart-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #SLCollection-{{ section.id }} .sl-subscribe-btn {
    width: 100%;
    padding: 12px 16px;
    background: {{ section.settings.subscribe_button_background }};
    color: {{ section.settings.subscribe_button_text }};
    border: {{ section.settings.subscribe_button_border_width }}px solid {{ section.settings.subscribe_button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    text-decoration: none;
    text-align: center;
    display: block;
  }

  #SLCollection-{{ section.id }} .sl-subscribe-btn:hover {
    opacity: 0.9;
  }

  /* Promo Card */
  #SLCollection-{{ section.id }} .sl-promo-card {
    background: {{ section.settings.promo_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px 20px;
    min-height: 100%;
  }

  #SLCollection-{{ section.id }} .sl-promo-card img {
    max-width: 100%;
    height: auto;
    margin-bottom: 15px;
  }

  #SLCollection-{{ section.id }} .sl-promo-title {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 10px 0;
    color: {{ section.settings.promo_text_color }};
  }

  #SLCollection-{{ section.id }} .sl-promo-text {
    font-size: 14px;
    color: {{ section.settings.promo_text_color }};
    margin: 0 0 20px 0;
    opacity: 0.9;
  }

  #SLCollection-{{ section.id }} .sl-promo-btn {
    display: inline-block;
    padding: 12px 24px;
    background: {{ section.settings.promo_button_background }};
    color: {{ section.settings.promo_button_text }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }

  #SLCollection-{{ section.id }} .sl-promo-btn:hover {
    opacity: 0.9;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 749px) {
    #SLCollection-{{ section.id }} .sl-product-info {
      padding: 12px;
    }

    #SLCollection-{{ section.id }} .sl-product-title {
min-height:40px;
    }

    #SLCollection-{{ section.id }} .sl-product-title {
      font-size: {{ section.settings.title_font_size | minus: 2 }}px;
    }

    #SLCollection-{{ section.id }} .sl-promo-card {
      padding: 20px 15px;
    }

    #SLCollection-{{ section.id }} .sl-promo-title {
      font-size: 20px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" id="SLCollection-{{ section.id }}">
  {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
    {{ 'component-facets.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

    <div class="page-width" id="main-collection-filters" data-id="{{ section.id }}">
      {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting, collapse_on_larger_devices: section.settings.collapse_on_larger_devices %}
    </div>
  {%- endif -%}

  <div id="ProductGridContainer">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
          <div class="loading-overlay gradient"></div>
          <div class="title-wrapper center">
            <h2 class="title title--primary">
              {{ 'sections.collection_template.empty' | t }}<br>
              {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}
            </h2>
          </div>
        </div>
      {%- else -%}
        <div class="collection page-width">
          <div class="loading-overlay gradient"></div>

          <ul class="sl-product-grid" id="product-grid" data-id="{{ section.id }}">
            {%- assign product_index = 0 -%}
            {%- for product in collection.products -%}
              {%- assign product_index = product_index | plus: 1 -%}

              {%- comment -%} Check if a promo card should appear at this position {%- endcomment -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'promo_card' and block.settings.position == product_index -%}
                  <li class="grid__item" {{ block.shopify_attributes }}>
                    <div class="sl-promo-card">
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | img_url: '400x400' }}"
                             alt="{{ block.settings.title | escape }}"
                             loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        <h3 class="sl-promo-title">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <p class="sl-promo-text">{{ block.settings.text }}</p>
                      {%- endif -%}
                      {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                        <a href="{{ block.settings.button_link }}" class="sl-promo-btn">
                          {{ block.settings.button_text }}
                        </a>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}

              {%- liquid
                comment
                  Check if this collection uses compact layout
                endcomment
                assign is_compact_layout = false
                if section.settings.compact_layout_collections != blank
                  assign compact_handles = section.settings.compact_layout_collections | split: ','
                  for handle in compact_handles
                    assign clean_handle = handle | strip | downcase
                    if collection.handle == clean_handle
                      assign is_compact_layout = true
                      break
                    endif
                  endfor
                endif
              -%}

              <li class="grid__item">
                {%- if is_compact_layout -%}
                  {%- comment -%} COMPACT LAYOUT - Card contains only image/title/price {%- endcomment -%}
                  <div class="sl-card-wrapper" data-product-id="{{ product.id }}">
                    <div class="sl-product-card">
                      {%- if product.available == false -%}
                        <span class="sl-badge sl-badge--soldout">{{ section.settings.soldout_text }}</span>
                      {%- elsif product.compare_at_price > product.price -%}
                        <span class="sl-badge sl-badge--sale">{{ section.settings.sale_text }}</span>
                      {%- endif -%}

                      <div class="sl-product-image">
                        <a href="{{ product.url }}">
                          {%- if product.featured_image -%}
                            <img src="{{ product.featured_image | img_url: '600x600' }}"
                                 alt="{{ product.featured_image.alt | escape }}"
                                 loading="{% if product_index <= 4 %}eager{% else %}lazy{% endif %}"
                                 width="600"
                                 height="600">
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {%- endif -%}
                        </a>
                      </div>

                      <div class="sl-product-info">
                        <h3 class="sl-product-title">
                          <a href="{{ product.url }}">{{ product.title }}</a>
                        </h3>
                        <div class="sl-product-price">
                          {%- if product.compare_at_price > product.price -%}
                            <span class="sl-price-compare">{{ product.compare_at_price | money }}</span>
                          {%- endif -%}
                          <span class="sl-price-current" data-product-price>{{ product.price | money }}</span>
                        </div>
                      </div>
                    </div>

                    {%- comment -%} Row 2: Button {%- endcomment -%}
                    <div class="sl-outside-button">
                      {%- if section.settings.show_add_to_cart -%}
                        {%- if product.available -%}
                          <button type="button"
                                  class="sl-add-to-cart-btn"
                                  data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                            {{ section.settings.add_to_cart_text }}
                          </button>
                        {%- else -%}
                          <button type="button" class="sl-add-to-cart-btn" disabled>
                            {{ section.settings.soldout_button_text }}
                          </button>
                        {%- endif -%}
                      {%- endif -%}
                    </div>

                    {%- comment -%} Row 3: Variants (always present for uniform spacing) {%- endcomment -%}
                    <div class="sl-outside-variants">
                      {%- if section.settings.show_variants and product.has_only_default_variant == false -%}
                        <div class="sl-variant-options">
                          <script type="application/json" class="sl-variant-data">
                            {{ product.variants | json }}
                          </script>
                          {%- for option in product.options_with_values -%}
                            {%- assign option_name_lower = option.name | downcase -%}
                            {%- assign is_color = false -%}
                            {%- if option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
                              {%- assign is_color = true -%}
                            {%- endif -%}
                            <div class="sl-option-group" data-option-type="{% if is_color %}color{% else %}size{% endif %}">
                              <div class="sl-option-values">
                                {%- assign max_visible = section.settings.max_visible_variants -%}
                                {%- assign total_values = option.values.size -%}
                                {%- assign remaining = total_values | minus: max_visible -%}
                                {%- for value in option.values -%}
                                  {%- if is_color -%}
                                    <button type="button"
                                            class="sl-color-swatch"
                                            data-option-position="{{ option.position }}"
                                            data-option-value="{{ value | escape }}"
                                            style="background-color:{%- assign matching_color = product.metafields.shopify.color-pattern.value | where: "label", value | first -%}
{{ matching_color.color }}
;"
                                            title="{{ value }}"
                                            {% if forloop.first %}data-selected="true"{% endif %}>
                                    </button>
                                    <p>


</p>
                                  {%- else -%}
                                    {%- if forloop.index <= max_visible -%}
                                      <button type="button"
                                              class="sl-size-btn"
                                              data-option-position="{{ option.position }}"
                                              data-option-value="{{ value | escape }}"
                                              {% if forloop.first %}data-selected="true"{% endif %}>
                                        {{ value }}
                                      </button>
                                    {%- endif -%}
                                  {%- endif -%}
                                {%- endfor -%}
                                {%- if remaining > 0 and is_color == false -%}
                                  <a href="{{ product.url }}" class="sl-more-options">+{{ remaining }} More</a>
                                {%- endif -%}
                              </div>
                            </div>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  {%- comment -%} REGULAR LAYOUT - Full card with all elements inside {%- endcomment -%}
                  <div class="sl-product-card" data-product-id="{{ product.id }}">
                    {%- if product.available == false -%}
                      <span class="sl-badge sl-badge--soldout">{{ section.settings.soldout_text }}</span>
                    {%- elsif product.compare_at_price > product.price -%}
                      <span class="sl-badge sl-badge--sale">{{ section.settings.sale_text }}</span>
                    {%- endif -%}

                    <div class="sl-product-image">
                      <a href="{{ product.url }}">
                        {%- if product.featured_image -%}
                          <img src="{{ product.featured_image | img_url: '600x600' }}"
                               alt="{{ product.featured_image.alt | escape }}"
                               loading="{% if product_index <= 4 %}eager{% else %}lazy{% endif %}"
                               width="600"
                               height="600">
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </a>
                    </div>

                    <div class="sl-product-info">
                      <h3 class="sl-product-title">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>
                      <div class="sl-product-price">
                        {%- if product.compare_at_price > product.price -%}
                          <span class="sl-price-compare">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="sl-price-current" data-product-price>{{ product.price | money }}</span>
                      </div>

                    {%- comment -%} Variant Options {%- endcomment -%}
                    {%- if section.settings.show_variants and product.has_only_default_variant == false -%}
                      <div class="sl-variant-options">
                        <script type="application/json" class="sl-variant-data">
                          {{ product.variants | json }}
                        </script>

                        {%- for option in product.options_with_values -%}
                          {%- assign option_name_lower = option.name | downcase -%}
                          {%- assign is_color = false -%}
                          {%- if option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
                            {%- assign is_color = true -%}
                          {%- endif -%}

                          <div class="sl-option-group" data-option-type="{% if is_color %}color{% else %}size{% endif %}">
                            <div class="sl-option-values">
                              {%- assign max_visible = section.settings.max_visible_variants -%}
                              {%- assign total_values = option.values.size -%}
                              {%- assign remaining = total_values | minus: max_visible -%}

                              {%- for value in option.values -%}
                                {%- if is_color -%}
                                  <button type="button"
                                          class="sl-color-swatch"
                                          data-option-position="{{ option.position }}"
                                          data-option-value="{{ value | escape }}"
                                          style="background-color: {{ value | handleize }};"
                                          title="{{ value }}"
                                          {% if forloop.first %}data-selected="true"{% endif %}>
                                  </button>
                                {%- else -%}
                                  {%- if forloop.index <= max_visible -%}
                                    <button type="button"
                                            class="sl-size-btn"
                                            data-option-position="{{ option.position }}"
                                            data-option-value="{{ value | escape }}"
                                            {% if forloop.first %}data-selected="true"{% endif %}>
                                      {{ value }}
                                    </button>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}

                              {%- if remaining > 0 and is_color == false -%}
                                <a href="{{ product.url }}" class="sl-more-options">+{{ remaining }} More</a>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- elsif section.settings.show_variants -%}
                      {%- comment -%} Spacer for products without variants to maintain equal height {%- endcomment -%}
                      <div class="sl-variant-spacer"></div>
                    {%- endif -%}

                    {%- comment -%} Action Buttons {%- endcomment -%}
                    {%- if section.settings.show_add_to_cart or section.settings.show_subscribe -%}
                      <div class="sl-product-actions">
                        {%- if section.settings.show_add_to_cart -%}
                          {%- if product.available -%}
                            <button type="button"
                                    class="sl-add-to-cart-btn"
                                    data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                              {{ section.settings.add_to_cart_text }}
                            </button>
                          {%- else -%}
                            <button type="button" class="sl-add-to-cart-btn" disabled>
                              {{ section.settings.soldout_button_text }}
                            </button>
                          {%- endif -%}
                        {%- endif -%}

                        {%- liquid
                          assign show_subscribe_btn = false
                          if section.settings.show_subscribe and product.available
                            assign show_subscribe_btn = true
                            if section.settings.subscribe_exclude_collections != blank
                              assign excluded_handles = section.settings.subscribe_exclude_collections | split: ','
                              for handle in excluded_handles
                                assign clean_handle = handle | strip | downcase
                                if collection.handle == clean_handle
                                  assign show_subscribe_btn = false
                                  break
                                endif
                              endfor
                            endif
                          endif
                        -%}
                        {%- if show_subscribe_btn -%}
                          <a href="{{ product.url }}?subscribe=true"
                             class="sl-subscribe-btn"
                             data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                            {{ section.settings.subscribe_text }}
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('SLCollection-' + sectionId);
  if (!section) return;

  // Mark unavailable variants on page load
  // Use [data-product-id] to match both regular (.sl-product-card) and compact (.sl-card-wrapper) layouts
  section.querySelectorAll('[data-product-id]').forEach(productContainer => {
    const variantDataScript = productContainer.querySelector('.sl-variant-data');
    if (!variantDataScript) return;

    try {
      const variants = JSON.parse(variantDataScript.textContent);

      productContainer.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(btn => {
        const optionPosition = parseInt(btn.getAttribute('data-option-position'));
        const optionValue = btn.getAttribute('data-option-value');

        const hasAvailableVariant = variants.some(variant => {
          const optionKey = 'option' + optionPosition;
          return variant[optionKey] === optionValue && variant.available;
        });

        if (!hasAvailableVariant) {
          btn.setAttribute('data-unavailable', 'true');
        }
      });
    } catch (error) {
      console.error('Error checking variant availability:', error);
    }
  });

  // Variant Selection
  section.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(button => {
    button.addEventListener('click', function() {
      if (this.getAttribute('data-unavailable') === 'true') return;

      const optionGroup = this.closest('.sl-option-group');
      // Use [data-product-id] to find container - works for both regular and compact layouts
      const productContainer = this.closest('[data-product-id]');
      const addToCartBtn = productContainer.querySelector('.sl-add-to-cart-btn');
      const subscribeBtn = productContainer.querySelector('.sl-subscribe-btn');

      // Remove selected from other buttons in this group
      optionGroup.querySelectorAll('.sl-size-btn, .sl-color-swatch').forEach(btn => {
        btn.removeAttribute('data-selected');
      });

      // Mark this button as selected
      this.setAttribute('data-selected', 'true');

      // Get variant data
      const variantDataScript = productContainer.querySelector('.sl-variant-data');
      if (!variantDataScript) return;

      try {
        const variants = JSON.parse(variantDataScript.textContent);

        // Get all selected options
        const selectedOptions = {};
        productContainer.querySelectorAll('.sl-size-btn[data-selected="true"], .sl-color-swatch[data-selected="true"]').forEach(selectedBtn => {
          const position = selectedBtn.getAttribute('data-option-position');
          const value = selectedBtn.getAttribute('data-option-value');
          if (position && value) {
            selectedOptions['option' + position] = value;
          }
        });

        // Find matching variant
        let matchingVariant = variants.find(variant => {
          return Object.keys(selectedOptions).every(key => variant[key] === selectedOptions[key]) && variant.available;
        });

        // Fallback
        if (!matchingVariant) {
          const clickedPosition = this.getAttribute('data-option-position');
          const clickedValue = this.getAttribute('data-option-value');
          const optionKey = 'option' + clickedPosition;

          matchingVariant = variants.find(variant =>
            variant[optionKey] === clickedValue && variant.available
          );
        }

        if (matchingVariant) {
          // Update add to cart button
          if (addToCartBtn) {
            addToCartBtn.setAttribute('data-variant-id', matchingVariant.id);
          }

          // Update subscribe button with variant parameter
          if (subscribeBtn) {
            const baseUrl = subscribeBtn.href.split('?')[0];
            subscribeBtn.href = baseUrl + '?variant=' + matchingVariant.id + '&subscribe=true';
            subscribeBtn.setAttribute('data-variant-id', matchingVariant.id);
          }

          // Update price
          const priceElement = productContainer.querySelector('[data-product-price]');
          if (priceElement) {
            priceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.price) : '$' + (matchingVariant.price / 100).toFixed(2);
          }

          // Update compare price
          const comparePriceElement = productContainer.querySelector('.sl-price-compare');
          if (comparePriceElement && matchingVariant.compare_at_price) {
            comparePriceElement.textContent = Shopify.formatMoney ? Shopify.formatMoney(matchingVariant.compare_at_price) : '$' + (matchingVariant.compare_at_price / 100).toFixed(2);
            comparePriceElement.style.display = 'inline';
          } else if (comparePriceElement) {
            comparePriceElement.style.display = 'none';
          }

          // Update product image when color is selected
          if (matchingVariant.featured_image && this.classList.contains('sl-color-swatch')) {
            const productImage = productContainer.querySelector('.sl-product-image img');
            if (productImage) {
              // Get the image URL and replace size parameter for better quality
              let newImageUrl = matchingVariant.featured_image.src;
              // Use 600x600 for consistency with initial load
              newImageUrl = newImageUrl.replace(/(_\d+x\d+)?(\.[^.]+)$/, '_600x600$2');
              productImage.src = newImageUrl;
              productImage.srcset = newImageUrl + ' 600w';
              productImage.alt = matchingVariant.featured_image.alt || matchingVariant.name;
            }
          }
        }
      } catch (error) {
        console.error('Error selecting variant:', error);
      }
    });
  });

  // Add to Cart
  section.querySelectorAll('.sl-add-to-cart-btn').forEach(button => {
    button.addEventListener('click', function() {
      const variantId = this.getAttribute('data-variant-id');

      if (!variantId) {
        alert('Please select a variant');
        return;
      }

      const originalContent = this.innerHTML;
      this.innerHTML = 'Adding...';
      this.disabled = true;

      const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      const formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', '1');

      if (cart) {
        try {
          const sectionsToRender = cart.getSectionsToRender().map((section) => section.id);
          formData.append('sections', sectionsToRender);
          formData.append('sections_url', window.location.pathname);
          cart.setActiveElement(document.activeElement);
        } catch (e) {
          console.log('Cart sections error:', e);
        }
      }

      const btn = this;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
      })
      .then(response => response.json())
      .then(response => {
        if (response.status) {
          throw new Error(response.description || 'Error adding to cart');
        }

        btn.innerHTML = 'Added!';

        if (!cart) {
          window.location = '/cart';
          return;
        }

        if (cart.classList.contains('is-empty')) {
          cart.classList.remove('is-empty');
        }

        cart.renderContents(response);

        setTimeout(() => {
          btn.innerHTML = originalContent;
          btn.disabled = false;
        }, 1500);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        btn.innerHTML = originalContent;
        btn.disabled = false;
        alert('Error: ' + error.message);
      });
    });
  });
})();
</script>

{%- comment -%} Move Globo search bar inline after the summary span (desktop only) {%- endcomment -%}
<script>
(function() {
  var isDesktop = window.matchMedia('(min-width: 990px)').matches;

  if (!isDesktop) return;

  function moveSearchBar() {
    var searchForm = document.querySelector('#gf-controls-container > .gf-controls-search-form');
    var gfSummary = document.querySelector('#gf-controls-container .gf-summary');

    if (searchForm && gfSummary) {
      gfSummary.after(searchForm);
      return true;
    }
    return false;
  }

  function observeForGloboElements() {
    var observer = new MutationObserver(function(mutations, obs) {
      if (moveSearchBar()) {
        obs.disconnect();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    // Timeout fallback - stop observing after 10 seconds
    setTimeout(function() {
      observer.disconnect();
    }, 10000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      if (!moveSearchBar()) {
        observeForGloboElements();
      }
    });
  } else {
    if (!moveSearchBar()) {
      observeForGloboElements();
    }
  }
})();
</script>

