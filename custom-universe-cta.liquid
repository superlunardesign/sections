<!-- Custom Universe CTA Section -->
<div id="CustomUniverseCTA-{{ section.id }}" class="custom-universe-cta">
  <!-- Background Image -->
  <div class="universe-background">
    {% if section.settings.background_image != blank %}
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        srcset="{{ section.settings.background_image | image_url: width: 800 }} 800w,
                {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.background_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy"
        class="universe-background__image"
      >
    {% endif %}
    <div class="universe-background__overlay"></div>
  </div>

  <!-- Content Container -->
  <div class="universe-container">
    <div class="universe-layout">
      <!-- Character Image -->
      <div class="universe-characters">
        {% if section.settings.character_image != blank %}
          <img
            src="{{ section.settings.character_image | image_url: width: 800 }}"
            srcset="{{ section.settings.character_image | image_url: width: 400 }} 400w,
                    {{ section.settings.character_image | image_url: width: 600 }} 600w,
                    {{ section.settings.character_image | image_url: width: 800 }} 800w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.character_image.alt | escape | default: 'Characters' }}"
            loading="lazy"
            class="universe-characters__image"
          >
        {% else %}
          <div class="universe-characters__placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <!-- Content -->
      <div class="universe-content">
        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }} class="universe-heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="universe-text">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="universe-button"
            {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_text }}
            {% if section.settings.show_button_arrow %}
              <span class="universe-button__arrow">→</span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  /* =============================================
     CUSTOM UNIVERSE CTA - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CustomUniverseCTA-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.section_height }}px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* Background */
  #CustomUniverseCTA-{{ section.id }} .universe-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: {{ section.settings.background_color }};
  }

  #CustomUniverseCTA-{{ section.id }} .universe-background__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position }};
  }

  #CustomUniverseCTA-{{ section.id }} .universe-background__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  /* Container */
  #CustomUniverseCTA-{{ section.id }} .universe-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
  }

  /* Layout */
  #CustomUniverseCTA-{{ section.id }} .universe-layout {
    display: grid;
    grid-template-columns: {{ section.settings.image_width }}% 1fr;
    gap: {{ section.settings.column_gap }}px;
    align-items: end;
  }

  /* Character Image */
  #CustomUniverseCTA-{{ section.id }} .universe-characters {
    position: relative;
    align-self: end;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-characters__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: {{ section.settings.character_max_height }}px;
    object-fit: contain;
    object-position: bottom center;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-characters__placeholder {
    width: 100%;
    height: 300px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0.3;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-characters__placeholder .placeholder-svg {
    width: 80%;
    height: 80%;
  }

  /* Content */
  #CustomUniverseCTA-{{ section.id }} .universe-content {
    padding: {{ section.settings.content_padding_top }}px 0 {{ section.settings.content_padding_bottom }}px;
    align-self: center;
  }

  /* Heading */
  #CustomUniverseCTA-{{ section.id }} .universe-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    font-style: {{ section.settings.heading_font_style }};
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
  }

  /* Text */
  #CustomUniverseCTA-{{ section.id }} .universe-text {
    font-size: {{ section.settings.text_font_size }}px;
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.text_line_height }};
    margin: 0 0 {{ section.settings.text_margin_bottom }}px 0;
    max-width: {{ section.settings.text_max_width }}px;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-text p {
    margin: 0;
  }

  /* Button */
  #CustomUniverseCTA-{{ section.id }} .universe-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-button:hover {
    background-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  #CustomUniverseCTA-{{ section.id }} .universe-button[aria-disabled="true"] {
    pointer-events: none;
    opacity: 0.6;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-button__arrow {
    transition: transform 0.3s ease;
  }

  #CustomUniverseCTA-{{ section.id }} .universe-button:hover .universe-button__arrow {
    transform: translateX(4px);
  }

  /* Tablet Styles */
  @media (max-width: 990px) {
    #CustomUniverseCTA-{{ section.id }} {
      min-height: auto;
      align-items: stretch;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-layout {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-content {
      order: 1;
      padding: {{ section.settings.content_padding_top_mobile }}px {{ section.settings.horizontal_padding_mobile }}px 0;
      text-align: {{ section.settings.mobile_text_align }};
    }

    #CustomUniverseCTA-{{ section.id }} .universe-characters {
      order: 2;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-container {
      padding: 0;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-text {
      max-width: 100%;
      {% if section.settings.mobile_text_align == 'center' %}
      margin-left: auto;
      margin-right: auto;
      {% endif %}
    }

    {% if section.settings.mobile_text_align == 'center' %}
    #CustomUniverseCTA-{{ section.id }} .universe-button {
      margin-left: auto;
      margin-right: auto;
    }
    {% endif %}
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CustomUniverseCTA-{{ section.id }} .universe-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-text {
      font-size: {{ section.settings.text_font_size_mobile }}px;
    }

    #CustomUniverseCTA-{{ section.id }} .universe-characters__image {
      max-height: {{ section.settings.character_max_height_mobile }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Custom Universe CTA",
  "tag": "section",
  "class": "custom-universe-cta-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
