<!-- Custom Logo Marquee Section -->
<div id="CustomLogoMarquee-{{ section.id }}" class="custom-logo-marquee">
  {% if section.settings.show_top_bar %}
    <div class="marquee-top-bar"></div>
  {% endif %}

  <div class="marquee-container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="marquee-header">
        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }} class="marquee-heading">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="marquee-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="marquee-wrapper">
      <div class="marquee-track" data-direction="{{ section.settings.animation_direction }}">
        <!-- First set of logos -->
        <div class="marquee-content">
          {% for block in section.blocks %}
            <div class="marquee-item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="marquee-link" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
              {% endif %}

              {% if block.settings.logo != blank %}
                <img
                  src="{{ block.settings.logo | image_url: height: 200 }}"
                  alt="{{ block.settings.logo.alt | default: block.settings.alt_text | escape }}"
                  loading="lazy"
                  class="marquee-logo"
                >
              {% else %}
                <div class="marquee-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <!-- Duplicate for seamless loop -->
        <div class="marquee-content" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="marquee-item">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="marquee-link" tabindex="-1" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
              {% endif %}

              {% if block.settings.logo != blank %}
                <img
                  src="{{ block.settings.logo | image_url: height: 200 }}"
                  alt=""
                  loading="lazy"
                  class="marquee-logo"
                >
              {% else %}
                <div class="marquee-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.show_bottom_bar %}
    <div class="marquee-bottom-bar"></div>
  {% endif %}
</div>

{%- style -%}
  /* =============================================
     CUSTOM LOGO MARQUEE - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CustomLogoMarquee-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
  }

  /* Top/Bottom Bars */
  #CustomLogoMarquee-{{ section.id }} .marquee-top-bar {
    height: {{ section.settings.bar_height }}px;
    background-color: {{ section.settings.bar_color }};
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-bottom-bar {
    height: {{ section.settings.bar_height }}px;
    background-color: {{ section.settings.bar_color }};
  }

  /* Container */
  #CustomLogoMarquee-{{ section.id }} .marquee-container {
    padding: {{ section.settings.padding_top }}px {{ section.settings.horizontal_padding }}px {{ section.settings.padding_bottom }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Header */
  #CustomLogoMarquee-{{ section.id }} .marquee-header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    font-style: {{ section.settings.heading_font_style }};
    color: {{ section.settings.heading_color }};
    text-transform: {{ section.settings.heading_text_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-subheading {
    font-size: {{ section.settings.subheading_font_size }}px;
    font-weight: {{ section.settings.subheading_font_weight }};
    color: {{ section.settings.subheading_color }};
    text-transform: {{ section.settings.subheading_text_transform }};
    letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
    margin: 0;
    line-height: 1.4;
  }

  /* Marquee Wrapper */
  #CustomLogoMarquee-{{ section.id }} .marquee-wrapper {
    overflow: hidden;
    position: relative;
  }

  /* Marquee Track */
  #CustomLogoMarquee-{{ section.id }} .marquee-track {
    display: flex;
    width: fit-content;
    animation: marqueeScroll-{{ section.id }} {{ section.settings.animation_duration }}s linear infinite;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-track[data-direction="right"] {
    animation-direction: reverse;
  }

  {% if section.settings.pause_on_hover %}
  #CustomLogoMarquee-{{ section.id }} .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }
  {% endif %}

  @keyframes marqueeScroll-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Marquee Content */
  #CustomLogoMarquee-{{ section.id }} .marquee-content {
    display: flex;
    align-items: center;
    gap: {{ section.settings.logo_gap }}px;
    padding-right: {{ section.settings.logo_gap }}px;
  }

  /* Marquee Item */
  #CustomLogoMarquee-{{ section.id }} .marquee-item {
    flex-shrink: 0;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-link {
    display: block;
    transition: opacity 0.3s ease;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-link:hover {
    opacity: {{ section.settings.logo_hover_opacity }};
  }

  /* Logo Styles */
  #CustomLogoMarquee-{{ section.id }} .marquee-logo {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    display: block;
    object-fit: contain;
    {% if section.settings.logo_filter != 'none' %}
    filter: {{ section.settings.logo_filter }};
    {% endif %}
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-placeholder {
    height: {{ section.settings.logo_height }}px;
    width: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.3;
  }

  #CustomLogoMarquee-{{ section.id }} .marquee-placeholder .placeholder-svg {
    height: 100%;
    width: auto;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CustomLogoMarquee-{{ section.id }} .marquee-container {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.horizontal_padding_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-logo {
      height: {{ section.settings.logo_height_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-placeholder {
      height: {{ section.settings.logo_height_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-content {
      gap: {{ section.settings.logo_gap_mobile }}px;
      padding-right: {{ section.settings.logo_gap_mobile }}px;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-top-bar,
    #CustomLogoMarquee-{{ section.id }} .marquee-bottom-bar {
      height: {{ section.settings.bar_height_mobile }}px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #CustomLogoMarquee-{{ section.id }} .marquee-track {
      animation: none;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-content[aria-hidden="true"] {
      display: none;
    }

    #CustomLogoMarquee-{{ section.id }} .marquee-content {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Custom Logo Marquee",
  "tag": "section",
  "class": "custom-logo-marquee-section",
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
