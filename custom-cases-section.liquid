<!-- Custom Cases Section (Blog Articles) -->
<div id="CustomCasesSection-{{ section.id }}" class="custom-cases-section">
  <div class="cases-container">
    {% if section.settings.section_title != blank %}
      <h2 class="cases-section-title">{{ section.settings.section_title }}</h2>
    {% endif %}

    <div class="cases-wrapper">
      <div class="cases-carousel">
        {% assign blog = blogs[section.settings.blog] %}
        {% if blog != blank %}
          {% for article in blog.articles limit: section.settings.articles_limit %}
            <a href="{{ article.url }}" class="case-card">
              <!-- Article Image -->
              <div class="case-image">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w,
                            {{ article.image | image_url: width: 600 }} 600w,
                            {{ article.image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 768px) 100vw, 50vw"
                    alt="{{ article.image.alt | escape | default: article.title }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                {% else %}
                  <div class="no-image">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>

              <!-- Article Info -->
              <div class="case-info">
                <h3 class="case-title">{{ article.title }}</h3>

                {% if section.settings.show_excerpt %}
                  <div class="case-excerpt">
                    {% if article.excerpt != blank %}
                      {{ article.excerpt | strip_html | truncate: 500 }}
                    {% else %}
                      {{ article.content | strip_html | truncate: 500 }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        {% else %}
          <!-- Placeholder cards when no blog selected -->
          {% for i in (1..4) %}
            <div class="case-card case-card--placeholder">
              <div class="case-image">
                <div class="no-image">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="case-info">
                <h3 class="case-title">Case Title {{ i }}</h3>
                <div class="case-excerpt">
                  Select a blog in the section settings to display articles here.
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <!-- Navigation: Arrows + Dots together -->
    <div class="cases-navigation">
      <button class="cases-nav-btn cases-nav-btn--prev" aria-label="Previous cases">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {% if section.settings.show_dots %}
        <div class="cases-dots"></div>
      {% endif %}

      <button class="cases-nav-btn cases-nav-btn--next" aria-label="Next cases">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{%- style -%}
  /* =============================================
     CUSTOM CASES SECTION - SCOPED STYLES
     Section ID: {{ section.id }}
     ============================================= */

  #CustomCasesSection-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  #CustomCasesSection-{{ section.id }} .cases-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
  }

  /* Section Title */
  #CustomCasesSection-{{ section.id }} .cases-section-title {
    text-align: {{ section.settings.title_alignment }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    font-style: {{ section.settings.title_font_style }};
    color: {{ section.settings.title_color }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    text-transform: {{ section.settings.title_text_transform }};
    margin: 0 0 {{ section.settings.title_margin_bottom }}px 0;
  }

  /* Carousel Wrapper */
  #CustomCasesSection-{{ section.id }} .cases-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }

  #CustomCasesSection-{{ section.id }} .cases-carousel {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
    justify-content: flex-start;
    max-width: calc(({{ section.settings.card_width }}px * 2) + {{ section.settings.card_gap }}px);
  }

  #CustomCasesSection-{{ section.id }} .cases-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Case Card */
  #CustomCasesSection-{{ section.id }} .case-card {
    flex: 0 0 {{ section.settings.card_width }}px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }

  #CustomCasesSection-{{ section.id }} .case-card:hover {
    transform: translateY(-5px);
  }

  /* Case Image */
  #CustomCasesSection-{{ section.id }} .case-image {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background-color: {{ section.settings.image_background_color }};
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ section.settings.image_margin_bottom }}px;
  }

  #CustomCasesSection-{{ section.id }} .case-image img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  #CustomCasesSection-{{ section.id }} .case-image .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.image_background_color }};
  }

  #CustomCasesSection-{{ section.id }} .case-image .placeholder-svg {
    width: 40%;
    height: 40%;
    opacity: 0.3;
  }

  /* Case Info */
  #CustomCasesSection-{{ section.id }} .case-info {
    padding: {{ section.settings.card_content_padding }}px 0;
  }

  /* Case Title */
  #CustomCasesSection-{{ section.id }} .case-title {
    font-size: {{ section.settings.article_title_font_size }}px;
    font-weight: {{ section.settings.article_title_font_weight }};
    color: {{ section.settings.article_title_color }};
    margin: 0 0 {{ section.settings.article_title_margin_bottom }}px 0;
    line-height: 1.3;
  }

  /* Case Excerpt */
  #CustomCasesSection-{{ section.id }} .case-excerpt {
    font-size: {{ section.settings.excerpt_font_size }}px;
    color: {{ section.settings.excerpt_color }};
    line-height: {{ section.settings.excerpt_line_height }};
    display: -webkit-box;
    -webkit-line-clamp: {{ section.settings.excerpt_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Navigation */
  #CustomCasesSection-{{ section.id }} .cases-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.nav_gap }}px;
    margin-top: {{ section.settings.nav_margin_top }}px;
  }

  #CustomCasesSection-{{ section.id }} .cases-nav-btn {
    background: {{ section.settings.nav_button_background }};
    border: {{ section.settings.nav_button_border_width }}px solid {{ section.settings.nav_button_border_color }};
    border-radius: {{ section.settings.nav_button_border_radius }}px;
    width: {{ section.settings.nav_button_size }}px;
    height: {{ section.settings.nav_button_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: {{ section.settings.nav_button_color }};
    padding: 0;
  }

  #CustomCasesSection-{{ section.id }} .cases-nav-btn:hover {
    background: {{ section.settings.nav_button_hover_background }};
    border-color: {{ section.settings.nav_button_hover_border_color }};
    color: {{ section.settings.nav_button_hover_color }};
  }

  /* Dots */
  #CustomCasesSection-{{ section.id }} .cases-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.dot_gap }}px;
  }

  #CustomCasesSection-{{ section.id }} .dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0.5;
  }

  #CustomCasesSection-{{ section.id }} .dot:hover {
    opacity: 0.8;
  }

  #CustomCasesSection-{{ section.id }} .dot--active {
    background: {{ section.settings.dot_active_color }};
    opacity: 1;
  }

  /* Tablet Styles */
  @media (max-width: 990px) {
    #CustomCasesSection-{{ section.id }} .cases-carousel {
      max-width: calc(({{ section.settings.card_width_tablet }}px * 2) + {{ section.settings.card_gap }}px);
    }

    #CustomCasesSection-{{ section.id }} .case-card {
      flex: 0 0 {{ section.settings.card_width_tablet }}px;
    }

    #CustomCasesSection-{{ section.id }} .cases-container {
      padding: 0 {{ section.settings.horizontal_padding_mobile }}px;
    }

    #CustomCasesSection-{{ section.id }} .cases-section-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #CustomCasesSection-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #CustomCasesSection-{{ section.id }} .cases-carousel {
      max-width: {{ section.settings.card_width_mobile }}px;
    }

    #CustomCasesSection-{{ section.id }} .case-card {
      flex: 0 0 {{ section.settings.card_width_mobile }}px;
    }

    #CustomCasesSection-{{ section.id }} .case-image {
      aspect-ratio: {{ section.settings.image_aspect_ratio_mobile }};
    }

    #CustomCasesSection-{{ section.id }} .case-title {
      font-size: {{ section.settings.article_title_font_size_mobile }}px;
    }

    #CustomCasesSection-{{ section.id }} .case-excerpt {
      font-size: {{ section.settings.excerpt_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('CustomCasesSection-' + sectionId);
  if (!section) return;

  const carousel = section.querySelector('.cases-carousel');
  const prevBtn = section.querySelector('.cases-nav-btn--prev');
  const nextBtn = section.querySelector('.cases-nav-btn--next');
  const dotsContainer = section.querySelector('.cases-dots');

  {% assign blog = blogs[section.settings.blog] %}
  const totalArticles = {% if blog != blank %}{{ blog.articles.size | at_most: section.settings.articles_limit }}{% else %}4{% endif %};
  const cardWidthDesktop = {{ section.settings.card_width }};
  const cardWidthTablet = {{ section.settings.card_width_tablet }};
  const cardWidthMobile = {{ section.settings.card_width_mobile }};
  const cardGap = {{ section.settings.card_gap }};

  let dots = [];

  function getCardWidth() {
    if (window.innerWidth <= 768) return cardWidthMobile;
    if (window.innerWidth <= 990) return cardWidthTablet;
    return cardWidthDesktop;
  }

  function calculateVisibleCards() {
    if (window.innerWidth <= 768) return 1;
    return 2;
  }

  function generateDots() {
    if (!dotsContainer) return;

    const visibleCards = calculateVisibleCards();
    // Number of scroll positions = total articles - visible + 1
    const dotCount = Math.max(1, totalArticles - visibleCards + 1);

    dotsContainer.innerHTML = '';

    for (let i = 0; i < dotCount; i++) {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === 0 ? ' dot--active' : '');
      dot.setAttribute('data-slide', i);
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    }

    dots = dotsContainer.querySelectorAll('.dot');
  }

  // Scroll one card at a time
  function scrollCarouselBy(direction) {
    const cardWidth = getCardWidth();
    const scrollAmount = cardWidth + cardGap;
    carousel.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }

  function goToSlide(index) {
    const cardWidth = getCardWidth();
    const scrollPosition = index * (cardWidth + cardGap);
    carousel.scrollTo({
      left: scrollPosition,
      behavior: 'smooth'
    });
  }

  function updateActiveDot() {
    if (!dots.length) return;
    const cardWidth = getCardWidth();
    const scrollPerCard = cardWidth + cardGap;
    const currentSlide = Math.round(carousel.scrollLeft / scrollPerCard);
    dots.forEach((dot, index) => {
      dot.classList.toggle('dot--active', index === currentSlide);
    });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', () => scrollCarouselBy(-1));
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => scrollCarouselBy(1));
  }

  carousel.addEventListener('scroll', updateActiveDot);

  generateDots();
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(generateDots, 150);
  });
})();
</script>

