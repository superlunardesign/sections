/* ================================================
   SL CUSTOM OVERRIDES
   ================================================ */

/* Z-index: header wrapper sits above announcement bar */
.header-wrapper {
  position: relative;
  z-index: 4;
}

/* Desktop nav: underline hover effect (matching design) */
@media screen and (min-width: 750px) {
  .header--top-center .dt-nav > li > a,
  .header--top-center .dt-nav > li > .dt-sc-nav-link {
    position: relative;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .header--top-center .dt-nav > li > a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .header--top-center .dt-nav > li > a:hover::after,
  .header--top-center .dt-nav > li.active > a::after,
  .header--top-center .dt-nav > li:hover > a::after {
    transform: scaleX(1);
  }
}

/* Mega menu dropdown: must layer above announcement bar */
.dt-nav .sub-menu-lists,
.page-width.mega,
.dt-sc-mega_menu {
  z-index: 10;
}

/* Mega menu panel styling */
@media screen and (min-width: 750px) {
  .dt-nav .sub-menu-lists {
    background: #fff;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }
}

/* ================================================
   MOBILE DRAWER OVERRIDES
   ================================================ */

/* Drawer overlay — lower z-index so drawer sits on top */
#Details-menu-drawer-container[open]::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 199;
}

/* Drawer container — must be above overlay */
#menu-drawer {
  background: #fff !important;
  z-index: 200 !important;
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: auto !important;
  width: 85vw !important;
  max-width: 400px !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  box-sizing: border-box !important;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}

#menu-drawer * {
  box-sizing: border-box;
  max-width: 100%;
}

/* When drawer is open (details[open]) */
#Details-menu-drawer-container[open] #menu-drawer {
  transform: translateX(0) !important;
}

.menu-drawer-container {
  position: static;
}

/* Drawer header area with logo and close */
.sl-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
}

.sl-drawer-header .header__heading-logo {
  max-height: 30px;
  width: auto;
}

.sl-drawer-close {
  position: static;
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Mobile drawer inline nav */
.sl-drawer-nav {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sl-drawer-nav__item {
  border-bottom: 1px solid #eee;
}

/* Ensure details/summary accordion works — override any theme interference */
.sl-drawer-nav__details {
  display: block !important;
  width: 100%;
}

.sl-drawer-nav__summary {
  display: flex !important;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 0.04em;
  color: #333;
  text-decoration: none;
  font-family: var(--font-body-family);
  cursor: pointer;
  background: none;
  border: none;
  width: 100%;
  list-style: none;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

.sl-drawer-nav__link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 0.04em;
  color: #333;
  text-decoration: none;
  font-family: var(--font-body-family);
  cursor: pointer;
  background: none;
  border: none;
  width: 100%;
}

.sl-drawer-nav__summary::-webkit-details-marker {
  display: none;
}

.sl-drawer-nav__summary::marker {
  display: none;
  content: '';
}

.sl-drawer-nav__chevron {
  transition: transform 0.3s ease;
  flex-shrink: 0;
  pointer-events: none;
}

.sl-drawer-nav__details[open] > .sl-drawer-nav__summary .sl-drawer-nav__chevron {
  transform: rotate(180deg);
}

/* Submenu: hidden by default, shown when details is open */
.sl-drawer-nav__details:not([open]) .sl-drawer-submenu {
  display: none !important;
}

.sl-drawer-nav__details[open] .sl-drawer-submenu {
  display: block !important;
}

.sl-drawer-submenu {
  list-style: none;
  margin: 0;
  padding: 0;
  background: #fafafa;
}

.sl-drawer-submenu li a {
  display: block;
  padding: 12px 20px 12px 32px;
  font-size: 14px;
  color: #333;
  text-decoration: none;
  font-family: var(--font-body-family);
  border-top: 1px solid #f0f0f0;
}

.sl-drawer-submenu li a:hover {
  opacity: 0.7;
}

/* Mobile CTA button at bottom of drawer */
.sl-drawer-cta {
  display: block;
  text-align: center;
  padding: 14px 24px;
  border: 1px solid #333;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 13px;
  font-family: var(--font-body-family);
  text-decoration: none;
  color: #333;
  margin: 24px 20px 0;
  transition: background-color 0.2s, color 0.2s;
}

.sl-drawer-cta:hover {
  background-color: #333;
  color: #fff;
}

/* ================================================
   SL DESKTOP NAVIGATION & MEGA MENU
   ================================================ */

/* Cursor pointer for all clickable elements */
a, button, summary, [role="button"], .sl-nav__link, .sl-dropdown__list a,
.sl-mega-menu__col a, .sl-mega-menu__promo a, .sl-mega-menu__featured a,
.sl-preheader a, .sl-drawer-cta, .header__icon, .header__heading-link {
  cursor: pointer;
}

/* Nav container — must be static so mega menu can position from header-wrapper */
.sl-main-nav {
  grid-area: navigation;
  width: 100%;
  position: static;
}

.sl-nav__list {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
}

.sl-nav__item {
  position: static;
}

/* Simple dropdown needs relative parent */
.sl-nav__item--has-dropdown:not(.sl-nav__item--mega) {
  position: relative;
}

.sl-nav__link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 12px 20px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-decoration: none;
  position: relative;
  transition: opacity 0.2s;
  white-space: nowrap;
  cursor: pointer;
}

/* Hover underline on nav items */
.sl-nav__link::after {
  content: '';
  position: absolute;
  bottom: 8px;
  left: 20px;
  right: 20px;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.3s ease;
}

.sl-nav__item:hover > .sl-nav__link::after,
.sl-nav__item.active > .sl-nav__link::after {
  transform: scaleX(1);
}

/* Caret icon */
.sl-nav__caret {
  width: 10px;
  height: 10px;
  transition: transform 0.3s;
}

.sl-nav__item:hover > .sl-nav__link .sl-nav__caret {
  transform: rotate(180deg);
}

/* ---- Simple dropdown ---- */
.sl-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 220px;
  background: #fff;
  box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  border: 1px solid #e5e5e5;
  padding: 8px 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(6px);
  transition: opacity 0.25s, visibility 0.25s, transform 0.25s;
  z-index: 10;
}

.sl-nav__item:hover > .sl-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.sl-dropdown__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sl-dropdown__list li a {
  display: block;
  padding: 8px 24px;
  font-family: var(--font-body-family);
  font-size: 14px;
  color: #333;
  text-decoration: none;
  transition: background-color 0.15s;
  cursor: pointer;
}

.sl-dropdown__list li a:hover {
  background-color: #f7f7f5;
}

/* ---- Mega menu panel ---- */
.sl-mega-menu {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  top: 100%;
  background: #fff;
  border-top: 2px solid #c5c8a0;
  border-bottom: 2px solid #c5c8a0;
  box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  padding: 32px 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(6px);
  transition: opacity 0.25s, visibility 0.25s, transform 0.25s;
  z-index: 10;
}

.sl-nav__item:hover > .sl-mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.sl-mega-menu__inner {
  display: grid;
  grid-template-columns: 200px 1fr 240px;
  gap: 32px;
  align-items: start;
}

/* Mega menu: only featured + links (no promo) */
.sl-mega-menu__inner--no-promo {
  grid-template-columns: 200px 1fr;
}

/* Mega menu: only links + promo (no featured) */
.sl-mega-menu__inner--no-featured {
  grid-template-columns: 1fr 240px;
}

/* Mega menu: links only */
.sl-mega-menu__inner--links-only {
  grid-template-columns: 1fr;
}

/* Featured image (left) — stacked slides, one visible at a time */
.sl-mega-menu__featured {
  position: relative;
  min-height: 180px;
}

.sl-mega-featured__slide {
  display: none;
  text-decoration: none;
  color: #333;
  cursor: pointer;
}

.sl-mega-featured__slide--active {
  display: block;
}

.sl-mega-featured__slide img {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: block;
  object-fit: cover;
  margin-bottom: 8px;
}

.sl-mega-featured__name {
  display: block;
  font-family: var(--font-body-family);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.3;
}

.sl-mega-featured__price {
  display: block;
  font-family: var(--font-body-family);
  font-size: 13px;
  color: #666;
  margin-top: 2px;
}

/* Link columns (middle) */
.sl-mega-menu__links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, max-content));
  gap: 0 32px;
  border-left: 1px solid #e5e5e5;
  padding-left: 32px;
}

.sl-mega-menu__inner--no-featured .sl-mega-menu__links,
.sl-mega-menu__inner--links-only .sl-mega-menu__links {
  border-left: none;
  padding-left: 0;
}

.sl-mega-menu__col {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sl-mega-menu__col li a {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 0;
  font-family: var(--font-body-family);
  font-size: 14px;
  color: #333;
  text-decoration: none;
  cursor: pointer;
  position: relative;
  transition: color 0.2s;
}

/* Underline on hover */
.sl-mega-menu__col li a::after {
  content: '';
  position: absolute;
  bottom: 3px;
  left: 0;
  right: 0;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.sl-mega-menu__col li a:hover::after {
  transform: scaleX(1);
}

/* Arrow on hover */
.sl-mega-menu__col li a::before {
  content: '→';
  position: absolute;
  right: -20px;
  opacity: 0;
  transition: opacity 0.2s, transform 0.2s;
  transform: translateX(-4px);
  font-size: 12px;
}

.sl-mega-menu__col li a:hover::before {
  opacity: 1;
  transform: translateX(0);
}

/* Promo block (right) */
.sl-mega-menu__promo {
  border-left: 1px solid #e5e5e5;
  padding-left: 32px;
}

.sl-mega-menu__promo a {
  display: block;
  text-decoration: none;
  color: #333;
  cursor: pointer;
}

.sl-mega-menu__promo img {
  width: 100%;
  aspect-ratio: 1 / 1;
  display: block;
  object-fit: cover;
  margin-bottom: 12px;
}

.sl-mega-menu__promo-text {
  text-align: center;
}

.sl-mega-menu__promo-text p {
  font-family: var(--font-body-family);
  font-size: 14px;
  font-weight: 500;
  margin: 0 0 6px;
  line-height: 1.4;
}

.sl-mega-menu__promo-text span {
  font-family: var(--font-body-family);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #666;
}

.sl-mega-menu__promo-subtext {
  font-family: var(--font-body-family);
  font-size: 12px;
  color: #666;
  margin-top: 4px;
  line-height: 1.4;
}

.sl-mega-menu__promo-subtext p {
  margin: 0 0 4px;
}

/* Hide SL desktop nav below mobile breakpoint */
@media screen and (max-width: {{section.settings.mobile_screen_width | minus: 1}}px) {
  .sl-main-nav {
    display: none;
  }
}

/* SL: Visually hide header icons — but keep in DOM for cart-drawer.js / search-modal */
.header__icons {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
  pointer-events: none !important;
}
/* Allow JS-triggered children (cart drawer, search modal) to escape and render */
.header__icons details-modal,
.header__icons .search-modal,
.header__icons cart-drawer,
.header__icons cart-notification {
  position: fixed;
  clip: auto;
  overflow: visible;
  width: auto;
  height: auto;
  pointer-events: auto;
}

/* SL: Center mega menu links when no featured image */
.sl-mega-menu__inner--no-featured .sl-mega-menu__links,
.sl-mega-menu__inner--links-only .sl-mega-menu__links {
  margin: auto;
}
</style>

{%- style -%}
