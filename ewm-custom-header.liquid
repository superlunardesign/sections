              src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
              loading="lazy"
              class="header__heading-logo"
              width="{{ section.settings.logo_width }}"
              height="{{ section.settings.logo.height }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
          {%- else -%}
            <span class="h2">{{ shop.name }}</span>
          {%- endif -%}
        </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- endif -%}

     {%- if section.settings.menu != blank -%}
              {%- comment -%} SL Custom Navigation with Mega Menu {%- endcomment -%}
              <nav class="sl-main-nav" role="navigation" aria-label="Main navigation">
                <ul class="sl-nav__list">
                  {%- for link in linklists[section.settings.menu].links -%}
                    {%- assign has_children = false -%}
                    {%- if link.links.size > 0 -%}
                      {%- assign has_children = true -%}
                    {%- endif -%}

                    {%- comment -%} Check if a block is mapped to this item (for manual promo override) {%- endcomment -%}
                    {%- assign mega_block = nil -%}
                    {%- assign has_block_promo = false -%}
                    {%- for block in section.blocks -%}
                      {%- if block.settings.mega_1 == link.title -%}
                        {%- assign mega_block = block -%}
                        {%- if block.settings.image_2 != blank -%}{%- assign has_block_promo = true -%}{%- endif -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%} Check parent collection for promo metafields {%- endcomment -%}
                    {%- assign has_collection_promo = false -%}
                    {%- assign parent_col = nil -%}
                    {%- if link.type == 'collection_link' -%}
                      {%- assign parent_col = link.object -%}
                      {%- if parent_col != blank and parent_col.metafields.custom.menu_promo_image.value != blank -%}
                        {%- assign has_collection_promo = true -%}
                      {%- endif -%}
                    {%- endif -%}

                    {%- comment -%} Promo: collection metafields take priority, block is fallback {%- endcomment -%}
                    {%- assign has_promo = false -%}
                    {%- if has_collection_promo or has_block_promo -%}
                      {%- assign has_promo = true -%}
                    {%- endif -%}

                    {%- comment -%} Determine if mega menu or simple dropdown {%- endcomment -%}
                    {%- assign use_mega = false -%}
                    {%- if section.settings.enable_mega_menu and has_children -%}
                      {%- assign use_mega = true -%}
                    {%- endif -%}

                    <li class="sl-nav__item{% if has_children %} sl-nav__item--has-dropdown{% endif %}{% if use_mega %} sl-nav__item--mega{% endif %}">
                      <a href="{{ link.url }}" class="sl-nav__link">
                        {{ link.title }}
                        {%- if has_children -%}
                          <svg class="sl-nav__caret" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 10L12 14L16 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- endif -%}
                      </a>

                      {%- if has_children -%}
                        {%- if use_mega -%}
                          {%- comment -%} MEGA MENU PANEL — auto for all items with children {%- endcomment -%}
                          {%- comment -%} Pre-collect featured images for each child link {%- endcomment -%}
                          {%- assign any_child_has_image = false -%}
                          {%- for child in link.links -%}
                            {%- assign child_image = nil -%}
                            {%- assign child_product_url = child.url -%}
                            {%- assign child_product_title = child.title -%}
                            {%- assign child_product_price = '' -%}

                            {%- if child.type == 'collection_link' -%}
                              {%- assign child_col_handle = child.url | split: '/collections/' | last | split: '?' | first -%}
                              {%- assign child_col = collections[child_col_handle] -%}
                              {%- if child_col != blank and child_col.products.size > 0 -%}
                                {%- assign child_best = child_col.products.first -%}
                                {%- if child_best != blank and child_best.featured_image != blank -%}
                                  {%- assign child_image = child_best.featured_image -%}
                                  {%- assign child_product_url = child_best.url -%}
                                  {%- assign child_product_title = child_best.title -%}
                                  {%- assign child_product_price = child_best.price | money -%}
                                  {%- assign any_child_has_image = true -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endif -%}

                            {%- if child.type == 'page_link' -%}
                              {%- assign child_page_handle = child.url | split: '/pages/' | last | split: '?' | first -%}
                              {%- assign child_page = pages[child_page_handle] -%}
                              {%- if child_page != blank and child_page.metafields.custom.menu_preview_image != blank -%}
                                {%- assign child_image = child_page.metafields.custom.menu_preview_image.value -%}
                                {%- assign child_product_title = child_page.title -%}
                                {%- assign child_product_url = child.url -%}
                                {%- assign any_child_has_image = true -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}

                          {%- comment -%} Also check if block has a manual override image {%- endcomment -%}
                          {%- if mega_block != nil and mega_block.settings.image_1 != blank -%}
                            {%- assign any_child_has_image = true -%}
                          {%- endif -%}

                          {%- assign has_featured = any_child_has_image -%}

                          <div class="sl-mega-menu"{% if mega_block %} {{ mega_block.shopify_attributes }}{% endif %}>
                            <div class="sl-mega-menu__inner page-width{% unless has_featured %} sl-mega-menu__inner--no-featured{% endunless %}{% unless has_promo %} sl-mega-menu__inner--no-promo{% endunless %}{% unless has_featured or has_promo %} sl-mega-menu__inner--links-only{% endunless %}">

                              {%- if has_featured -%}
                                <div class="sl-mega-menu__featured" data-mega-featured>
                                  {%- assign default_shown = false -%}

                                  {%- comment -%} Block override image renders FIRST as the default {%- endcomment -%}
                                  {%- if mega_block != nil and mega_block.settings.image_1 != blank -%}
                                    <a href="{{ mega_block.settings.link_1 | default: link.url }}" class="sl-mega-featured__slide sl-mega-featured__slide--active" data-mega-slide="default">
                                      <img
                                        src="{{ mega_block.settings.image_1 | image_url: width: 400 }}"
                                        alt="{{ mega_block.settings.title_1 | default: link.title | escape }}"
                                        width="200"
                                        loading="lazy"
                                      >
                                      {%- if mega_block.settings.title_1 != blank -%}
                                        <span class="sl-mega-featured__name">{{ mega_block.settings.title_1 }}</span>
                                      {%- endif -%}
                                    </a>
                                    {%- assign default_shown = true -%}
                                  {%- endif -%}

                                  {%- comment -%} One image per child link — swaps in on hover {%- endcomment -%}
                                  {%- for child in link.links -%}
                                    {%- assign child_image = nil -%}
                                    {%- assign child_product_url = child.url -%}
                                    {%- assign child_product_title = child.title -%}
                                    {%- assign child_product_price = '' -%}

                                    {%- if child.type == 'collection_link' -%}
                                      {%- assign child_col_handle = child.url | split: '/collections/' | last | split: '?' | first -%}
                                      {%- assign child_col = collections[child_col_handle] -%}
                                      {%- if child_col != blank and child_col.products.size > 0 -%}
                                        {%- assign child_best = child_col.products.first -%}
                                        {%- if child_best != blank and child_best.featured_image != blank -%}
                                          {%- assign child_image = child_best.featured_image -%}
                                          {%- assign child_product_url = child_best.url -%}
                                          {%- assign child_product_title = child_best.title -%}
                                          {%- assign child_product_price = child_best.price | money -%}
                                        {%- endif -%}
                                      {%- endif -%}
                                    {%- endif -%}

                                    {%- if child.type == 'page_link' -%}
                                      {%- assign child_page_handle = child.url | split: '/pages/' | last | split: '?' | first -%}
                                      {%- assign child_page = pages[child_page_handle] -%}
                                      {%- if child_page != blank and child_page.metafields.custom.menu_preview_image != blank -%}
                                        {%- assign child_image = child_page.metafields.custom.menu_preview_image.value -%}
                                        {%- assign child_product_title = child_page.title -%}
                                        {%- assign child_product_url = child.url -%}
                                      {%- endif -%}
                                    {%- endif -%}

                                    {%- if child_image != blank -%}
                                      <a href="{{ child_product_url }}" class="sl-mega-featured__slide{% unless default_shown %} sl-mega-featured__slide--active{% endunless %}" data-mega-slide="{{ forloop.index0 }}">
                                        <img
                                          src="{{ child_image | image_url: width: 400 }}"
                                          alt="{{ child_product_title | escape }}"
                                          width="200"
                                          loading="lazy"
                                        >
                                        <span class="sl-mega-featured__name">{{ child_product_title }}</span>
                                        {%- if child_product_price != '' -%}
                                          <span class="sl-mega-featured__price">{{ child_product_price }}</span>
                                        {%- endif -%}
                                      </a>
                                      {%- assign default_shown = true -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                </div>
                              {%- endif -%}

                              <div class="sl-mega-menu__links">
                                {%- assign total_links = link.links.size -%}
                                {%- assign half = total_links | plus: 1 | divided_by: 2 -%}
                                {%- assign split_at = half | plus: 1 -%}
                                <ul class="sl-mega-menu__col">
                                  {%- for child in link.links -%}
                                    {%- if forloop.index == split_at -%}
                                      </ul><ul class="sl-mega-menu__col">
                                    {%- endif -%}
                                    <li><a href="{{ child.url }}" data-mega-link="{{ forloop.index0 }}">{{ child.title }}</a></li>
                                  {%- endfor -%}
                                </ul>
                              </div>

                              {%- if has_promo -%}
                                <div class="sl-mega-menu__promo">
                                  {%- if has_collection_promo -%}
                                    {%- comment -%} Promo from parent collection metafields {%- endcomment -%}
                                    {%- assign promo_link_url = link.url -%}
                                    {%- if parent_col.metafields.custom.menu_promo_link.value != blank -%}
                                      {%- assign promo_link_url = parent_col.metafields.custom.menu_promo_link.value.url -%}
                                    {%- endif -%}
                                    <a href="{{ promo_link_url }}">
                                      {%- assign promo_img = parent_col.metafields.custom.menu_promo_image.value -%}
                                      <img
                                        src="{{ promo_img | image_url: width: 480 }}"
                                        alt="{{ parent_col.metafields.custom.menu_promo_heading.value | default: parent_col.title | escape }}"
                                        width="240"
                                        loading="lazy"
                                      >
                                      {%- if parent_col.metafields.custom.menu_promo_heading.value != blank or parent_col.metafields.custom.menu_promo_subtext.value != blank -%}
                                        <div class="sl-mega-menu__promo-text">
                                          {%- if parent_col.metafields.custom.menu_promo_heading.value != blank -%}
                                            <p>{{ parent_col.metafields.custom.menu_promo_heading.value }}</p>
                                          {%- endif -%}
                                          {%- if parent_col.metafields.custom.menu_promo_subtext.value != blank -%}
                                            <div class="sl-mega-menu__promo-subtext">{{ parent_col.metafields.custom.menu_promo_subtext | metafield_tag }}</div>
                                          {%- endif -%}
                                        </div>
                                      {%- endif -%}
                                    </a>
                                  {%- elsif has_block_promo -%}
                                    {%- comment -%} Fallback: promo from block {%- endcomment -%}
                                    <a href="{{ mega_block.settings.link_2 | default: '#' }}">
                                      <img
                                        src="{{ mega_block.settings.image_2 | image_url: width: 480 }}"
                                        alt="{{ mega_block.settings.title_2 | default: '' | escape }}"
                                        width="240"
                                        loading="lazy"
                                      >
                                      {%- if mega_block.settings.title_2 != blank -%}
                                        <div class="sl-mega-menu__promo-text">
                                          <p>{{ mega_block.settings.title_2 }}</p>
                                          {%- if mega_block.settings.button_2 != blank -%}
                                            <span>{{ mega_block.settings.button_2 }}</span>
                                          {%- endif -%}
                                        </div>
                                      {%- endif -%}
                                    </a>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}

                            </div>
                          </div>
                        {%- else -%}
                          {%- comment -%} SIMPLE DROPDOWN (mega menu toggle is off) {%- endcomment -%}
                          <div class="sl-dropdown">
                            <ul class="sl-dropdown__list">
                              {%- for child in link.links -%}
                                <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
      {%- endif -%}
      {%- if section.settings.logo_position == 'middle' -%}
        {%- if section.settings.show_secondary_menu -%}
               <div class="header__inline-menu secondary-menu">
                   <nav id="AccessibleNav" role="secondary-navigation" class="dt-sc-flex-space-between {{section.settings.menu_type_desktop}} align-{{ section.settings.menu_alignment }}" data-menu="dt-main-menu">
                    {{ secondaryMenu }}
                   </nav>
                </div>     
        {%- endif -%} 
      {%- endif -%}  
      {%- if section.settings.logo_position == 'top-center' or  section.settings.logo_position == 'top-left' -%}
